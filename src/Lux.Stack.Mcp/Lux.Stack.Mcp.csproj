<Project Sdk="Microsoft.NET.Sdk">

  <!-- Same version as the library: both import build/Version.props. -->
  <Import Project="..\..\build\Version.props" />

  <!-- The local MCP server of Lux.UI, as a dotnet tool: dotnet tool install -g Lux.Stack.Mcp, then lux-ui-mcp.
       It speaks MCP over stdio and carries the docs bundle of the Lux.UI version it was built with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lux.Stack.Mcp.Tool</RootNamespace>
    <AssemblyName>Lux.Stack.Mcp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lux-stack-mcp</ToolCommandName>
    <PackageId>Lux.Stack.Mcp</PackageId>
    <Description>MCP server for LuxStack (Lux.UI + all 7 Lux.* libraries): component search, API, examples and guides for AI coding agents, over stdio.</Description>
    <PackageTags>blazor;ui;mcp;model-context-protocol;ai;tailwind</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>lux-ui contributors</Authors>
    <Copyright>Copyright (c) 2026 lux-ui contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- A tool needs the runtime it was built for; a newer major one is fine. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lux.Stack.Mcp.Core\Lux.Stack.Mcp.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
