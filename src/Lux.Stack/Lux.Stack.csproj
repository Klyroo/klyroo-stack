<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lux.Stack</RootNamespace>
    <PackageId>Lux.Stack</PackageId>
    <Description>Umbrella meta-package for the entire LuxStack ecosystem (UI, Query, Table, Form, Dashboard, Display, Spreadsheet, Agent) for Blazor Web and .NET MAUI Hybrid.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lux.Stack.Core\Lux.Stack.Core.csproj" />
    <ProjectReference Include="..\..\..\blux-ui\src\Blux.UI\Blux.UI.csproj" />
    <ProjectReference Include="..\..\..\lux-query\src\Lux.Query\Lux.Query.csproj" />
    <ProjectReference Include="..\..\..\lux-table\src\Lux.Table\Lux.Table.csproj" />
    <ProjectReference Include="..\..\..\lux-form\src\Lux.Form\Lux.Form.csproj" />
    <ProjectReference Include="..\..\..\lux-dashboard\src\Lux.Dashboard\Lux.Dashboard.csproj" />
    <ProjectReference Include="..\..\..\lux-display\src\Lux.Display\Lux.Display.csproj" />
    <ProjectReference Include="..\..\..\lux-spreadsheet\src\Lux.Spreadsheet\Lux.Spreadsheet.csproj" />
    <ProjectReference Include="..\..\..\lux-agent\src\Lux.Agent\Lux.Agent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <SupportedPlatform Include="ios" />
    <SupportedPlatform Include="android" />
    <SupportedPlatform Include="maccatalyst" />
    <SupportedPlatform Include="windows" />
  </ItemGroup>
</Project>
