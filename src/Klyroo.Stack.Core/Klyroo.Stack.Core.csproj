    <ProjectReference Include="..\..\..\klyroo-form\src\Klyroo.Form.Core\Klyroo.Form.Core.csproj" />
    <ProjectReference Include="..\..\..\klyroo-dashboard\src\Klyroo.Dashboard.Core\Klyroo.Dashboard.Core.csproj" />
    <ProjectReference Include="..\..\..\klyroo-display\src\Klyroo.Display.Core\Klyroo.Display.Core.csproj" />
    <ProjectReference Include="..\..\..\klyroo-spreadsheet\src\Klyroo.Spreadsheet.Core\Klyroo.Spreadsheet.Core.csproj" />
    <ProjectReference Include="..\..\..\klyroo-agent\src\Klyroo.Agent.Core\Klyroo.Agent.Core.csproj" />
  </ItemGroup>
</Project>
