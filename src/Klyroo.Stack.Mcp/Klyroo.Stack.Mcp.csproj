<Project Sdk="Microsoft.NET.Sdk">

  <!-- Same version as the library: both import build/Version.props. -->
  <Import Project="..\..\build\Version.props" />

  <!-- The local MCP server of the Klyroo documentation, as a dotnet tool: dotnet tool install -g Klyroo.Stack.Mcp, then
       klyroo-stack-mcp. It speaks MCP over stdio and carries the docs bundle of the Klyroo.UI and Klyroo.Table versions it was built with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Stack.Mcp.Tool</RootNamespace>
    <AssemblyName>Klyroo.Stack.Mcp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>klyroo-stack-mcp</ToolCommandName>
    <PackageId>Klyroo.Stack.Mcp</PackageId>
    <Description>MCP server for the Klyroo documentation: search the Klyroo.UI and Klyroo.Table components, their API, examples and guides from an AI coding agent, over stdio.</Description>
    <PackageTags>blazor;ui;mcp;model-context-protocol;ai;tailwind</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Klyroo Contributors</Authors>
    <Copyright>Copyright (c) 2026 Klyroo Contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- A tool needs the runtime it was built for; a newer major one is fine. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klyroo.Stack.Mcp.Core\Klyroo.Stack.Mcp.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
