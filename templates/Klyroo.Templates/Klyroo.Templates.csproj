<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Klyroo.Templates</PackageId>
    <Title>Klyroo Project Templates</Title>
    <Description>dotnet new templates for Klyroo: klyroo-saas (Blazor Web App), klyroo-admin (back office), klyroo-headless (NativeAOT console) and klyroo-maui (.NET MAUI Blazor Hybrid).</Description>
    <PackageTags>dotnet-new;templates;blazor;maui;klyroo;nativeaot</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**" Pack="true" PackagePath="content" />
  </ItemGroup>

</Project>
