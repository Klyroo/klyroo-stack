@page "/customers/{Id:int}"
@inject CustomerStore Store
@inject FormService Forms
@inject IToastService Toasts

<PageTitle>@(_customer?.Name ?? "Customer") - @AppInfo.Name</PageTitle>

<AppPage Title="@(_customer?.Name ?? "Customer not found")">
    <Actions>
        <KlyButton Label="All customers" Href="customers" Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" />
        @if (_customer is not null)
        {
            <KlyButton Label="Edit" Variant="ButtonVariant.Outline" OnClick="EditAsync">
                <LeadingIcon>@KlyIcons.Named("pencil")</LeadingIcon>
            </KlyButton>
        }
    </Actions>
    <ChildContent>
        @if (_customer is null)
        {
            <KlyEmpty Title="This customer does not exist" Description="It may have been deleted. Go back to the list to pick another one."
                      ActionItems="_backActions">
                <Icon>@KlyIcons.Named("search-x")</Icon>
            </KlyEmpty>
        }
        else
        {
            @* Each read-only block of Klyroo.UI is a typed component: KlyUser, KlyFacts, KlyMeter, KlyTimeline and KlyAlert take records and plain values. *@
            <div class="two-columns">
                <div class="stack">
                    <KlyUser Name="@_customer.Contact" Description="@($"{_customer.Region}, customer since {_customer.Since:MMMM yyyy}")"
                             Badge="new KlyBadgeItem(_customer.Tier) { Color = KlyColor.Primary }" />
                    <KlyFacts Groups="@(new[] { new KlyFactGroup("Contract", _facts) })" Surface="KlySurface.Muted" />
                    <KlyMeter Title="Health score" Value="_customer.Health" Max="100" ValueText="@($"{_customer.Health} of 100")"
                              Description="@HealthText" Surface="KlySurface.Muted" />
                </div>
                <div class="stack">
                    <KlyHeading Title="History" HeadingLevel="2" Surface="KlySurface.Plain" />
                    <KlyTimeline Items="_history" />
                    <KlyAlert Color="@(_customer.Health < 50 ? KlyColor.Warning : KlyColor.Success)" Variant="KlyVariant.Soft" StatusIcon="true"
                              Title="@(_customer.Health < 50 ? "At risk" : "In good standing")" Description="@HealthText" />
                </div>
            </div>
        }
    </ChildContent>
</AppPage>

@code {
    [Parameter] public int Id { get; set; }

    private Customer? _customer;
    private IReadOnlyList<KlyFact> _facts = [];
    private IReadOnlyList<KlyTimelineItem> _history = [];
    private IReadOnlyList<KlyActionItem> _backActions = [new KlyActionItem("All customers") { Href = "customers", Variant = ButtonVariant.Solid, Color = KlyColor.Primary }];

    private string HealthText => _customer is { Health: < 50 } ? "Usage dropped for two months: call the owner of the account." : "Usage is steady: nothing to do.";

    protected override void OnParametersSet() => Load();

    private void Load()
    {
        _customer = Store.Find(Id);
        if (_customer is null) return;

        _facts =
        [
            new("Tier") { Badge = new KlyBadgeItem(_customer.Tier) { Color = KlyColor.Primary } },
            new("Annual revenue") { Value = Money.Format(_customer.Arr), Emphasis = true },
            new("Region") { Value = _customer.Region },
            new("Contact") { Value = _customer.Contact, Copy = true },
            new("Customer id") { Value = $"cus_{_customer.Id:D5}", Mono = true, Copy = true },
        ];

        var start = _customer.Since.ToDateTime(new TimeOnly(9, 0));
        var signed = new DateTimeOffset(start, TimeSpan.Zero);
        var onboarding = new DateTimeOffset(start.AddDays(6), TimeSpan.Zero);
        var renewal = new DateTimeOffset(start.AddYears(1), TimeSpan.Zero);
        _history =
        [
            new("Contract signed") { Description = $"{_customer.Tier} tier, {Money.Format(_customer.Arr)} a year", At = signed, Date = signed.ToString("MMM d, yyyy"), State = KlyTimelineState.Done },
            new("Onboarding call") { Description = "Two people from the customer joined", At = onboarding, Date = onboarding.ToString("MMM d, yyyy"), State = KlyTimelineState.Done },
            new("Renewal") { Description = "In twelve months", At = renewal, Date = renewal.ToString("MMM d, yyyy"), State = KlyTimelineState.Upcoming },
        ];
    }

    private async Task EditAsync()
    {
        if (_customer is null) return;
        var outcome = await Forms.CreateFormAsync(CustomerForms.Schema($"Edit {_customer.Name}", editing: true), CustomerForms.Of(_customer), FormShellMode.Drawer);
        if (!outcome.IsCompleted) return;

        var edited = outcome.Model!;
        Store.Update(_customer with { Name = edited.Name, Contact = edited.Contact, Region = edited.Region, Tier = edited.Tier, Arr = edited.Arr });
        Load();
        await Toasts.Add(new KlyToast { Title = "Customer saved", Description = edited.Name, Color = KlyColor.Success });
    }
}
