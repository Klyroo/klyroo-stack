@page "/error"

<PageTitle>Error - @AppInfo.Name</PageTitle>

<div class="error-page">
    <h1 class="page-title">Something went wrong</h1>
    <p>The request could not be completed. Try again, and if the problem stays, check the logs of the server.</p>
    <p>
        The Development environment shows the details of an exception. Do not enable it for a deployed app: it can show sensitive information to its users.
    </p>
    <KlyButton Label="Back to the overview" Href="./" />
</div>
