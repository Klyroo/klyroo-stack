@page "/"
@inject FormService Forms
@inject FilePreviewService Preview

<LxDashboardPage Dashboard="_dash" Title="LuxAdminApp Operations">
    <LxDashboardGrid>
        <LxDashboardStat Label="Customers" Value="_customers.Count" Compare="2" />
        <LxDashboardStat Label="Total ARR" Value="(double)_customers.Sum(c => c.Arr)" Compare="250000" Format="DashboardFormatPreset.Compact" />
    </LxDashboardGrid>

    <div class="mt-6 flex items-center gap-3">
        <LxButton Label="New Customer" Color="LxColor.Primary" OnClick="CreateCustomerAsync" />
        <LxButton Label="Preview CSV Export" Variant="ButtonVariant.Outline" OnClick="OpenCsvPreview" />
    </div>

    <div class="mt-4">
        <LxDataList Schema="Schema" Items="_customers" UrlSync="false">
            <LxDataListTable TItem="Customer">
                <LxDataListColumn TItem="Customer" Field="name" Title="Customer" />
                <LxDataListColumn TItem="Customer" Field="region" Title="Region" />
                <LxDataListColumn TItem="Customer" Field="arr" Title="ARR (€)" Summary="DataListSummaryKind.Sum" />
            </LxDataListTable>
        </LxDataList>
    </div>
</LxDashboardPage>

@code {
    private sealed record Customer(int Id, string Name, string Region, decimal Arr);

    private static readonly DataListSchema<Customer> Schema = DataListSchema.For<Customer>(s => s
        .RowKey(c => c.Id).RowLabel(c => c.Name)
        .Field(c => c.Name, f => f.Key("name").Sortable())
        .Field(c => c.Region, f => f.Key("region").Sortable())
        .Field(c => c.Arr, f => f.Key("arr").Sortable())
        .DefaultSort(c => c.Name));

    private readonly DashboardController _dash = new("admin");
    private readonly List<Customer> _customers =
    [
        new(1, "Acme Corp", "EU", 145_000m),
        new(2, "Nordic Retail", "EU", 92_000m),
        new(3, "Pacific Labs", "APAC", 118_000m)
    ];

    private async Task CreateCustomerAsync()
    {
        var outcome = await Forms.CreateFormAsync(new FormSchema
        {
            FormKey = "new-customer", Title = "New Customer",
            Fields = [
                new FormFieldSchema { Key = "name", Label = "Company", Required = true },
                new FormFieldSchema { Key = "region", Label = "Region", DefaultValue = "EU" },
                new FormFieldSchema { Key = "arr", Label = "ARR (€)", Kind = FormFieldKind.Number, DefaultValue = 50_000.0 }
            ]
        }, mode: FormShellMode.Drawer);
        if (outcome.IsCompleted)
        {
            _customers.Add(new Customer(_customers.Count + 1,
                outcome.FormData["name"]?.ToString() ?? "Customer",
                outcome.FormData["region"]?.ToString() ?? "EU",
                Convert.ToDecimal(outcome.FormData["arr"] ?? 50_000m)));
        }
    }

    private void OpenCsvPreview() => Preview.Open(new FilePreviewFile
    {
        Src = "customers.csv", Name = "customers.csv", Mime = "text/csv",
        Content = "Name,Region,ARR\n" + string.Join("\n", _customers.Select(c => $"{c.Name},{c.Region},{c.Arr}"))
    });
}
