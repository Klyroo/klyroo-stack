@namespace Lux.Stack.Site.Client.Components.Stages
@using Lux.Display
@inject FilePreviewService FilePreview

@* Precision Dossier & Secret Vault Stage: interactive threshold meter slider, masked API key reveal, live before/after diff, constrained audio player, and 1-click CSV Lightbox. *@
<div class="overflow-hidden rounded-2xl border border-(--lux-border) bg-(--lux-bg)">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-(--lux-border) bg-(--lux-bg-muted)/50 px-5 py-3">
        <div class="flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Display stage views">
            @foreach (var tab in Tabs)
            {
                var active = _tab == tab.Key;
                <button type="button"
                        role="tab"
                        aria-selected="@active"
                        class="@($"inline-flex min-h-7 items-center rounded-md border px-2.5 py-1 font-mono text-xs transition-colors {(active ? "font-semibold" : "border-(--lux-border) bg-(--lux-bg) text-(--lux-text-muted) hover:text-(--lux-text-highlighted)")}")"
                        style="@(active ? "background:var(--lib-pill-bg);border-color:var(--lib-pill-bg);color:#ffffff" : null)"
                        @onclick="@(() => _tab = tab.Key)">
                    @tab.Label
                </button>
            }
        </div>
        <button type="button"
                class="inline-flex min-h-7 items-center gap-1.5 rounded-md border border-(--lux-border) bg-(--lux-bg) px-3 py-1 font-mono text-xs text-(--lux-text-highlighted) hover:border-(--lux-border-accented)"
                @onclick="OpenLightbox">
            <span class="size-1.5 rounded-full lib-pulse-dot" style="background:var(--lib-accent)"></span>
            Open CSV Lightbox
        </button>
    </div>

    <div class="p-6">
        @if (_tab == "vault")
        {
            <div class="grid gap-6 lg:grid-cols-2">
                <div class="flex flex-col gap-4">
                    <LxDisplay Kind="DisplayKind.Code"
                               Surface="DisplaySurface.Bordered"
                               Variant="secret"
                               Title="Production Webhook Secret"
                               Value="sk_live_luxstack_9981_vault"
                               VisibleChars="4"
                               Copy="true" />
                    <LxDisplay Kind="DisplayKind.Facts"
                               Surface="DisplaySurface.Bordered"
                               Title="Deployment Fingerprint"
                               Facts="@([
                                   new DisplayFact { Label = "Release", Value = "v0.1.0-preview.1", Mono = true, Copy = true },
                                   new DisplayFact { Label = "Runtime", Value = ".NET 10 NativeAOT", Chip = new DisplayChip("Verified", LxColor.Success) },
                                   new DisplayFact { Label = "Region", Value = "eu-west-3 (Paris)" }
                               ])" />
                </div>

                <div class="flex flex-col gap-4">
                    <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/30 p-4">
                        <div class="mb-3 flex items-center justify-between gap-2">
                            <label for="display-quota-slider" class="font-mono text-xs font-medium text-(--lux-text-highlighted)">
                                Interactive Quota Threshold Simulator
                            </label>
                            <span class="font-mono text-xs font-semibold tabular-nums" style="color:var(--lib-accent)">@_quota%</span>
                        </div>
                        <input id="display-quota-slider"
                               type="range"
                               min="15"
                               max="98"
                               value="@_quota"
                               class="w-full cursor-pointer accent-(--lux-primary)"
                               @oninput="@(e => { if (int.TryParse(e.Value?.ToString(), out var v)) _quota = v; })" />
                        <div class="mt-3">
                            <LxDisplay Kind="DisplayKind.Meter"
                                       Title="Storage Quota (Warn 75% · Crit 90%)"
                                       MeterValue="@_quota"
                                       MeterMax="100"
                                       WarningThreshold="75"
                                       ErrorThreshold="90" />
                        </div>
                    </div>

                    <LxDisplay Kind="DisplayKind.Stat"
                               Surface="DisplaySurface.Bordered"
                               Title="Monthly Recurring Revenue"
                               Value="€148,900"
                               Delta="+14.2%"
                               Trend="@([98.0, 112.0, 129.0, 148.9])" />
                </div>
            </div>
        }
        else if (_tab == "audit")
        {
            <div class="grid gap-6 lg:grid-cols-2">
                <LxDisplay Kind="DisplayKind.Diff"
                           Surface="DisplaySurface.Bordered"
                           Title="Plan Migration Diff"
                           Before="Plan: Starter (5 seats, €290/mo)"
                           After="Plan: Enterprise (25 seats, €1,480/mo)" />
                <LxDisplay Kind="DisplayKind.Timeline"
                           Surface="DisplaySurface.Bordered"
                           Title="Verification Audit Trail"
                           TimelineItems="@([
                               new DisplayTimelineItem("Schema Validated", Time: "14:02:11", State: DisplayTimelineState.Done),
                               new DisplayTimelineItem("Secrets Redacted", Time: "14:02:14", State: DisplayTimelineState.Done),
                               new DisplayTimelineItem("Production Cutover", Time: "Live", State: DisplayTimelineState.Current)
                           ])" />
            </div>
        }
        else
        {
            <div class="grid gap-6 lg:grid-cols-2">
                <LxAudioPlayer Src="/media/sample.mp3"
                               Title="Certification Audio Clip (10s–40s · MaxPlays=2 · Seek Locked)"
                               Start="10" End="40" MaxPlays="2" Seekable="false" />
                <LxDisplay Kind="DisplayKind.Alert"
                           Surface="DisplaySurface.Bordered"
                           Title="Constrained Assessment Playback"
                           Description="Start/End clip slicing, MaxPlays play quotas, subtitle tracks, and Seekable=false locking are enforced deterministically in Lux.Display." />
            </div>
        }
    </div>
</div>

@code {
    private static readonly (string Key, string Label)[] Tabs =
    [
        ("vault", "Secrets & Threshold Meter"),
        ("audit", "Diff & Audit Timeline"),
        ("media", "Constrained Media"),
    ];

    private string _tab = "vault";
    private int _quota = 82;

    private void OpenLightbox()
    {
        FilePreview.Open(new FilePreviewFile
        {
            Src = "lux-display-sample.csv",
            Name = "lux-display-sample.csv",
            Mime = "text/csv",
            Content = "Library,Core Assembly,Size KB,NativeAOT\nLux.Display,Lux.Display.Core,58,true\nLux.Query,Lux.Query.Core,68,true\nLux.Agent,Lux.Agent.Core,42,true"
        });
    }
}
