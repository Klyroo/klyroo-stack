@namespace Lux.Stack.Site.Client.Components.Stages
@using Lux.Agent
@using Lux.Form

@* Vigie-inspired Semantic Radar & Human-in-the-Loop Stage: animated radar sweep over live AgentBridgeService controls, guaranteed [redacted] privacy shield, AllowPolicy gate, and UndoStack rollback. *@
<div class="overflow-hidden rounded-2xl border border-(--lux-border) bg-(--lux-bg)">
    <div class="grid divide-y divide-(--lux-border) xl:grid-cols-[minmax(0,1.05fr)_minmax(0,1.15fr)] xl:divide-x xl:divide-y-0">
        @* Left: Animated Semantic Radar & Live Agent Actions *@
        <div class="relative isolate flex flex-col justify-between overflow-hidden bg-(--pg-code-bg) p-6 text-[#e5e7eb]">
            @* Subtle concentric radar rings + sweep *@
            <svg class="pointer-events-none absolute -end-16 -top-16 size-72 opacity-40" viewBox="0 0 240 240" fill="none" aria-hidden="true">
                <circle cx="120" cy="120" r="36" stroke="var(--lib-accent)" stroke-opacity="0.35" stroke-dasharray="3 4" />
                <circle cx="120" cy="120" r="72" stroke="var(--lib-accent)" stroke-opacity="0.25" stroke-dasharray="3 4" />
                <circle cx="120" cy="120" r="108" stroke="var(--lib-accent)" stroke-opacity="0.18" />
                <g class="lib-radar-sweep">
                    <path d="M120 120 L120 12 A108 108 0 0 1 214 66 Z" fill="var(--lib-accent)" fill-opacity="0.18" />
                    <line x1="120" y1="120" x2="120" y2="12" stroke="var(--lib-accent)" stroke-width="1.5" />
                </g>
            </svg>

            <div class="relative z-10">
                <div class="flex items-center justify-between gap-2">
                    <span class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-white">
                        <span class="size-2 rounded-full lib-pulse-dot" style="background:var(--lib-accent)"></span>
                        AgentBridgeService · Live Radar
                    </span>
                    <span class="rounded-md border border-white/15 bg-white/5 px-2 py-0.5 font-mono text-[11px] text-[#c7d2fe]">
                        @_bridge.Snapshot().Count controls bound
                    </span>
                </div>

                <p class="mt-3 max-w-md text-xs leading-relaxed text-[#9ca3af]">
                    Trigger semantic actions below. Secrets stay masked as <code class="font-mono text-[#6ee7b7]">[redacted]</code>, consequential submits pause at <code class="font-mono text-white">AllowPolicy</code>, and every state is reversible.
                </p>

                <div class="mt-5 flex flex-wrap gap-2">
                    <button type="button"
                            class="inline-flex min-h-8 items-center rounded-lg bg-indigo-600 px-3 py-1.5 font-mono text-xs font-semibold text-white transition-colors hover:bg-indigo-500"
                            @onclick="AgentMutateAsync">
                        Act: Mutate Project
                    </button>
                    <button type="button"
                            class="inline-flex min-h-8 items-center rounded-lg border border-amber-400/40 bg-amber-400/10 px-3 py-1.5 font-mono text-xs font-medium text-amber-200 hover:bg-amber-400/20"
                            @onclick="AgentRequestSubmitAsync">
                        Act: Submit (AllowPolicy)
                    </button>
                    <button type="button"
                            class="inline-flex min-h-8 items-center rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 font-mono text-xs text-[#e5e7eb] hover:bg-white/10 disabled:opacity-40"
                            disabled="@(!_undo.CanUndo)"
                            @onclick="UndoState">
                        Undo
                    </button>
                    <button type="button"
                            class="inline-flex min-h-8 items-center rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 font-mono text-xs text-[#e5e7eb] hover:bg-white/10 disabled:opacity-40"
                            disabled="@(!_undo.CanRedo)"
                            @onclick="RedoState">
                        Redo
                    </button>
                </div>

                @* Inline Human-in-the-Loop AllowPolicy Gate *@
                @if (_awaitingApproval)
                {
                    <div class="lib-flash mt-5 rounded-xl border border-amber-400/50 bg-amber-500/10 p-4">
                        <div class="flex items-center justify-between gap-2 font-mono text-xs font-semibold text-amber-200">
                            <span>AllowPolicy Gate Paused</span>
                            <span>confirmSubmit: true</span>
                        </div>
                        <p class="mt-1.5 text-xs text-[#e5e7eb]">
                            Agent requested <code class="font-mono text-white">submit</code> on <strong class="text-white">@_form.GetValue("project")</strong>. Approve execution?
                        </p>
                        <div class="mt-3 flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex min-h-7 items-center rounded-md bg-emerald-500 px-3 py-1 font-mono text-xs font-semibold text-[#052e16] hover:bg-emerald-400"
                                    @onclick="@(() => ResolveGate(true))">
                                Approve &amp; Execute
                            </button>
                            <button type="button"
                                    class="inline-flex min-h-7 items-center rounded-md border border-white/20 bg-white/5 px-3 py-1 font-mono text-xs text-white hover:bg-white/10"
                                    @onclick="@(() => ResolveGate(false))">
                                Refuse
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="relative z-10 mt-6 border-t border-white/10 pt-3 font-mono text-[11px] text-[#9ca3af]">
                <span>UndoStack.Current: <strong class="text-white">@_undo.Current</strong></span>
                <span class="ms-3">Last event: <strong style="color:var(--lib-accent-bright)">@_lastEvent</strong></span>
            </div>
        </div>

        @* Right: Live Semantic Snapshot Table *@
        <div class="flex min-w-0 flex-col justify-between p-5">
            <div>
                <div class="flex items-center justify-between gap-2 font-mono text-[11px]">
                    <span class="font-semibold uppercase tracking-wider text-(--lux-text-highlighted)">Live Semantic Snapshot</span>
                    <span class="rounded-md bg-emerald-500/15 px-2 py-0.5 font-semibold text-(--lux-success-text)">Privacy Shield Active</span>
                </div>

                <ul class="mt-4 divide-y divide-(--lux-border) font-mono text-xs">
                    @foreach (var snap in _bridge.Snapshot())
                    {
                        var val = snap.Value?.ToString() ?? "null";
                        var redacted = val == "[redacted]";
                        <li @key="@($"{snap.Ref}-{val}")" class="lib-flash flex items-center justify-between gap-3 py-2.5">
                            <div class="min-w-0">
                                <span class="font-semibold" style="color:var(--lib-accent)">@snap.Ref</span>
                                <span class="ms-2 text-(--lux-text-highlighted)">@snap.Label</span>
                                <span class="ms-1.5 text-[11px] text-(--lux-text-muted)">(@snap.Component)</span>
                            </div>
                            <span class="@($"shrink-0 rounded-md px-2 py-0.5 font-semibold {(redacted ? "bg-emerald-500/15 text-(--lux-success-text)" : "bg-(--lux-bg-muted) text-(--lux-text-highlighted)")}")">
                                @val
                            </span>
                        </li>
                    }
                </ul>
            </div>

            <div class="mt-4 rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 px-3.5 py-2.5 font-mono text-[11.5px] text-(--lux-text-muted)">
                Zero CSS selectors. Agents invoke typed <code class="text-(--lux-text-highlighted)">setValue</code>, <code class="text-(--lux-text-highlighted)">toggle</code>, and <code class="text-(--lux-text-highlighted)">submit</code> actions directly on C# controllers.
            </div>
        </div>
    </div>
</div>

@code {
    private readonly AgentBridgeService _bridge = new();
    private readonly FormController _form;
    private readonly UndoStack<string> _undo = new("Apollo");
    private int _step;
    private string _lastEvent = "Ready";
    private bool _awaitingApproval;
    private TaskCompletionSource<bool>? _gateTcs;

    private static readonly string[] ProjectCycle = ["Atlas", "Orion", "Vega", "Helios"];

    public AgentHeroStage()
    {
        _form = new FormController(new FormSchema
        {
            FormKey = "deploy-agent-stage",
            Title = "Deploy Control",
            Fields =
            [
                new FormFieldSchema { Key = "project", Label = "Project", DefaultValue = "Apollo" },
                new FormFieldSchema { Key = "env", Label = "Environment", Kind = FormFieldKind.Select, DefaultValue = "staging", Options = [new("staging", "Staging"), new("prod", "Production")] },
                new FormFieldSchema { Key = "token", Label = "API Token", Kind = FormFieldKind.Password, DefaultValue = "sk_live_never_leaked_99" }
            ]
        });

        _bridge.RegisterForm(_form, confirmSubmit: true);
        _bridge.AllowPolicy = async (step, confirmRequired) =>
        {
            if (!confirmRequired) return true;
            _awaitingApproval = true;
            _lastEvent = $"Paused on {step.Action}";
            _gateTcs = new TaskCompletionSource<bool>();
            await InvokeAsync(StateHasChanged);
            return await _gateTcs.Task;
        };
    }

    private async Task AgentMutateAsync()
    {
        var next = ProjectCycle[_step++ % ProjectCycle.Length];
        await _bridge.ActAsync([new AgentActStep("Project", "setValue", [next])]);
        _undo.Record(next);
        _lastEvent = $"Act(Project = {next})";
    }

    private async Task AgentRequestSubmitAsync()
    {
        var res = await _bridge.ActAsync([new AgentActStep("Deploy Control", "submit")]);
        _lastEvent = res.Ok ? "AllowPolicy approved → Submitted" : "AllowPolicy refused";
    }

    private void ResolveGate(bool allow)
    {
        _awaitingApproval = false;
        _gateTcs?.TrySetResult(allow);
    }

    private void UndoState()
    {
        var prev = _undo.Undo();
        _form.SetValue("project", prev);
        _lastEvent = $"Undo → {prev}";
    }

    private void RedoState()
    {
        var next = _undo.Redo();
        _form.SetValue("project", next);
        _lastEvent = $"Redo → {next}";
    }
}
