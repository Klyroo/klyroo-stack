@implements IDisposable
@using Lux.Stack.Site.Client.Docs
@inject NavigationManager Navigation

<div class="border-b border-(--lux-border) bg-(--lux-bg-muted)/75 backdrop-blur">
    <div class="mx-auto flex max-w-(--breakpoint-2xl) items-center gap-2 px-4 py-2 sm:px-6 lg:px-8">
        <nav aria-label="LuxStack Libraries" class="flex min-w-0 items-center gap-1.5 overflow-x-auto py-0.5">
            <a href="/"
               aria-current="@(_isHub ? "page" : null)"
               class="inline-flex shrink-0 items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs transition-colors @(_isHub ? "border-(--lux-primary-text) bg-(--lux-bg) font-semibold text-(--lux-text-highlighted)" : "border-(--lux-border) bg-(--lux-bg) text-(--lux-text-muted) hover:border-(--lux-border-accented) hover:text-(--lux-text-highlighted)")">
                <span class="size-2 rounded-full bg-(--lux-primary)" aria-hidden="true"></span>
                <span>LuxStack</span>
            </a>
            <span class="px-0.5 text-(--lux-border-accented)" aria-hidden="true">/</span>
            @foreach (var p in LuxStackProducts.All)
            {
                var isActive = string.Equals(_activeSlug, p.Slug, StringComparison.OrdinalIgnoreCase);
                <a href="@($"/{p.Slug}")"
                   aria-current="@(isActive ? "page" : null)"
                   class="inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-xs transition-colors @(isActive ? "bg-(--lux-bg) font-semibold text-(--lux-text-highlighted)" : "border-(--lux-border) bg-(--lux-bg) text-(--lux-text-muted) hover:border-(--lux-border-accented) hover:text-(--lux-text-highlighted)")"
                   style="@(isActive ? $"border-color:{p.AccentHex}" : "")">
                    <span class="size-2 rounded-full" style="@($"background:{p.AccentHex}")" aria-hidden="true"></span>
                    <span>@p.ShortName</span>
                </a>
            }
        </nav>
    </div>
</div>

@code {
    private string? _activeSlug;
    private bool _isHub;

    protected override void OnInitialized()
    {
        UpdateFromUri();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateFromUri();
        StateHasChanged();
    }

    private void UpdateFromUri()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        _isHub = path is "/" or "/stack";
        _activeSlug = LuxStackProducts.ResolveFromPath(path)?.Slug;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
