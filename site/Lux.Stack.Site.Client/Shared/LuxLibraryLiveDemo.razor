@using System.Globalization
@using System.Text.Json
@using Lux.Query

<div class="my-6 overflow-hidden rounded-2xl border border-(--lux-border) bg-(--lux-bg)">
    <div class="flex items-center justify-between gap-2 border-b border-(--lux-border) bg-(--lux-bg-muted)/60 px-4 py-2 font-mono text-xs text-(--lux-text-muted)">
        <span class="flex items-center gap-2 text-(--lux-text-highlighted)">
            <span class="size-2 rounded-full bg-(--lux-primary)" aria-hidden="true"></span>
            LIVE EXAMPLE · @Title
        </span>
        <span>Interactive</span>
    </div>
    <div class="p-5">
        @switch (DemoKey)
        {
            case "query-inmemory":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-3">
                        <div class="w-60">
                            <LxInput Value="@_qSearch" ValueChanged="@OnQuerySearch" Placeholder="Search products (e.g. M)..." aria-label="Search products" />
                        </div>
                        <LxButton Label="@(_qDesc ? "Sort: Price DESC" : "Sort: Price ASC")" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ToggleQuerySort" />
                        <LxButton Label="@(_qActiveOnly ? "Active only: ON" : "Active only: OFF")" Size="LxSize.Sm" Color="@(_qActiveOnly ? LxColor.Success : LxColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@ToggleQueryActive" />
                    </div>
                    <p class="font-mono text-xs text-(--lux-text-muted)">
                        Matched <strong class="text-(--lux-text-highlighted)">@_qResult.TotalCount</strong> items via <code>DataListSchema.ExecuteInMemory</code>
                    </p>
                    <div class="grid gap-2 sm:grid-cols-3">
                        @foreach (var item in _qResult.Items)
                        {
                            <div class="flex items-center justify-between rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 px-3 py-2.5 font-mono text-xs">
                                <span>@item.Name</span>
                                <span class="font-semibold text-(--lux-text-highlighted)">€@item.Price</span>
                            </div>
                        }
                    </div>
                </div>
                break;

            case "query-filters":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="font-mono text-xs text-(--lux-text-muted)">Min €:</span>
                        <div class="w-24"><LxInput Value="@_qMin.ToString(CultureInfo.InvariantCulture)" ValueChanged="@OnMinPriceChanged" aria-label="Min price" /></div>
                        <span class="font-mono text-xs text-(--lux-text-muted)">Max €:</span>
                        <div class="w-24"><LxInput Value="@_qMax.ToString(CultureInfo.InvariantCulture)" ValueChanged="@OnMaxPriceChanged" aria-label="Max price" /></div>
                        @foreach (var cat in new[] { "Displays", "Input", "Audio" })
                        {
                            var selected = _qCats.Contains(cat);
                            <LxButton Label="@cat" Size="LxSize.Sm" Color="@(selected ? LxColor.Primary : LxColor.Neutral)" Variant="@(selected ? ButtonVariant.Solid : ButtonVariant.Outline)" OnClick="@(() => ToggleCategory(cat))" />
                        }
                    </div>
                    <div class="grid gap-3 lg:grid-cols-2">
                        <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3">
                            <p class="font-mono text-xs uppercase text-(--lux-text-muted)">Filtered Results (@_qFilterResult.TotalCount)</p>
                            <ul class="mt-2 space-y-1 font-mono text-xs">
                                @foreach (var item in _qFilterResult.Items)
                                {
                                    <li class="flex justify-between"><span>@item.Name (@item.Category)</span><strong>€@item.Price</strong></li>
                                }
                            </ul>
                        </div>
                        <div class="rounded-xl border border-(--lux-border) bg-(--pg-code-bg) p-3 font-mono text-[11px] text-[#d7dcde]">
                            <p class="mb-1 text-[#94a3b8]">DataListJsonContext (NativeAOT JSON AST)</p>
                            <pre class="overflow-x-auto whitespace-pre-wrap">@_qFilterJson</pre>
                        </div>
                    </div>
                </div>
                break;

            case "query-paging":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <LxButton Label="Previous" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" Disabled="@(_qPage <= 1)" OnClick="@(() => SetPage(_qPage - 1))" />
                        <span class="px-2 font-mono text-xs text-(--lux-text-highlighted)">Page @_qPage / @_qTotalPages</span>
                        <LxButton Label="Next" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" Disabled="@(_qPage >= _qTotalPages)" OnClick="@(() => SetPage(_qPage + 1))" />
                        <span class="ms-2 font-mono text-xs text-(--lux-text-muted)">PageSize:</span>
                        @foreach (var sz in new[] { 2, 3, 5 })
                        {
                            <LxButton Label="@sz.ToString()" Size="LxSize.Sm" Color="@(_qPageSize == sz ? LxColor.Primary : LxColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => SetPageSize(sz))" />
                        }
                    </div>
                    <div class="grid gap-2 sm:grid-cols-3">
                        @foreach (var item in _qPageResult.Items)
                        {
                            <div class="flex items-center justify-between rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 px-3 py-2 font-mono text-xs">
                                <span>#@item.Id @item.Name</span>
                                <strong>€@item.Price</strong>
                            </div>
                        }
                    </div>
                </div>
                break;

            case "query-facets-cursor":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-xs text-(--lux-text-muted)">FacetMode:</span>
                        <LxButton Label="ExcludeSelf (multi-select UX)" Size="LxSize.Sm" Color="@(_qFacetMode == FacetMode.ExcludeSelf ? LxColor.Primary : LxColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => SetFacetMode(FacetMode.ExcludeSelf))" />
                        <LxButton Label="IncludeSelf (strict intersection)" Size="LxSize.Sm" Color="@(_qFacetMode == FacetMode.IncludeSelf ? LxColor.Primary : LxColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => SetFacetMode(FacetMode.IncludeSelf))" />
                        <LxButton Label="Next Cursor Page" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" Disabled="@(_qCursorResult.NextCursor is null)" OnClick="@NextCursorPage" />
                        <LxButton Label="Reset Cursor" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" Disabled="@(_qCursor is null)" OnClick="@ResetCursorPage" />
                    </div>
                    <div class="grid gap-3 lg:grid-cols-2">
                        <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3">
                            <p class="font-mono text-xs uppercase text-(--lux-text-muted)">Live Facet Buckets (Click to filter)</p>
                            <div class="mt-2 flex flex-wrap gap-2">
                                @if (_qCursorResult.Facets is { Count: > 0 } facets)
                                {
                                    @foreach (var opt in facets[0].Options)
                                    {
                                        var active = _qFacetCat == opt.Value;
                                        <LxButton Label="@($"{opt.Value} ({opt.Count})")" Size="LxSize.Sm" Color="@(active ? LxColor.Primary : LxColor.Neutral)" Variant="@(active ? ButtonVariant.Solid : ButtonVariant.Outline)" OnClick="@(() => ToggleFacetCat(opt.Value))" />
                                    }
                                }
                            </div>
                            <p class="mt-3 font-mono text-[11px] text-(--lux-text-muted)">
                                Active cursor: <code class="text-(--lux-text-highlighted)">@(_qCursor ?? "(first page)")</code><br />
                                NextCursor: <code class="text-(--lux-text-highlighted)">@(_qCursorResult.NextCursor ?? "(end of stream)")</code>
                            </p>
                        </div>
                        <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3">
                            <p class="font-mono text-xs uppercase text-(--lux-text-muted)">Keyset Cursor Slice (Take = 2 · Total = @_qCursorResult.TotalCount)</p>
                            <ul class="mt-2 space-y-1.5 font-mono text-xs">
                                @foreach (var item in _qCursorResult.Items)
                                {
                                    <li class="flex justify-between rounded-lg bg-(--lux-bg) px-2.5 py-1.5">
                                        <span>#@item.Id @item.Name (@item.Category)</span>
                                        <strong>€@item.Price</strong>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
                break;

            case "query-url-codecs":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <div class="w-48"><LxInput Value="@_uSearch" ValueChanged="@OnUrlSearch" Placeholder="Search term (q)..." aria-label="URL search" /></div>
                        <LxButton Label="@($"Prefix: {(_uPrefix ?? "(none)")}")" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ToggleUrlPrefix" />
                        <LxButton Label="@($"Layout: {_uLayout}")" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ToggleUrlLayout" />
                        <LxButton Label="@($"Page: {_uPage}")" Size="LxSize.Sm" Color="LxColor.Primary" Variant="ButtonVariant.Soft" OnClick="@NextUrlPage" />
                        <LxButton Label="@(_uOnlyAudio ? "Category: Audio" : "Category: All")" Size="LxSize.Sm" Color="@(_uOnlyAudio ? LxColor.Success : LxColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@ToggleUrlAudio" />
                    </div>
                    <div class="rounded-xl border border-(--lux-border) bg-(--pg-code-bg) p-3 font-mono text-xs text-[#d7dcde]">
                        <p class="mb-1 text-[#94a3b8]">1. DataListStateQuery.ToQuery(state, schema, prefix) → URL Query String</p>
                        <code class="break-all text-(--lux-primary)">@_uQueryString</code>
                    </div>
                    <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3 font-mono text-xs">
                        <p class="text-(--lux-text-muted)">2. DataListStateQuery.FromQuery(pairs, schema, prefix) → Restored DataListState</p>
                        <p class="mt-1 text-(--lux-text-highlighted)">
                            Search=<strong>"@_uRestored.Search"</strong> · Page=<strong>@_uRestored.Page</strong> · Layout=<strong>@_uRestored.Layout</strong> · Filters=<strong>@_uRestored.Filters.Count</strong> · Equals Original: <strong>@_uRoundTripOk</strong>
                        </p>
                    </div>
                </div>
                break;

            case "table-basic":
                <LxDataList TItem="TableDemoRow" Schema="@TableSchema" Items="@TableRows" UrlSync="false">
                    <LxDataListTable TItem="TableDemoRow" HeaderMenu="true" ShowProgressLine="true" Summaries="@(new DataListSummaries<TableDemoRow>())">
                        <LxDataListColumn TItem="TableDemoRow" Field="name" Title="Employee" />
                        <LxDataListColumn TItem="TableDemoRow" Field="dept" Title="Department" />
                        <LxDataListColumn TItem="TableDemoRow" Field="salary" Title="Salary (€)" Summary="DataListSummaryKind.Sum" />
                    </LxDataListTable>
                </LxDataList>
                break;

            case "table-tree":
                <LxDataList TItem="OrgRow" Schema="@OrgSchema" Items="@OrgRoots" UrlSync="false">
                    <LxDataListTable TItem="OrgRow" Tree="@OrgTree">
                        <LxDataListColumn TItem="OrgRow" Field="name" Title="Organization Hierarchy" />
                        <LxDataListColumn TItem="OrgRow" Field="role" Title="Role" />
                    </LxDataListTable>
                </LxDataList>
                break;

            case "table-grouped":
                <div class="flex flex-col gap-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-xs text-(--lux-text-muted)">Density:</span>
                        @foreach (var d in Enum.GetValues<DataListDensity>())
                        {
                            <LxButton Label="@d.ToString()" Size="LxSize.Sm" Color="@(_tableDensity == d ? LxColor.Primary : LxColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => _tableDensity = d)" />
                        }
                    </div>
                    <LxDataList TItem="TableDemoRow" Schema="@TableSchema" Items="@TableRows" UrlSync="false">
                        <LxDataListTable TItem="TableDemoRow" Density="@_tableDensity" GroupBy="@TableGroupBy" Summaries="@(new DataListSummaries<TableDemoRow>())">
                            <LxDataListColumn TItem="TableDemoRow" Field="name" Title="Employee" />
                            <LxDataListColumn TItem="TableDemoRow" Field="dept" Title="Department" />
                            <LxDataListColumn TItem="TableDemoRow" Field="salary" Title="Salary (€)" Summary="DataListSummaryKind.Average" />
                        </LxDataListTable>
                    </LxDataList>
                </div>
                break;

            case "table-density-summary":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-xs text-(--lux-text-muted)">Summary Kind:</span>
                        @foreach (var kind in new[] { DataListSummaryKind.Sum, DataListSummaryKind.Average, DataListSummaryKind.Min, DataListSummaryKind.Max, DataListSummaryKind.Count })
                        {
                            <LxButton Label="@kind.ToString()" Size="LxSize.Sm" Color="@(_tableSummaryKind == kind ? LxColor.Primary : LxColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => _tableSummaryKind = kind)" />
                        }
                        <LxButton Label="@(_tableMobileSummary ? "View: Compact Mobile Summary" : "View: Standard Table")" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => _tableMobileSummary = !_tableMobileSummary)" />
                    </div>
                    <LxDataList TItem="TableDemoRow" Schema="@TableSchema" Items="@TableRows" UrlSync="false">
                        <LxDataListTable TItem="TableDemoRow"
                                         RowSummary="@(_tableMobileSummary ? TablePhoneSummary : null)"
                                         Summaries="@(new DataListSummaries<TableDemoRow>())">
                            <LxDataListColumn TItem="TableDemoRow" Field="name" Title="Employee" />
                            <LxDataListColumn TItem="TableDemoRow" Field="dept" Title="Department" />
                            <LxDataListColumn TItem="TableDemoRow" Field="salary" Title="Salary (€)" Summary="@_tableSummaryKind" />
                        </LxDataListTable>
                    </LxDataList>
                </div>
                break;

            case "table-selection-actions":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <LxButton Label="Inspect Headless BuildTree()" Size="LxSize.Sm" OnClick="@InspectHeadlessTree" />
                        <LxButton Label="@($"Expand Depth: {_treeDepth}")" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@CycleTreeDepth" />
                    </div>
                    <div class="grid gap-2 sm:grid-cols-2 font-mono text-xs">
                        @foreach (var node in _headlessNodes)
                        {
                            <div class="flex items-center justify-between rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 px-3 py-2" style="@($"padding-left:{12 + node.Depth * 18}px")">
                                <span>@(node.HasChildren ? "▸" : "•") @node.Item.Name <span class="text-(--lux-text-muted)">(@node.Item.Role)</span></span>
                                <span class="text-(--lux-text-muted)">Depth @node.Depth</span>
                            </div>
                        }
                    </div>
                    <p class="font-mono text-xs text-(--lux-text-muted)">
                        <code>DataListTree&lt;T&gt;.BuildTree()</code> runs 100% headless in <code>Lux.Table.Core</code> (NativeAOT): <strong>@_headlessNodes.Count</strong> nodes, cycle-guarded.
                    </p>
                </div>
                break;

            case "form-reactive":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-(--lux-border) bg-(--lux-bg-muted)/40 px-3 py-2 font-mono text-xs">
                        <span>IsDirty: <strong>@_formCtrl.IsDirty</strong></span>
                        <span>DirtyPaths: <strong>@(_formCtrl.DirtyPaths.Count == 0 ? "none" : string.Join(", ", _formCtrl.DirtyPaths))</strong></span>
                        <span>Company visible (age &ge; 21): <strong>@(_formCtrl.GetValue<double>("age") >= 21)</strong></span>
                    </div>
                    <LxFormEngine Form="@_formCtrl" SubmitLabel="Validate & Submit" ShowReset="true" />
                </div>
                break;

            case "form-wizard":
                <div class="flex flex-col gap-3">
                    <p class="font-mono text-xs text-(--lux-text-muted)">
                        Step @(_wizardCtrl.CurrentStepIndex + 1) · Active: <strong>@_wizardCtrl.CurrentStep?.Title</strong>
                        (Select <code>free</code> to skip the Billing step automatically via <code>SkipWhen</code>)
                    </p>
                    <LxFormEngine Form="@_wizardCtrl" SubmitLabel="Complete Onboarding" ShowReset="true" />
                </div>
                break;

            case "form-array":
                <div class="flex flex-col gap-4">
                    <LxFormEngine Form="@_arrayCtrl" SubmitLabel="Build Invoice Payload" ShowReset="true" />
                    <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3 font-mono text-xs">
                        Line items count: <strong>@_arrayCtrl.GetArrayItems("items").Count</strong>
                    </div>
                </div>
                break;

            case "form-dirty-diff":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <LxButton Label="Mutate Name -> 'Claire'" Size="LxSize.Sm" OnClick="@(() => { _dirtyCtrl.SetValue("name", "Claire", markTouched: true); RefreshDirtyJson(); })" />
                        <LxButton Label="Mutate Plan -> 'enterprise'" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => { _dirtyCtrl.SetValue("plan", "enterprise", markTouched: true); RefreshDirtyJson(); })" />
                        <LxButton Label="ResetField('name')" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Soft" OnClick="@(() => { _dirtyCtrl.ResetField("name"); RefreshDirtyJson(); })" />
                        <LxButton Label="SubmitAsync() (Re-baseline)" Size="LxSize.Sm" Color="LxColor.Success" Variant="ButtonVariant.Soft" OnClick="@SubmitDirtyDemoAsync" />
                    </div>
                    <div class="grid gap-3 lg:grid-cols-2 font-mono text-xs">
                        <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3 space-y-1">
                            <p>IsDirty: <strong class="text-(--lux-text-highlighted)">@_dirtyCtrl.IsDirty</strong></p>
                            <p>DirtyPaths: <strong class="text-(--lux-text-highlighted)">@(_dirtyCtrl.DirtyPaths.Count == 0 ? "(clean)" : string.Join(", ", _dirtyCtrl.DirtyPaths))</strong></p>
                            <p>Value(name): <strong>@(_dirtyCtrl.GetValue<string>("name"))</strong> · Value(plan): <strong>@(_dirtyCtrl.GetValue<string>("plan"))</strong></p>
                        </div>
                        <div class="rounded-xl border border-(--lux-border) bg-(--pg-code-bg) p-3 text-[#d7dcde]">
                            <p class="mb-1 text-[#94a3b8]">BuildOutput() (trimmed &amp; transformed)</p>
                            <pre class="overflow-x-auto">@_dirtyOutputJson</pre>
                        </div>
                    </div>
                </div>
                break;

            case "form-sections-errors":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <LxButton Label="Inject Server Blocking Error on 'email'" Size="LxSize.Sm" Color="LxColor.Error" Variant="ButtonVariant.Soft" OnClick="@(() => _sectionCtrl.SetError("email", "Email already registered on server", blocking: true))" />
                        <LxButton Label="ClearError('email')" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => _sectionCtrl.ClearError("email"))" />
                        <LxButton Label="Fill All Required" Size="LxSize.Sm" Color="LxColor.Success" Variant="ButtonVariant.Soft" OnClick="@(() => { _sectionCtrl.SetValue("email", "team@luxstack.dev"); _sectionCtrl.SetValue("vat", "FR99123456789"); _sectionCtrl.ClearError("email"); })" />
                    </div>
                    <div class="grid gap-3 sm:grid-cols-3 font-mono text-xs">
                        @foreach (var sec in _sectionCtrl.GetSectionStates())
                        {
                            <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3">
                                <p class="text-(--lux-text-muted)">@sec.Label</p>
                                <p class="mt-1 text-sm font-semibold text-(--lux-text-highlighted)">@sec.Status</p>
                            </div>
                        }
                    </div>
                    <p class="font-mono text-xs text-(--lux-text-muted)">
                        HasBlockingErrors: <strong class="text-(--lux-text-highlighted)">@_sectionCtrl.HasBlockingErrors</strong> · Email error: <strong>@(_sectionCtrl.GetError("email") ?? "none")</strong>
                    </p>
                </div>
                break;

            case "dashboard-kpi":
                <div class="flex flex-col gap-5">
                    <LxDashboardStats Title="Executive KPIs" Items="@DashStats" />
                    <div class="grid gap-4 lg:grid-cols-2">
                        <LxDashboardGauge Title="Q4 ARR Target" Value="86" Max="100" Target="90" Format="DashboardFormatPreset.Percent" Caption="86% reached" />
                        <LxDashboardBars Title="Platform Distribution" Items="@DashBars" Format="DashboardFormatPreset.Compact" />
                    </div>
                </div>
                break;

            case "dashboard-waves":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <LxButton Label="Run Staged RefreshAsync()" Size="LxSize.Sm" OnClick="@RunDashWavesAsync" />
                        <LxButton Label="Activate Deferred Resource" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ActivateDeferredAsync" />
                    </div>
                    <div class="grid gap-3 sm:grid-cols-3 font-mono text-xs">
                        <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3">
                            <p class="text-(--lux-text-muted)">WAVE 1 · ESSENTIAL</p>
                            <p class="mt-1 text-base font-semibold text-(--lux-text-highlighted)">@_waveEssential.State</p>
                            <p class="mt-1">Value: @(_waveEssential.Data?.ToString() ?? "—")</p>
                        </div>
                        <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3">
                            <p class="text-(--lux-text-muted)">WAVE 2 · BACKGROUND</p>
                            <p class="mt-1 text-base font-semibold text-(--lux-text-highlighted)">@_waveBackground.State</p>
                            <p class="mt-1">Value: @(_waveBackground.Data ?? "—")</p>
                        </div>
                        <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3">
                            <p class="text-(--lux-text-muted)">WAVE 3 · DEFERRED</p>
                            <p class="mt-1 text-base font-semibold text-(--lux-text-highlighted)">@_waveDeferred.State</p>
                            <p class="mt-1">Value: @(_waveDeferred.Data ?? "Idle until activated")</p>
                        </div>
                    </div>
                </div>
                break;

            case "dashboard-table-alerts":
                <div class="flex flex-col gap-4">
                    <LxDashboardTable Title="Top Regions" Menu="true" Columns="@DashTableCols" Rows="@DashTableRows" />
                    <div class="grid gap-4 lg:grid-cols-2">
                        <LxDashboardAlerts Title="Operational Alerts" Items="@DashAlerts" />
                        <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-4">
                            <div class="flex items-center justify-between gap-2">
                                <span class="font-mono text-xs uppercase text-(--lux-text-muted)">DashboardFormat.ExportCsv (fr-FR BOM)</span>
                                <LxButton Label="Generate CSV" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@GenerateSampleCsv" />
                            </div>
                            <pre class="mt-3 overflow-x-auto font-mono text-xs text-(--lux-text-highlighted)">@_dashCsvPreview</pre>
                        </div>
                    </div>
                </div>
                break;

            case "dashboard-filters-views":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-xs text-(--lux-text-muted)">Views:</span>
                        @foreach (var v in _dashFilterCtrl.Views)
                        {
                            <LxButton Label="@(v.Badge is null ? v.Label : $"{v.Label} ({v.Badge})")" Size="LxSize.Sm" Color="@(_dashFilterCtrl.CurrentView == v.Key ? LxColor.Primary : LxColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => _dashFilterCtrl.CurrentView = v.Key)" />
                        }
                        <span class="ms-2 font-mono text-xs text-(--lux-text-muted)">Regions:</span>
                        @foreach (var r in new[] { "eu", "us", "ap" })
                        {
                            var active = _dashRegionFilter.Values.Contains(r);
                            <LxButton Label="@r.ToUpperInvariant()" Size="LxSize.Sm" Color="@(active ? LxColor.Primary : LxColor.Neutral)" Variant="@(active ? ButtonVariant.Solid : ButtonVariant.Outline)" OnClick="@(() => _dashRegionFilter.Toggle(r))" />
                        }
                        <LxButton Label="ResetFilters()" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" Disabled="@(!_dashFilterCtrl.Filtered)" OnClick="@(() => _dashFilterCtrl.ResetFilters())" />
                    </div>
                    <div class="rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/40 p-3 font-mono text-xs">
