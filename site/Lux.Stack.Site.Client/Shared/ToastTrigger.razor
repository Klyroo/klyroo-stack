@inject IToastService Toasts

<LxButton Label="Deploy to production" Size="LxSize.Sm" OnClick="Deploy" />

@code {
    private async Task Deploy() => await Toasts.Add(new LxToast
    {
        Title = "Deployed",
        Description = "lux-ui is live on production.",
        Color = LxColor.Success,
    });
}
