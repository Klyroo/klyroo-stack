<div class="h-64 w-full overflow-hidden rounded-xl border border-(--lux-border)">
    <LxDashboardGroup>
        <LxDashboardPanel>
            <Header>
                <LxDashboardNavbar Title="Orders" Toggle="false" />
                <LxDashboardToolbar data-testid="dashboard-toolbar">
                    <Left>
                        <LxButton Label="Filter" Size="LxSize.Sm" Variant="ButtonVariant.Outline" Color="LxColor.Neutral" LeadingIcon="@(LxIcons.Named("list", "size-4"))" />
                        <LxButton Label="Export" Size="LxSize.Sm" Variant="ButtonVariant.Ghost" Color="LxColor.Neutral" />
                    </Left>
                    <Right>
                        <span class="text-sm text-(--lux-text-muted)">24 orders</span>
                    </Right>
                </LxDashboardToolbar>
            </Header>
            <Body><p class="text-sm text-(--lux-text-muted)">A secondary bar under the navbar.</p></Body>
        </LxDashboardPanel>
    </LxDashboardGroup>
</div>
