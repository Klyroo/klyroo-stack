@* A live preview: the palettes are rendered by LxThemeStyle into a scope, so only this block changes color.
   In your app the same options go in AddLuxUi and LxThemeStyle sits in <head> without parameters.
   Choosing a palette needs interactivity: in static rendering the buttons stay disabled on Indigo. *@
<div id="palette-demo" data-testid="palette-demo" class="flex w-full max-w-xl flex-col gap-5">
    <LxThemeStyle Colors="_colors" Scope="#palette-demo" />

    <div role="group" aria-label="Primary palette" class="flex flex-wrap gap-2">
        @foreach (var palette in _palettes)
        {
            var current = palette;
            <LxButton Label="@current.Name" Size="LxSize.Sm" Color="LxColor.Neutral"
                      Variant="@(current == _primary ? ButtonVariant.Solid : ButtonVariant.Outline)"
                      aria-pressed="@(current == _primary ? "true" : "false")"
                      data-testid="@($"palette-{current.Name}")"
                      OnClick="@(() => Select(current))" />
        }
    </div>

    <div class="flex flex-wrap items-center gap-3">
        <LxButton Label="Primary" data-testid="palette-primary" />
        <LxButton Label="Soft" Variant="ButtonVariant.Soft" />
        <LxButton Label="Outline" Variant="ButtonVariant.Outline" />
        <LxBadge Label="Primary" Variant="LxVariant.Subtle" />
        <LxBadge Label="tertiary" Color="@("tertiary")" Variant="LxVariant.Solid" data-testid="palette-tertiary" />
    </div>
</div>

@code {
    private static readonly LxPalette[] _palettes = [LxPalette.Indigo, LxPalette.Emerald, LxPalette.Rose, LxPalette.Amber, LxPalette.Sky];

    private LxPalette _primary = LxPalette.Indigo;
    private LxColorOptions _colors = Build(LxPalette.Indigo);

    // Like AddLuxUi(o => { o.Colors.Primary = ...; o.Colors.Add("tertiary", ...); }), built per choice because options freeze.
    private static LxColorOptions Build(LxPalette primary)
    {
        var colors = new LxColorOptions { Primary = primary };
        colors.Add("tertiary", primary == LxPalette.Rose ? LxPalette.Violet : LxPalette.Rose);
        return colors;
    }

    private void Select(LxPalette palette)
    {
        _primary = palette;
        _colors = Build(palette);
    }
}
