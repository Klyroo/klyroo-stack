@* Rows in memory, described by a schema: the list sorts and pages them itself. The state lives in the URL under the prefix "mem" (mem.q, mem.s, mem.p, mem.ps). *@
<div class="w-full" data-testid="list-memory">
    <LxDataList TItem="Invoice" Label="Invoices in memory" Schema="InvoiceData.Schema" Items="InvoiceData.All" UrlKey="mem" ResultJson="DemoJson.Default.DataListResultInvoice">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <LxDataListSearch data-testid="mem-search" />
            <LxDataListResultCount />
            <LxDataListRefresh />
        </div>
        <LxDataListErrorState />
        <LxDataListTable Caption="Invoices">
            <LxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <LxDataListColumn Field="customer" />
            <LxDataListColumn Field="status" />
            <LxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
            <LxDataListColumn Field="issued" Format="d" />
        </LxDataListTable>
        <LxDataListPagination />
    </LxDataList>
</div>
