<div class="flex w-full max-w-xs flex-col gap-3">
    <LxFormField Label="Home country">
        <LxSelectMenu OptionsProvider="_source.ByPage" Items="Known" PageSize="20" Value="_values" ValueChanged="@(v => _values = v ?? [])" data-testid="remote-named" />
    </LxFormField>
    <p class="text-sm text-(--lux-text-muted)" data-testid="remote-named-state">Selected: @string.Join(", ", _values)</p>
</div>

@code {
    private readonly RemoteDirectory _source = new();
    private IReadOnlyList<string> _values = ["fr"];

    // Items are not listed when there is a provider, but they name values: France shows as France in every render mode, without a call to the source.
    private static readonly LxSelectItem[] Known = [new("fr", "France")];
}
