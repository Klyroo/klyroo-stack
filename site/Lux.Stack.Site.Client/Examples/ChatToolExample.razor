@* The default content makes the block collapsible. Actions sit under the name, outside the collapsible part. *@
<div class="flex w-full max-w-xl flex-col gap-4" data-testid="chat-tool-example">
    <LxChatTool Text="Searched the documentation" Suffix='"chat prompt"' Icon="@LxIcons.Named("search", "size-4")" data-testid="chat-tool-done">
        <p>Input: {"query": "chat prompt"}</p>
        <p>Output: 3 results</p>
    </LxChatTool>
    <LxChatTool Text="Reading a file" Suffix="notes.txt" Loading Streaming data-testid="chat-tool-running" />
    <LxChatTool Text="Calling the weather API" Error Variant="ChatToolVariant.Card" data-testid="chat-tool-failed">
        <p>Error: the service did not answer in time.</p>
    </LxChatTool>
    <LxChatTool Text="Delete the draft" Suffix="draft.md" Variant="ChatToolVariant.Card" Icon="@LxIcons.Named("trash", "size-4")" data-testid="chat-tool-approval">
        <Actions>
            <LxButton Label="Allow" Size="LxSize.Xs" OnClick="Allow" data-testid="chat-tool-allow" />
            <LxButton Label="Deny" Size="LxSize.Xs" Variant="ButtonVariant.Outline" Color="LxColor.Neutral" OnClick="Deny" data-testid="chat-tool-deny" />
        </Actions>
        <ChildContent><p>Arguments: {"path": "draft.md"}</p></ChildContent>
    </LxChatTool>
    <p class="text-sm text-(--lux-text-muted)" role="status" data-testid="chat-tool-answer">@(_answer ?? "Waiting for your answer")</p>
</div>

@code {
    private string? _answer;

    private void Allow() => _answer = "Allowed";

    private void Deny() => _answer = "Denied";
}
