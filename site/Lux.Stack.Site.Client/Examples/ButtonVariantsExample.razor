<div class="flex flex-col gap-3">
    @foreach (var color in Colors)
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var variant in Enum.GetValues<ButtonVariant>())
            {
                <LxButton Color="color" Variant="variant" Label="@($"{color} {variant}")" />
            }
        </div>
    }
</div>

@code {
    private static readonly LxColor[] Colors =
        [LxColor.Primary, LxColor.Secondary, LxColor.Success, LxColor.Info, LxColor.Warning, LxColor.Error, LxColor.Neutral];
}
