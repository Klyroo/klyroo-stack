<div class="w-full max-w-md">
    <LxCarousel Items="Items" AutoPlay="2000" Loop Arrows="false" AriaLabel="News" data-testid="news" />
</div>

@code {
    private static RenderFragment Slide(string text) =>
        @<div class="flex h-32 items-center justify-center bg-(--lux-bg-muted) p-4 text-center text-sm text-(--lux-text-highlighted)">@text</div>;

    private static readonly LxCarouselItem[] Items =
    [
        new(Slide("A new release is out.")),
        new(Slide("The docs have a new section.")),
        new(Slide("The next meetup is in March.")),
    ];
}
