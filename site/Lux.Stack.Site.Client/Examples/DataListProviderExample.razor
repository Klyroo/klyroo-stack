@using Lux.Query

@* A provider loads the rows: here after a delay, as a database or an API would. While the first rows load the table shows placeholders; later requests keep the previous rows on screen. *@
<div class="w-full" data-testid="list-provider">
    <LxDataList TItem="Invoice" Label="Invoices from a provider" Schema="InvoiceData.Schema" Provider="LoadAsync" UrlKey="prov" ResultJson="DemoJson.Default.DataListResultInvoice" Density="DataListDensity.Compact">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <LxDataListResultCount />
            <LxDataListRefresh />
        </div>
        <LxDataListErrorState />
        <LxDataListTable Caption="Invoices from a provider">
            <LxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <LxDataListColumn Field="customer" />
            <LxDataListColumn Field="status">
                <Template Context="invoice">
                    <LxBadge Label="@invoice.Status" Variant="LxVariant.Soft" Color="@StatusColor(invoice.Status)" />
                </Template>
            </LxDataListColumn>
            <LxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </LxDataListTable>
        <LxDataListPagination />
    </LxDataList>
</div>

@code {
    private async ValueTask<DataListResult<Invoice>> LoadAsync(DataListRequest request, CancellationToken cancellationToken)
    {
        // The token is cancelled when a newer request replaces this one.
        await Task.Delay(600, cancellationToken);
        return InvoiceData.Schema.ExecuteInMemory(InvoiceData.All, request);
    }

    private static LxColor StatusColor(string status) => status switch
    {
        "Paid" => LxColor.Success,
        "Pending" => LxColor.Warning,
        "Overdue" => LxColor.Error,
        _ => LxColor.Neutral,
    };
}
