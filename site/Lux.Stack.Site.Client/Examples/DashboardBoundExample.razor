<div class="flex flex-col gap-3">
    <div class="h-72 w-full overflow-hidden rounded-xl border border-(--lux-border)" data-testid="dashboard-bound">
        <LxDashboardGroup StorageKey="playground-dashboard-bound" @bind-Sizes="_sizes">
            <LxDashboardSidebar As="div" @bind-Collapsed="_collapsed" data-testid="dashboard-bound-sidebar">
                <Header><span class="font-semibold text-(--lux-text-highlighted)">Acme</span></Header>
                <ChildContent>
                    <LxNavigationMenu Items="_items" Orientation="LxOrientation.Vertical" AriaLabel="Workspace, bound" Ui="_navUi" />
                </ChildContent>
            </LxDashboardSidebar>
            <LxDashboardPanel Resizable Size="40" MinSize="15" MaxSize="85" ResizeLabel="Resize list">
                <Header>
                    <LxDashboardNavbar Title="List">
                        <Leading><LxDashboardSidebarCollapse data-testid="dashboard-bound-collapse" /></Leading>
                    </LxDashboardNavbar>
                </Header>
            </LxDashboardPanel>
            <LxDashboardPanel>
                <Header><LxDashboardNavbar Title="Detail" Toggle="false" /></Header>
            </LxDashboardPanel>
        </LxDashboardGroup>
    </div>
    <div class="flex flex-wrap items-center gap-3 text-sm text-(--lux-text-muted)">
        <p data-testid="dashboard-bound-sizes">Sizes: @string.Join(",", _sizes.Select(s => Math.Round(s)))</p>
        <p data-testid="dashboard-bound-collapsed">Collapsed: @(_collapsed ? "true" : "false")</p>
        <LxButton Label="Set 25 / 75" Size="LxSize.Sm" Variant="ButtonVariant.Outline" Color="LxColor.Neutral" OnClick="() => _sizes = [25, 75]" data-testid="dashboard-bound-set" />
    </div>
</div>

@code {
    private IReadOnlyList<double> _sizes = [40, 60];
    private bool _collapsed;

    private static readonly NavigationMenuUi _navUi = new() { Label = "group-data-[state=collapsed]/sidebar:sr-only" };

    private static readonly LxNavigationItem[] _items =
    [
        new("Home") { Href = "/", Exact = true, Icon = LxIcons.Named("home", "size-5") },
        new("Inbox") { Href = "/components/dashboard-group", Icon = LxIcons.Named("inbox", "size-5") },
    ];
}
