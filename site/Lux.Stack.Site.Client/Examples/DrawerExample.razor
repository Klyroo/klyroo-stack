<div class="flex flex-col items-center gap-3">
    <LxDrawer @bind-Open="_open" Title="Quick actions" Description="Pick something to do next.">
        <ChildContent><LxButton Label="Open drawer" Variant="ButtonVariant.Outline" data-testid="drawer-trigger" /></ChildContent>
        <Body>
            <p class="text-sm text-(--lux-text-muted)">The drawer is a native modal dialog: the page behind it is inert and Escape closes it.</p>
        </Body>
        <Footer>
            <LxButton Label="Cancel" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" data-lx-close />
            <LxButton Label="Done" data-lx-close data-testid="drawer-done" />
        </Footer>
    </LxDrawer>
    <p class="text-sm text-(--lux-text-muted)" data-testid="drawer-state">Drawer: @(_open ? "open" : "closed")</p>
</div>

@code {
    private bool _open;
}
