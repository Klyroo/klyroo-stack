<div class="flex flex-col items-center gap-3">
    <LxDropdownMenu Items="Items" OnSelect="item => _last = item.Label">
        <LxButton Label="Options" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" data-testid="menu-trigger">
            <TrailingIcon>@LxIcons.Named("chevron-down")</TrailingIcon>
        </LxButton>
    </LxDropdownMenu>
    <p class="text-sm text-(--lux-text-muted)" data-testid="menu-state">Last action: @(_last ?? "none")</p>
</div>

@code {
    private string? _last;

    private static readonly LxMenuItem[] Items =
    [
        LxMenuItem.Heading("My account"),
        new() { Label = "Profile", Shortcut = "⌘P" },
        new() { Label = "Billing", Shortcut = "⌘B" },
        new() { Label = "Documentation", Href = "/docs" },
        LxMenuItem.Separator(),
        new() { Label = "Archive", Disabled = true },
        new() { Label = "Delete account", Color = LxColor.Error },
    ];
}
