<div class="flex h-72 w-full flex-col overflow-hidden rounded-xl border border-(--lux-border) lg:flex-row">
    <LxSidebar Id="playground-sidebar-resizable" Resizable Collapsible="false" Width="224" As="div" data-testid="sidebar-resizable">
        <Header>
            <span class="font-semibold text-(--lux-text-highlighted)">Acme</span>
        </Header>
        <ChildContent>
            <LxNavigationMenu Items="_items" Orientation="LxOrientation.Vertical" AriaLabel="Workspace, resizable" />
        </ChildContent>
    </LxSidebar>
    <div class="min-w-0 flex-1 p-6 text-sm text-(--lux-text-muted)">
        Drag the edge of the sidebar, or focus it and use the arrow keys, Home and End.
    </div>
</div>

@code {
    private static readonly LxNavigationItem[] _items =
    [
        new("Home") { Href = "/", Exact = true },
        new("Inbox") { Href = "/components/sidebar" },
        new("Settings") { Href = "/docs/theming" },
    ];
}
