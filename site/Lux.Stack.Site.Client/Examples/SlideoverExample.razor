<div class="flex flex-col items-center gap-3">
    <LxSlideover @bind-Open="_open" Title="Edit profile" Description="Changes are saved when you press Save.">
        <ChildContent><LxButton Label="Open slideover" Variant="ButtonVariant.Outline" data-testid="slideover-trigger" /></ChildContent>
        <Body>
            <div class="flex flex-col gap-4">
                <LxFormField Label="Name"><LxInput Value="Ada Lovelace" /></LxFormField>
                <LxFormField Label="Bio"><LxTextarea Rows="3" /></LxFormField>
            </div>
        </Body>
        <Footer>
            <LxButton Label="Cancel" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" data-lx-close />
            <LxButton Label="Save" data-lx-close data-testid="slideover-save" />
        </Footer>
    </LxSlideover>
    <p class="text-sm text-(--lux-text-muted)" data-testid="slideover-state">Slideover: @(_open ? "open" : "closed")</p>
</div>

@code {
    private bool _open;
}
