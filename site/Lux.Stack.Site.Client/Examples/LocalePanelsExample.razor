@* One LxApp per locale: its texts, its writing direction and the culture of its dates and numbers apply to everything inside.
   Nothing here needs interactivity, so it renders the same in every mode. *@
<div class="grid w-full gap-4 md:grid-cols-3">
    @foreach (var locale in _locales)
    {
        <LxApp Locale="locale" Toaster="false" Class="flex flex-col gap-3 rounded-lg border border-(--lux-border) p-4" data-testid="@($"locale-panel-{locale.Code}")">
            <p class="font-medium">@locale.Name <span class="text-xs text-(--lux-text-muted)">(@locale.Code, @locale.DirAttribute)</span></p>
            <LxFileUpload MaxSize="1536" />
            <LxCalendar Value="@_date" Size="LxSize.Sm" />
        </LxApp>
    }
</div>

@code {
    private static readonly LxLocale[] _locales = [LxLocales.Fr, LxLocales.Ar, LxLocales.Ja];
    private readonly DateOnly _date = new(2026, 3, 5);
}
