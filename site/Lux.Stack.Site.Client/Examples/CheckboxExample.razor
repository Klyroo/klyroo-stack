<div class="flex flex-col gap-3">
    <LxCheckbox @bind-Value="_updates" Label="Product updates" Description="A short email when something ships." />
    <LxCheckbox Value="true" Label="Success color" Color="LxColor.Success" />
    <LxCheckbox Disabled Label="Disabled" />
    <p class="text-sm text-(--lux-text-muted)">Updates: @(_updates ? "yes" : "no")</p>
</div>

@code {
    private bool _updates;
}
