@* A small form to move through with a remote control (TV mode): Select/Enter edits a field, Back or Enter leaves it. *@
<div class="flex w-full max-w-xs flex-col gap-3" data-testid="tv-form">
    <LxFormField Label="Name"><LxInput Value="Ada Lovelace" data-testid="tv-name" /></LxFormField>
    <LxFormField Label="Country">
        <LxSelect @bind-Value="_country" Items="Countries" Placeholder="Choose a country" data-testid="tv-country" />
    </LxFormField>
    <LxFormField Label="Bio"><LxTextarea Rows="3" data-testid="tv-bio" /></LxFormField>
    <LxButton Label="Save" data-testid="tv-save" />
    <p class="text-sm text-(--lux-text-muted)" data-testid="tv-country-state">Selected: @(_country ?? "none")</p>
</div>

@code {
    private string? _country;

    private static readonly LxSelectItem[] Countries = [new("fr", "France"), new("de", "Germany"), new("it", "Italy")];
}
