<div class="flex w-full flex-col gap-4">
    <LxMarquee Duration="25" data-testid="marquee">
        @foreach (var name in Names)
        {
            <LxBadge Label="@name" Variant="LxVariant.Subtle" />
        }
    </LxMarquee>
    <LxMarquee Reverse="true" Duration="40" Overlay="false">
        @foreach (var name in Names)
        {
            <span class="text-sm text-(--lux-text-muted)">@name</span>
        }
    </LxMarquee>
</div>

@code {
    private static readonly string[] Names = ["Blazor", "Tailwind", "Accessible", "Themeable", "Server", "WebAssembly", "Auto", "Static SSR"];
}
