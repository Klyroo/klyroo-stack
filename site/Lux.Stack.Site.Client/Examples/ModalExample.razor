<LxModal @bind-Open="_open" Title="Edit profile" Description="Changes are saved when you close the dialog.">
    <ChildContent><LxButton Label="Edit profile" Variant="ButtonVariant.Outline" data-testid="modal-trigger" /></ChildContent>
    <Body>
        <div class="flex flex-col gap-4">
            <LxFormField Label="Name"><LxInput Value="Ada Lovelace" /></LxFormField>
            <LxFormField Label="Bio"><LxTextarea Rows="3" /></LxFormField>
        </div>
    </Body>
    <Footer>
        <LxButton Label="Cancel" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" data-lx-close />
        <LxButton Label="Save" data-lx-close data-testid="modal-save" />
    </Footer>
</LxModal>
<p class="text-sm text-(--lux-text-muted)" data-testid="modal-state">Dialog: @(_open ? "open" : "closed")</p>

@code {
    private bool _open;
}
