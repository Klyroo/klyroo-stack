@using Lux.UI.Theming
<div class="flex flex-wrap items-center gap-3">
    <LxButton Label="Default" data-testid="theme-default" />
    <LxTheme For="typeof(LxButton)" Ui="_bold">
        <LxButton Label="Themed" data-testid="theme-button" />
        <LxButton Label="Instance wins" Ui='new ButtonUi { Base = "font-normal normal-case tracking-normal" }' data-testid="theme-instance" />
    </LxTheme>
</div>

@code {
    private readonly ButtonUi _bold = new() { Base = "font-extrabold uppercase tracking-wider" };
}
