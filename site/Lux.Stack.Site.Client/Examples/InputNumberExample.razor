<div class="flex w-full max-w-xs flex-col gap-4">
    <LxFormField Label="Quantity">
        <LxInputNumber @bind-Value="_quantity" Min="0" Max="20" />
    </LxFormField>
    <LxFormField Label="Price (French format)">
        <LxInputNumber @bind-Value="_price" Min="0" Step="0.5m" Culture="_french" Orientation="LxOrientation.Vertical" />
    </LxFormField>
    <p class="text-sm text-(--lux-text-muted)" data-testid="number-state">Quantity: @(_quantity?.ToString() ?? "none"), price: @(_price?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "none")</p>
</div>

@code {
    private decimal? _quantity = 2;
    private decimal? _price = 1234.5m;
    private static readonly System.Globalization.CultureInfo _french = new("fr-FR");
}
