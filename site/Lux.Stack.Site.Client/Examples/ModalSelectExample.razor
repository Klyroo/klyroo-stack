<LxModal Title="Shipping" Description="Choose where to ship the order.">
    <ChildContent><LxButton Label="Ship order" Variant="ButtonVariant.Outline" data-testid="modal-select-trigger" /></ChildContent>
    <Body>
        <LxFormField Label="Country">
            <LxSelect @bind-Value="_country" Items="Countries" Placeholder="Choose a country" data-testid="modal-country" />
        </LxFormField>
    </Body>
    <Footer><LxButton Label="Close" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" data-lx-close /></Footer>
</LxModal>

@code {
    private string? _country;

    private static readonly LxSelectItem[] Countries = [new("fr", "France"), new("de", "Germany"), new("it", "Italy")];
}
