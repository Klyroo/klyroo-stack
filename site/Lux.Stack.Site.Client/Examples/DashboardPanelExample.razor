<div class="h-72 w-full overflow-hidden rounded-xl border border-(--lux-border)" data-testid="dashboard-panels">
    <LxDashboardGroup StorageKey="playground-dashboard-panels">
        <LxDashboardPanel Resizable Size="25" MinSize="15" MaxSize="40" ResizeLabel="Resize list" data-testid="dashboard-panel-list">
            <Header><LxDashboardNavbar Title="List" Toggle="false" /></Header>
            <Body><p class="text-sm text-(--lux-text-muted)">Between 15% and 40%.</p></Body>
        </LxDashboardPanel>
        <LxDashboardPanel Resizable Size="50" MinSize="30" ResizeLabel="Resize detail" data-testid="dashboard-panel-detail">
            <Header><LxDashboardNavbar Title="Detail" Toggle="false" /></Header>
            <Body><p class="text-sm text-(--lux-text-muted)">At least 30%. Focus a handle and use the arrow keys, Home and End.</p></Body>
            <Footer><p class="px-4 py-2 text-xs text-(--lux-text-muted)">Footer</p></Footer>
        </LxDashboardPanel>
        <LxDashboardPanel data-testid="dashboard-panel-aside">
            <Header><LxDashboardNavbar Title="Aside" Toggle="false" /></Header>
            <Body><p class="text-sm text-(--lux-text-muted)">Takes what is left.</p></Body>
        </LxDashboardPanel>
    </LxDashboardGroup>
</div>
