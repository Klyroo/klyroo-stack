@* The ErrorContent of an ErrorBoundary hands over the exception: <LxError Exception="exception" />.
   Its message stays hidden unless ShowDetails is set, because exception messages can leak internals. *@
<div class="w-full overflow-hidden rounded-xl border border-(--lux-border)">
    <LxError Exception="_exception" ShowDetails HeadingAs="h3" Clear="false" data-testid="error-boundary">
        <Actions>
            <LxButton Label="Try again" Href="/components/error" />
            <LxButton Label="Contact support" Variant="ButtonVariant.Outline" Color="LxColor.Neutral" Href="/docs" />
        </Actions>
    </LxError>
</div>

@code {
    private readonly Exception _exception = new InvalidOperationException("The report could not be generated.");
}
