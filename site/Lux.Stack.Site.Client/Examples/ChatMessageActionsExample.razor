@* Actions sit under the message, Files above it. Copying needs interactivity, so the buttons wait for it. *@
<div class="flex w-full max-w-xl flex-col gap-4" data-testid="chat-message-actions-example">
    <LxChatMessage Role="ChatRole.User" Text="Can you summarize these?">
        <Files>
            <LxChatAttachment Name="report.pdf" Type="application/pdf" FileSize="248000" Size="LxSize.Sm" />
            <LxChatAttachment Name="notes.txt" Type="text/plain" FileSize="1200" Size="LxSize.Sm" />
        </Files>
    </LxChatMessage>
    <LxChatMessage Role="ChatRole.Assistant" Text="The report covers three themes: cost, speed and accessibility." AvatarText="B" AvatarAlt="Lux assistant">
        <Header>Lux assistant · 9:42</Header>
        <Actions>
            <LxButton Square Size="LxSize.Xs" Variant="ButtonVariant.Ghost" Color="LxColor.Neutral" aria-label="Copy" OnClick="Copy"
                      LeadingIcon="@LxIcons.Named("copy", "size-4")" data-testid="chat-message-copy" />
            <LxButton Square Size="LxSize.Xs" Variant="ButtonVariant.Ghost" Color="LxColor.Neutral" aria-label="Regenerate" OnClick="Regenerate"
                      LeadingIcon="@LxIcons.Named("refresh-cw", "size-4")" data-testid="chat-message-regenerate" />
            @if (_note is not null)
            {
                <span role="status" class="text-xs" data-testid="chat-message-note">@_note</span>
            }
        </Actions>
    </LxChatMessage>
</div>

@code {
    private string? _note;

    private void Copy() => _note = "Copied";

    private void Regenerate() => _note = "Regenerating";
}
