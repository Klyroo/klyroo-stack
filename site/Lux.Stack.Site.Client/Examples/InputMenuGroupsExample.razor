<div class="flex w-full max-w-xs flex-col gap-3">
    <LxFormField Label="Assign to">
        <LxInputMenu Items="People" Strict @bind-Value="_person" Placeholder="Pick a person or a team" />
    </LxFormField>
    <p class="text-sm text-(--lux-text-muted)" data-testid="assign-state">Assigned: @(_person ?? "nobody")</p>
</div>

@code {
    private string? _person;

    private static readonly LxSelectItem[] People =
    [
        new("ada", "Ada Lovelace") { Group = "People", Icon = "bell", Count = 4 },
        new("alan", "Alan Turing") { Group = "People", Icon = "bell", Count = 0 },
        new("grace", "Grace Hopper") { Group = "People", Icon = "bell", Count = 11 },
        new("core", "Core team") { Group = "Teams", Icon = "heart", Count = 18 },
        new("docs", "Docs team") { Group = "Teams", Icon = "heart", Count = 5 },
    ];
}
