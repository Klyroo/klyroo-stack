<div class="w-full max-w-xl">
    <LxPageList>
        @foreach (var (name, role) in _people)
        {
            <li><LxUser Name="@name" Description="@role" /></li>
        }
    </LxPageList>
</div>

@code {
    private readonly (string Name, string Role)[] _people =
    [
        ("Ada Lovelace", "Analyst"),
        ("Grace Hopper", "Compiler pioneer"),
        ("Margaret Hamilton", "Flight software"),
    ];
}
