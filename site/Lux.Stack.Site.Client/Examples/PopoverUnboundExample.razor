<LxPopover Placement="right">
    <ChildContent><LxButton Label="Open unbound" Color="LxColor.Neutral" Variant="ButtonVariant.Subtle" data-testid="unbound-trigger" /></ChildContent>
    <Content>
        <div class="flex w-64 flex-col gap-2 p-4" data-testid="unbound-panel">
            <LxFormField Label="Name" Id="pg-name">
                <LxInput data-testid="unbound-input" />
            </LxFormField>
        </div>
    </Content>
</LxPopover>
