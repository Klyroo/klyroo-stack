@* A handle placed between two panels, instead of Resizable on the first. It resizes the panel before it. *@
<div class="h-56 w-full overflow-hidden rounded-xl border border-(--lux-border)" data-testid="dashboard-handle-frame">
    <LxDashboardGroup>
        <LxDashboardPanel Size="50" data-testid="dashboard-handle-left">
            <Body><p class="text-sm text-(--lux-text-muted)">Editor</p></Body>
        </LxDashboardPanel>
        <LxDashboardResizeHandle Label="Resize editor" Value="50" data-testid="dashboard-handle" />
        <LxDashboardPanel Size="50" data-testid="dashboard-handle-right">
            <Body><p class="text-sm text-(--lux-text-muted)">Preview</p></Body>
        </LxDashboardPanel>
    </LxDashboardGroup>
</div>
