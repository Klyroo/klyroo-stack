@using Lux.UI.Theming
@* One LxTheme can carry several component types, and themes nest: the innermost wins. *@
<LxTheme Overrides="_outer">
    <div class="flex flex-wrap items-center gap-3" data-testid="theme-outer">
        <LxButton Label="Outer" />
        <LxBadge Label="Outer" />
        <LxTheme For="typeof(LxButton)" Ui='new ButtonUi { Base = "rounded-none" }'>
            <LxButton Label="Inner" data-testid="theme-inner" />
        </LxTheme>
    </div>
</LxTheme>

@code {
    private readonly Dictionary<Type, ISlotOverrides> _outer = new()
    {
        [typeof(LxButton)] = new ButtonUi { Base = "rounded-full" },
        [typeof(LxBadge)] = new BadgeUi { Base = "rounded-full" },
    };
}
