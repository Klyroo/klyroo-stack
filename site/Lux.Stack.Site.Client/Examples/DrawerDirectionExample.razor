<LxDrawer Direction="DrawerDirection.Top" Title="From the top" Close>
    <ChildContent><LxButton Label="Top" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--lux-text-muted)">Handle at the bottom edge.</p></Body>
</LxDrawer>
<LxDrawer Direction="DrawerDirection.Left" Title="From the left" Close>
    <ChildContent><LxButton Label="Left" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--lux-text-muted)">Side drawers have no handle.</p></Body>
</LxDrawer>
<LxDrawer Direction="DrawerDirection.Right" Inset Title="Inset, from the right" Close>
    <ChildContent><LxButton Label="Right, inset" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--lux-text-muted)">Inset floats the drawer away from the edges.</p></Body>
</LxDrawer>
