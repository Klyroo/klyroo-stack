<div class="flex flex-col items-center gap-3">
    <LxFormField Label="Brand color">
        <LxColorPicker @bind-Value="_color" data-testid="brand" />
    </LxFormField>
    <p class="text-sm text-(--lux-text-muted)" data-testid="brand-state">Color: @(_color ?? "none")</p>
</div>

@code {
    private string? _color = "#ffd23f";
}
