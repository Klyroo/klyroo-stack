<div class="flex w-full max-w-2xl flex-col gap-3">
    <LxFormField Label="Summary" Help="Select some text to format it.">
        <LxEditor Value="@("<p>Select a few of these words, then use the floating toolbar or press Ctrl+B.</p>")" Name="summary" data-testid="editor-bubble">
            <LxEditorToolbar Layout="EditorToolbarLayout.Bubble" />
        </LxEditor>
    </LxFormField>
    <LxFormField Label="Read only">
        <LxEditor Value="@("<p>This text can be selected and copied, not edited.</p>")" ReadOnly="true" data-testid="editor-readonly" />
    </LxFormField>
</div>
