@* Changing the Locale parameter of LxApp re-renders every component below it, in the new language and direction.
   The buttons need interactivity (they render disabled until the page is interactive); to follow the language of the
   user on every load, rely on the automatic locale and LxLocaleSelect instead. *@
<div class="flex w-full flex-col gap-4">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Locale">
        @foreach (var locale in _locales)
        {
            <LxButton Label="@locale.Name" Variant="@(locale == _locale ? ButtonVariant.Solid : ButtonVariant.Outline)" OnClick="() => Select(locale)" data-testid="@($"locale-switch-{locale.Code}")" />
        }
    </div>
    <LxApp Locale="_locale" Toaster="false" Class="flex flex-col gap-3 rounded-lg border border-(--lux-border) p-4" data-testid="locale-switch-panel">
        <p>Locale: <code data-testid="locale-switch-code">@_locale.Code</code>, direction: <code data-testid="locale-switch-dir">@_locale.DirAttribute</code></p>
        <LxFileUpload MaxSize="2048" />
        <LxPagination Total="50" Page="2" />
    </LxApp>
</div>

@code {
    private static readonly LxLocale[] _locales = [LxLocales.En, LxLocales.Fr, LxLocales.Ar];
    private LxLocale _locale = LxLocales.En;

    private void Select(LxLocale locale) => _locale = locale;
}
