<LxSlideover Side="SlideoverSide.Left" Title="Navigation">
    <ChildContent><LxButton Label="Left" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--lux-text-muted)">Slides in from the left.</p></Body>
</LxSlideover>
<LxSlideover Side="SlideoverSide.Right" Title="Details">
    <ChildContent><LxButton Label="Right" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--lux-text-muted)">Slides in from the right.</p></Body>
</LxSlideover>
<LxSlideover Side="SlideoverSide.Bottom" Title="Activity" Close="false">
    <ChildContent><LxButton Label="Bottom" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--lux-text-muted)">Slides up from the bottom. Escape closes it.</p></Body>
</LxSlideover>
