<div class="flex w-full max-w-xs flex-col gap-3">
    <LxFormField Label="Pickup time">
        <LxInputTime Value="@(new TimeOnly(9, 0))" Hour12="_hour12" Name="pickup" data-testid="unbound-time" />
    </LxFormField>
    <LxButton Variant="ButtonVariant.Outline" Label="Switch the clock" OnClick="Switch" />
</div>

@code {
    private bool _hour12;

    private void Switch() => _hour12 = !_hour12;
}
