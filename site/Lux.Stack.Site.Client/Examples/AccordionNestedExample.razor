@* Components inside a panel keep their own behavior: opening the menu does not collapse the item. *@
<div class="w-full max-w-lg">
    <LxAccordion Items="Items" Value="@(["settings"])" />
</div>

@code {
    private static readonly LxSelectItem[] Themes = [new("light", "Light"), new("dark", "Dark"), new("system", "System")];

    private static readonly LxAccordionItem[] Items =
    [
        new("Settings") { Value = "settings", Content = @<LxFormField Label="Theme"><LxSelect Items="Themes" Placeholder="Pick a theme" /></LxFormField> },
        new("Danger zone") { Value = "danger", Content = @<p>Delete your account.</p> },
    ];
}
