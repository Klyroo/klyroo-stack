@* The Lucide icons are built into the library, by bare name or as i-lucide-{name} / lucide:{name}. An unknown name renders an empty icon marked data-lx-missing-icon. *@
<div class="flex flex-wrap items-center gap-4">
    @foreach (var name in new[] { "search", "bell", "mail", "calendar", "heart", "star", "download", "globe" })
    {
        <LxIcon Name="@name" Size="LxSize.Lg" />
    }
    <LxIcon Name="check" Size="LxSize.Xl" Label="Done" Class="text-(--lux-success-text)" />
</div>
