<div class="flex flex-col items-center gap-4">
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var variant in Enum.GetValues<LxVariant>())
        {
            <LxKbd Variant="variant" Value="K" />
        }
    </div>
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var size in Enum.GetValues<LxSize>())
        {
            <LxKbd Size="size" Value="Esc" />
        }
    </div>
    <p class="flex items-center gap-1 text-sm">
        Open the search with <LxKbd Value="Ctrl" /> <LxKbd Value="K" />
    </p>
</div>
