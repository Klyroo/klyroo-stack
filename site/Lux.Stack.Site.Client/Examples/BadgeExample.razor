<div class="flex flex-col items-center gap-3">
    @foreach (var variant in Enum.GetValues<LxVariant>())
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var color in new[] { LxColor.Primary, LxColor.Success, LxColor.Warning, LxColor.Error, LxColor.Neutral })
            {
                <LxBadge Color="color" Variant="variant" Label="@color.Value" />
            }
        </div>
    }
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var size in Enum.GetValues<LxSize>())
        {
            <LxBadge Size="size" Label="@size.ToString()" Variant="LxVariant.Subtle" />
        }
    </div>
</div>
