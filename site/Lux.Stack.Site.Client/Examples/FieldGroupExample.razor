        <LxButton Label="Left" Variant="ButtonVariant.Outline" Color="LxColor.Neutral" />
        <LxButton Label="Center" Variant="ButtonVariant.Outline" Color="LxColor.Neutral" />
        <LxButton Label="Right" Variant="ButtonVariant.Outline" Color="LxColor.Neutral" />
