<div class="flex w-full max-w-xs flex-col gap-3">
    <LxFormField Label="Languages">
        <LxSelectMenu Items="Languages" Multiple Create @bind-Value="_values" Placeholder="Pick languages" />
    </LxFormField>
    <p class="text-sm text-(--lux-text-muted)" data-testid="multiple-state">Selected: @(_values.Count > 0 ? string.Join(", ", _values) : "none")</p>
</div>

@code {
    private IReadOnlyList<string> _values = ["csharp"];

    private static readonly LxSelectItem[] Languages =
    [
        new("csharp", "C#"), new("fsharp", "F#"), new("ts", "TypeScript"), new("rust", "Rust"), new("go", "Go"),
    ];
}
