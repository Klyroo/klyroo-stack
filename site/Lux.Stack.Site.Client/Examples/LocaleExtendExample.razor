@* LxLocales.Extend derives a locale and overrides only the messages you list; the others are kept. *@
<LxApp Locale="_canadian" Toaster="false" Class="flex w-full flex-col gap-3" data-testid="locale-extend">
    <p>Locale: <code data-testid="locale-extend-code">@_canadian.Code</code></p>
    <LxFileUpload MaxSize="1536" />
</LxApp>

@code {
    private static readonly LxLocale _canadian = LxLocales.Extend(LxLocales.Fr, code: "fr-CA", name: "Français (Canada)",
        messages: m => m with { DropFiles = "Glissez-déposez vos fichiers ici ou cliquez pour parcourir" });
}
