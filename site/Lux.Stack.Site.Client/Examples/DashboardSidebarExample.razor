@* The collapse button and the mobile toggle sit in the navbar, not in the sidebar: they find the sidebar through the
   group. Below the lg breakpoint the sidebar is replaced by the toggle, which opens it as an off-canvas panel. *@
<div class="h-72 w-full overflow-hidden rounded-xl border border-(--lux-border)" data-testid="dashboard-sidebar-frame">
    <LxDashboardGroup StorageKey="playground-dashboard-sidebar">
        <LxDashboardSidebar As="div" Width="224" Resizable data-testid="dashboard-sidebar-only" MobileTitle="Workspace">
            <Header><span class="font-semibold text-(--lux-text-highlighted)">Acme</span></Header>
            <ChildContent>
                <LxNavigationMenu Items="_items" Orientation="LxOrientation.Vertical" AriaLabel="Sections" Ui="_navUi" />
            </ChildContent>
        </LxDashboardSidebar>
        <LxDashboardPanel>
            <Header>
                <LxDashboardNavbar Title="Settings">
                    <Leading><LxDashboardSidebarCollapse data-testid="dashboard-sidebar-collapse" /></Leading>
                </LxDashboardNavbar>
            </Header>
            <Body>
                <p class="text-sm text-(--lux-text-muted)">Collapse the sidebar with the button next to the title, or drag its edge. Both are remembered in the browser.</p>
            </Body>
        </LxDashboardPanel>
    </LxDashboardGroup>
</div>

@code {
    private static readonly NavigationMenuUi _navUi = new() { Label = "group-data-[state=collapsed]/sidebar:sr-only" };

    private static readonly LxNavigationItem[] _items =
    [
        new("Home") { Href = "/", Exact = true, Icon = LxIcons.Named("home", "size-5") },
        new("Messages") { Href = "/components/dashboard-sidebar", Icon = LxIcons.Named("mail", "size-5") },
        new("Settings") { Href = "/docs/theming", Icon = LxIcons.Named("user", "size-5") },
    ];
}
