<div class="w-full max-w-2xl">
    <LxTimeline Items="Items" Active="2" Orientation="LxOrientation.Horizontal" Color="LxColor.Secondary" AriaLabel="Order tracking" />
</div>

@code {
    private static readonly LxTimelineItem[] Items =
    [
        new("Ordered") { Date = "Mon" },
        new("Shipped") { Date = "Tue" },
        new("Out for delivery") { Date = "Wed" },
        new("Delivered") { Date = "Thu" },
    ];
}
