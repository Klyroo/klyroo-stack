@using Lux.Query

@* Cursor paging with a manual Load more button: each click appends the next page in place (10, then 20, then 25), and sorting or searching restarts from the first page.
   Statically rendered, Load more is a link to the next cursor (?cur.c=...), paired with a Back to start link once past the first page. *@
<div class="w-full" data-testid="list-cursor">
    <LxDataList TItem="Invoice" Label="Invoices with cursor paging" Schema="InvoiceData.Schema" Items="_items" PagingMode="DataListPagingMode.Cursor" UrlKey="cur">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <LxDataListSearch />
            <div class="flex items-center gap-2">
                <LxDataListResultCount />
                <LxDataListRefresh />
            </div>
        </div>
        <LxDataListErrorState />
        <LxDataListTable Caption="Invoices with cursor paging">
            <LxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <LxDataListColumn Field="customer" />
            <LxDataListColumn Field="status" />
            <LxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </LxDataListTable>
        <LxDataListInfiniteLoader Auto="false" ShowEnd="true" />
    </LxDataList>
</div>

@code {
    private static readonly Invoice[] _items = InvoiceData.All[..25];
}
