<div class="flex flex-col items-center gap-3">
    <LxDropdownMenu Items="Items" OnSelect="item => _last = item.Label">
        <LxButton Label="Share" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" data-testid="submenu-trigger">
            <TrailingIcon>@LxIcons.Named("chevron-down")</TrailingIcon>
        </LxButton>
    </LxDropdownMenu>
    <p class="text-sm text-(--lux-text-muted)" data-testid="submenu-state">Last action: @(_last ?? "none")</p>
</div>

@code {
    private string? _last;

    private static readonly LxMenuItem[] Items =
    [
        LxMenuItem.Heading("Share"),
        new() { Label = "Copy link" },
        new()
        {
            Label = "Send to",
            Children =
            [
                new() { Label = "Email" },
                new() { Label = "Message" },
                new()
                {
                    Label = "Team",
                    Children = [new() { Label = "Design" }, new() { Label = "Engineering" }],
                },
            ],
        },
        new() { Label = "Export", Disabled = true, Children = [new() { Label = "PDF" }] },
        LxMenuItem.Separator(),
        new() { Label = "Delete", Color = LxColor.Error },
    ];
}
