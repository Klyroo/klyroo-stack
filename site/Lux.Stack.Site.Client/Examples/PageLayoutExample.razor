@* The side columns show from the lg breakpoint. In a real layout the asides sit at the top level of the page. *@
<div class="w-full overflow-hidden rounded-lg border border-(--lux-border) bg-(--lux-bg) px-6">
    <LxPage>
        <Left>
            <LxPageAside As="div" Class="static">
                <LxPageLinks Title="Guides" Links="_guides" />
            </LxPageAside>
        </Left>
        <ChildContent>
            <LxPageHeader Headline="Guides" Title="Deploying to production" HeadingLevel="3"
                          Description="Ship your Blazor app with a release build, a health check and a rollback plan." />
            <LxPageBody Class="mt-6 pb-8">
                <p>Publish in Release mode, then run the container behind a reverse proxy that terminates TLS.</p>
            </LxPageBody>
        </ChildContent>
        <Right>
            <LxPageAside As="div" Class="static">
                <LxPageAnchors Links="_anchors" />
            </LxPageAside>
        </Right>
    </LxPage>
</div>

@code {
    private readonly PageLinkItem[] _guides =
    [
        new("Getting started", "/docs/installation") { Active = false },
        new("Deploying to production", "/docs/render-modes") { Active = true },
        new("Theming", "/docs/theming") { Active = false },
    ];

    private readonly PageLinkItem[] _anchors =
    [
        new("Build", "#build"),
        new("Health checks", "#health"),
        new("Rollbacks", "#rollbacks"),
    ];
}
