@* A first page of 300 rows is more than the prerender hands over (16 KB, PersistMaxBytes): the result is not persisted, a warning names the list, and the interactive render loads it once.
   The circuit starts all the same, which a persisted result of this size would have prevented (SignalR refuses a message past 32 KB). *@
<div class="w-full" data-testid="list-large">
    <LxDataList TItem="Invoice" Label="Invoices, a large page" Schema="InvoiceLargeData.Schema" Items="InvoiceLargeData.All" UrlKey="big" ResultJson="DemoJson.Default.DataListResultInvoice">
        <LxDataListResultCount />
        <LxDataListTable Caption="Invoices, a large page">
            <LxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <LxDataListColumn Field="customer" />
            <LxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </LxDataListTable>
    </LxDataList>
</div>
