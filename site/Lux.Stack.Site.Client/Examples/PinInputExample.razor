<div class="flex flex-col items-start gap-4">
    <LxFormField Label="Verification code" Help="Paste a code into any box to fill them all.">
        <LxPinInput Length="6" @bind-Value="_code" />
    </LxFormField>
    <LxFormField Label="Secret PIN">
        <LxPinInput Length="4" Mask Type="PinInputType.Alphanumeric" Size="LxSize.Lg" />
    </LxFormField>
    <p class="text-sm text-(--lux-text-muted)" data-testid="pin-state">Code: @(string.IsNullOrEmpty(_code) ? "none" : _code)</p>
</div>

@code {
    private string? _code;
}
