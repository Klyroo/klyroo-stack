@using Lux.UI.Theming
@* In a real app this wraps @Body in MainLayout.razor and replaces <LxToaster />:
   <LxApp Lang="en" Overrides="_overrides">@Body</LxApp>
   The site's layout already has a toaster, so this one turns it off. *@
<LxApp Toaster="false" Lang="en" Dir="ltr" Overrides="_overrides" Class="flex flex-wrap items-center gap-3" data-testid="app">
    <LxButton Label="Save" />
    <LxButton Label="Cancel" Variant="ButtonVariant.Outline" Color="LxColor.Neutral" />
    <LxBadge Label="Every button is rounded" Variant="LxVariant.Subtle" />
</LxApp>

@code {
    private readonly Dictionary<Type, ISlotOverrides> _overrides = new()
    {
        [typeof(LxButton)] = new ButtonUi { Base = "rounded-full" },
    };
}
