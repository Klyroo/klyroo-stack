<div class="flex flex-col items-start gap-4">
    <LxFormField Label="Your rating">
        <LxInputRating @bind-Value="_rating" />
    </LxFormField>
    <LxFormField Label="With halves">
        <LxInputRating AllowHalf Value="3.5" Color="LxColor.Warning" />
    </LxFormField>
    <LxInputRating ReadOnly Value="4" AriaLabel="Average rating" Size="LxSize.Sm" />
    <p class="text-sm text-(--lux-text-muted)" data-testid="rating-state">Rating: @_rating</p>
</div>

@code {
    private double _rating = 2;
}
