<div class="flex w-full max-w-xs flex-col gap-3">
    <LxFormField Label="Mailbox">
        <LxSelect @bind-Value="_mailbox" Items="Mailboxes" Placeholder="Choose a mailbox" data-testid="mailbox" />
    </LxFormField>
    <p class="text-sm text-(--lux-text-muted)" data-testid="mailbox-state">Selected: @(_mailbox ?? "none")</p>
</div>

@code {
    private string? _mailbox;

    // Items with the same Group are listed under one heading, where the first of them is. The count is shown at the end of the row.
    private static readonly LxSelectItem[] Mailboxes =
    [
        new("all", "All mail") { Icon = "mail", Count = 1204 },
        new("inbox", "Inbox") { Icon = "inbox", Count = 12, Group = "Mailboxes" },
        new("starred", "Starred") { Icon = "star", Count = 3, Group = "Mailboxes" },
        new("sent", "Sent") { Icon = "bookmark", Group = "Mailboxes" },
        new("archive", "Archive") { Icon = "folder", Count = 1840, Group = "Folders" },
        new("projects", "Projects") { Icon = "folder-open", Count = 57, Group = "Folders" },
        new("trash", "Trash") { Group = "Folders", Disabled = true },
    ];
}
