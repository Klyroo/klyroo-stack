<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lux.Stack.Site.Client</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Lux.UI" />
    <Using Include="Lux.Query" />
    <Using Include="Lux.Table" />
    <Using Include="Lux.Form" />
    <Using Include="Lux.Dashboard" />
    <Using Include="Lux.Display" />
    <Using Include="Lux.Spreadsheet" />
    <Using Include="Lux.Agent" />
    <Using Include="Lux.Stack" />
  </ItemGroup>

  <!-- Example sources, shown next to their live preview. -->
  <ItemGroup>
    <EmbeddedResource Include="Examples\**\*.razor" LogicalName="example:%(Filename)" />
  </ItemGroup>

  <!-- Parameter descriptions for the API tables, from each library's XML documentation. -->
  <Target Name="EmbedLuxDocumentation" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResourceNames">
    <ItemGroup>
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-ui/src/Lux.UI/bin/$(Configuration)/net10.0/Lux.UI.xml" LogicalName="Lux.UI.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-ui/src/Lux.UI/bin/$(Configuration)/net10.0/Lux.UI.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-query/src/Lux.Query.Core/bin/$(Configuration)/net10.0/Lux.Query.Core.xml" LogicalName="Lux.Query.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-query/src/Lux.Query.Core/bin/$(Configuration)/net10.0/Lux.Query.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-query/src/Lux.Query/bin/$(Configuration)/net10.0/Lux.Query.xml" LogicalName="Lux.Query.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-query/src/Lux.Query/bin/$(Configuration)/net10.0/Lux.Query.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-table/src/Lux.Table.Core/bin/$(Configuration)/net10.0/Lux.Table.Core.xml" LogicalName="Lux.Table.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-table/src/Lux.Table.Core/bin/$(Configuration)/net10.0/Lux.Table.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-table/src/Lux.Table/bin/$(Configuration)/net10.0/Lux.Table.xml" LogicalName="Lux.Table.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-table/src/Lux.Table/bin/$(Configuration)/net10.0/Lux.Table.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-form/src/Lux.Form.Core/bin/$(Configuration)/net10.0/Lux.Form.Core.xml" LogicalName="Lux.Form.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-form/src/Lux.Form.Core/bin/$(Configuration)/net10.0/Lux.Form.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-form/src/Lux.Form/bin/$(Configuration)/net10.0/Lux.Form.xml" LogicalName="Lux.Form.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-form/src/Lux.Form/bin/$(Configuration)/net10.0/Lux.Form.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-dashboard/src/Lux.Dashboard.Core/bin/$(Configuration)/net10.0/Lux.Dashboard.Core.xml" LogicalName="Lux.Dashboard.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-dashboard/src/Lux.Dashboard.Core/bin/$(Configuration)/net10.0/Lux.Dashboard.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-dashboard/src/Lux.Dashboard/bin/$(Configuration)/net10.0/Lux.Dashboard.xml" LogicalName="Lux.Dashboard.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-dashboard/src/Lux.Dashboard/bin/$(Configuration)/net10.0/Lux.Dashboard.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-display/src/Lux.Display.Core/bin/$(Configuration)/net10.0/Lux.Display.Core.xml" LogicalName="Lux.Display.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-display/src/Lux.Display.Core/bin/$(Configuration)/net10.0/Lux.Display.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-display/src/Lux.Display/bin/$(Configuration)/net10.0/Lux.Display.xml" LogicalName="Lux.Display.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-display/src/Lux.Display/bin/$(Configuration)/net10.0/Lux.Display.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-spreadsheet/src/Lux.Spreadsheet.Core/bin/$(Configuration)/net10.0/Lux.Spreadsheet.Core.xml" LogicalName="Lux.Spreadsheet.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-spreadsheet/src/Lux.Spreadsheet.Core/bin/$(Configuration)/net10.0/Lux.Spreadsheet.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-spreadsheet/src/Lux.Spreadsheet/bin/$(Configuration)/net10.0/Lux.Spreadsheet.xml" LogicalName="Lux.Spreadsheet.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-spreadsheet/src/Lux.Spreadsheet/bin/$(Configuration)/net10.0/Lux.Spreadsheet.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-agent/src/Lux.Agent.Core/bin/$(Configuration)/net10.0/Lux.Agent.Core.xml" LogicalName="Lux.Agent.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-agent/src/Lux.Agent.Core/bin/$(Configuration)/net10.0/Lux.Agent.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../lux-agent/src/Lux.Agent/bin/$(Configuration)/net10.0/Lux.Agent.xml" LogicalName="Lux.Agent.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../lux-agent/src/Lux.Agent/bin/$(Configuration)/net10.0/Lux.Agent.xml')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <!-- Unified LuxStack meta-package referencing lux-ui and all 7 lux-* repos directly -->
    <ProjectReference Include="..\..\src\Lux.Stack\Lux.Stack.csproj" />
    <ProjectReference Include="..\..\..\lux-ui\src\Lux.UI.Images\Lux.UI.Images.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\lux-ui\src\Lux.UI.Build.Tasks\Lux.UI.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <LuxBuildTasksAssembly>$(MSBuildThisFileDirectory)..\..\..\lux-ui\src\Lux.UI.Build.Tasks\bin\$(Configuration)\netstandard2.0\Lux.UI.Build.Tasks.dll</LuxBuildTasksAssembly>
  </PropertyGroup>
  <Import Project="..\..\..\lux-ui\src\Lux.UI\buildTransitive\Lux.UI.Tasks.targets" />
  <Import Project="..\..\..\lux-ui\src\Lux.UI\buildTransitive\Lux.UI.Icons.targets" />

  <ItemGroup>
    <LuxIconCollection Include="Assets\icons" Prefix="custom" />
    <LuxIcon Include="ph:cube;ph:cube-fill;ph:cube-bold" />
  </ItemGroup>

</Project>
