@inherits LayoutComponentBase
@implements IDisposable
@using Lux.Stack.Site.Client.Docs
@inject NavigationManager Navigation

<LxSkipLink />

<header class="sticky top-0 z-40 bg-(--lux-bg)/95 backdrop-blur">
    <div class="border-b border-(--lux-border)">
        <div class="mx-auto flex h-16 max-w-(--breakpoint-2xl) items-center gap-4 px-4 sm:px-6 lg:px-8">
            <a href="/" class="flex shrink-0 items-center gap-2.5 font-mono text-[15px] font-semibold text-(--lux-text-highlighted)">
                <Logo Class="size-7" />
                <span>lux<span class="text-(--lux-text-dimmed)">/</span>stack</span>
            </a>
            @if (_activeProduct is not null)
            {
                <span class="hidden text-(--lux-border-accented) sm:inline" aria-hidden="true">/</span>
                <a href="@($"/{_activeProduct.Slug}")" class="hidden items-center gap-1.5 font-mono text-sm font-semibold text-(--lux-text-highlighted) sm:inline-flex">
                    <span class="size-2 rounded-full" style="@($"background:{_activeProduct.AccentHex}")" aria-hidden="true"></span>
                    <span>@_activeProduct.Name</span>
                </a>
            }
            else
            {
                <span class="hidden rounded-md border border-(--lux-border) px-1.5 py-0.5 font-mono text-[11px] text-(--lux-text-muted) sm:inline">v0.1.0-preview.1</span>
            }

            <nav aria-label="Main" class="ms-6 hidden items-center gap-6 text-sm md:flex">
                @if (_activeProduct is null)
                {
                    <a href="/#libraries" class="@NavClass("/")">Libraries</a>
                    <a href="/showcase" aria-current="@(_currentPath == "/showcase" ? "page" : null)" class="@NavClass("/showcase")">Showcase</a>
                    <a href="/why" aria-current="@(_currentPath == "/why" ? "page" : null)" class="@NavClass("/why")">Why LuxStack?</a>
                    <a href="/#redirections" class="inline-flex min-h-7 items-center text-(--lux-text-muted) transition-colors hover:text-(--lux-text-highlighted)">Catalog</a>
                }
                else if (_activeProduct.Slug == "ui")
                {
                    <a href="/ui" aria-current="@(_currentPath == "/ui" ? "page" : null)" class="@NavClass("/ui")">Overview</a>
                    <a href="/ui/docs" aria-current="@(_currentPath.StartsWith("/ui/docs", StringComparison.OrdinalIgnoreCase) ? "page" : null)" class="@NavClass("/ui/docs")">Docs</a>
                    <a href="@($"{_prefix}/components/button")" class="inline-flex min-h-7 items-center text-(--lux-text-muted) transition-colors hover:text-(--lux-text-highlighted)">Components</a>
                    <a href="/docs/theming" aria-current="@(_currentPath == "/docs/theming" ? "page" : null)" class="@NavClass("/docs/theming")">Theming</a>
                    <a href="templates" aria-current="@(_currentPath == "/templates" ? "page" : null)" class="@NavClass("/templates")">Templates</a>
                }
                else
                {
                    <a href="@($"/{_activeProduct.Slug}")" aria-current="@(_currentPath == $"/{_activeProduct.Slug}" ? "page" : null)" class="@NavClass($"/{_activeProduct.Slug}")">Overview</a>
                    <a href="@($"/{_activeProduct.Slug}/docs")" aria-current="@(_currentPath == $"/{_activeProduct.Slug}/docs" ? "page" : null)" class="@NavClass($"/{_activeProduct.Slug}/docs")">Docs</a>
                    <a href="@($"/{_activeProduct.Slug}/docs/examples")" aria-current="@(_currentPath == $"/{_activeProduct.Slug}/docs/examples" ? "page" : null)" class="@NavClass($"/{_activeProduct.Slug}/docs/examples")">Examples</a>
                    <a href="@($"/{_activeProduct.Slug}/docs/api")" aria-current="@(_currentPath == $"/{_activeProduct.Slug}/docs/api" ? "page" : null)" class="@NavClass($"/{_activeProduct.Slug}/docs/api")">API</a>
                }
            </nav>

            <div class="ms-auto flex items-center gap-1">
                <LxContentSearchButton Collapsed="false" Class="me-1 min-w-0 sm:w-56" />
                <ColorModeButton />
            </div>
        </div>

        @* Compact mobile navigation so Showcase, Why LuxStack? & active library routes stay one tap away on phones *@
        <nav aria-label="Mobile" class="flex items-center gap-4 overflow-x-auto border-t border-(--lux-border) px-4 py-1.5 text-xs md:hidden">
            @if (_activeProduct is null)
            {
                <a href="/#libraries" class="inline-flex min-h-7 shrink-0 items-center text-(--lux-text-muted) hover:text-(--lux-text-highlighted)">Libraries</a>
                <a href="/showcase" aria-current="@(_currentPath == "/showcase" ? "page" : null)" class="@($"shrink-0 {NavClass("/showcase")}")">Showcase</a>
                <a href="/why" aria-current="@(_currentPath == "/why" ? "page" : null)" class="@($"shrink-0 {NavClass("/why")}")">Why LuxStack?</a>
                <a href="/#redirections" class="inline-flex min-h-7 shrink-0 items-center text-(--lux-text-muted) hover:text-(--lux-text-highlighted)">Catalog</a>
            }
            else if (_activeProduct.Slug == "ui")
            {
                <a href="/ui" class="@($"shrink-0 {NavClass("/ui")}")">Overview</a>
                <a href="/ui/docs" class="@($"shrink-0 {NavClass("/ui/docs")}")">Docs</a>
                <a href="@($"{_prefix}/components/button")" class="inline-flex min-h-7 shrink-0 items-center text-(--lux-text-muted) hover:text-(--lux-text-highlighted)">Components</a>
                <a href="templates" class="@($"shrink-0 {NavClass("/templates")}")">Templates</a>
            }
            else
            {
                <a href="@($"/{_activeProduct.Slug}")" class="@($"shrink-0 {NavClass($"/{_activeProduct.Slug}")}")">Overview</a>
                <a href="@($"/{_activeProduct.Slug}/docs")" class="@($"shrink-0 {NavClass($"/{_activeProduct.Slug}/docs")}")">Docs</a>
                <a href="@($"/{_activeProduct.Slug}/docs/examples")" class="@($"shrink-0 {NavClass($"/{_activeProduct.Slug}/docs/examples")}")">Examples</a>
                <a href="@($"/{_activeProduct.Slug}/docs/api")" class="@($"shrink-0 {NavClass($"/{_activeProduct.Slug}/docs/api")}")">API</a>
            }
        </nav>
    </div>
    <LuxStackBar />
</header>

@* Search is scoped strictly to the active library when browsing a library, or global on the LuxStack Hub. *@
<LxContentSearch @key="@(_activeProduct?.Slug ?? "hub")" Pages="Lux.Stack.Site.Client.Docs.DocsNavigation.SearchPages(_prefix, _activeProduct?.Slug)" />

<main id="main">
    @Body
</main>

<footer class="border-t border-(--lux-border)">
    <div class="mx-auto flex max-w-(--breakpoint-2xl) flex-col gap-2 px-4 py-8 text-sm text-(--lux-text-muted) sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-wide">@(_activeProduct is null ? "LuxStack · 8 Headless & UI Libraries · MIT" : $"{_activeProduct.Name} · LuxStack · MIT")</p>
        <p>Built for .NET 10, Blazor Web, .NET MAUI Blazor Hybrid &amp; NativeAOT.</p>
    </div>
</footer>

<LxToaster />
<LxFormProvider />
<LxFilePreviewProvider />

<div id="blazor-error-ui" data-nosnippet role="alert" class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-(--lux-border) bg-(--lux-bg-inverted) px-4 py-3 text-sm text-(--lux-text-inverted)">
    <div class="mx-auto flex max-w-(--breakpoint-2xl) items-center justify-between gap-4">
        <span>
            An unhandled error has occurred.
            <a href="." class="reload ms-2 font-medium underline">Reload</a>
        </span>
        <button type="button" class="dismiss inline-flex size-7 items-center justify-center rounded-md hover:opacity-80" aria-label="Dismiss error">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
    </div>
</div>

@code {
    private string _prefix = "";
    private string _currentPath = "/";
    private LuxProductInfo? _activeProduct;

    protected override void OnInitialized()
    {
        UpdateContext();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateContext();
        StateHasChanged();
    }

    private void UpdateContext()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        _currentPath = path;
        var mode = PlaygroundServices.ModeFromPath(path);
        _prefix = mode is null ? "" : "/" + mode;
        _activeProduct = LuxStackProducts.ResolveFromPath(path);
    }

    private string NavClass(string href) =>
        string.Equals(_currentPath, href, StringComparison.OrdinalIgnoreCase)
            ? "inline-flex min-h-7 items-center font-medium text-(--lux-text-highlighted)"
            : "inline-flex min-h-7 items-center text-(--lux-text-muted) transition-colors hover:text-(--lux-text-highlighted)";

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
