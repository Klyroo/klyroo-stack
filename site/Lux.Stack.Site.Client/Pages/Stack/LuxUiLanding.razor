@page "/ui"
@page "/stack/ui"

<PageTitle>Lux.UI · Blazor &amp; .NET MAUI Hybrid components for every render mode</PageTitle>

@* Hero *@
<section class="relative isolate overflow-hidden border-b border-(--lux-border)">
    <div class="pg-dots absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]" aria-hidden="true"></div>
    <div class="pg-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <Rain />

    <div class="mx-auto grid max-w-(--breakpoint-2xl) gap-10 px-4 pt-16 pb-16 sm:px-6 sm:pt-24 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] lg:items-end lg:px-8 lg:pb-20">
        <div>
            <h1 class="text-5xl font-semibold leading-[0.98] tracking-[-0.03em] text-(--lux-text-highlighted) sm:text-7xl xl:text-[4.75rem]">
                Blazor components<br />
                <span class="pg-accent">for every render mode.</span>
            </h1>
            <p class="mt-6 font-mono text-xs text-(--lux-text-muted)">
                Lux.UI <span aria-hidden="true">·</span> Open Source <span aria-hidden="true">·</span> MIT
            </p>
        </div>
        <div class="lg:pb-2">
            <p class="text-lg leading-relaxed text-(--lux-text-muted) text-pretty">
                @Count accessible components for Server, WebAssembly, Auto and static pages, and in MAUI Blazor Hybrid apps
                (tested on Android phones and TV so far). Menus, dialogs and tabs answer in the browser; .NET only hears what you bind.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
                <LxButton Label="Read Lux.UI docs" Href="/ui/docs" Size="LxSize.Xl" Class="rounded-lg px-5">
                    <TrailingIcon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
                </LxButton>
                <button type="button" data-copy-text="dotnet add package Lux.UI --prerelease"
                        class="group inline-flex items-center gap-3 rounded-lg border border-(--lux-border-accented) bg-(--lux-bg) px-4 py-2.5 font-mono text-sm text-(--lux-text-highlighted) hover:border-(--lux-primary-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--lux-primary-text)">
                    <span><span class="text-(--lux-text-muted)">$</span> dotnet add package Lux.UI</span>
                    <span class="text-[11px] uppercase tracking-wider text-(--lux-text-muted) group-hover:text-(--lux-primary-text)" data-copy-label>Copy</span>
                </button>
            </div>
        </div>
    </div>

    @* The live showcase sits in the hero, like a product shot that works. *@
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 pb-20 sm:px-6 lg:px-8">
        <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
            <p class="pg-eyebrow-mono flex items-center gap-2"><span class="size-1.5 animate-pulse bg-(--lux-primary)" aria-hidden="true"></span>Live · pick a component, then use it</p>
            <RendererBadge />
        </div>
        <Showcase />
    </div>
</section>

@* Platforms *@
<section aria-labelledby="platforms" class="border-b border-(--lux-border)">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <h2 id="platforms" class="text-4xl font-semibold leading-none tracking-[-0.045em] text-(--lux-text-highlighted) sm:text-6xl">
                One codebase:<br /><span class="pg-accent">web, phone, TV.</span>
            </h2>
            <p class="text-lg text-(--lux-text-muted) lg:max-w-xl lg:justify-self-end">
                The same components run in a browser and inside a MAUI Blazor Hybrid app (a <code class="font-mono text-base">BlazorWebView</code>).
                The two screens below are the sample app in the Android emulator, not mockups.
            </p>
        </div>

        <div class="mt-14 flex flex-wrap items-end justify-center gap-x-14 gap-y-10 rounded-2xl border border-(--lux-border) bg-(--lux-bg-muted)/60 p-6 sm:p-10">
            <figure class="w-56 max-w-full lg:w-64">
                <div class="rounded-[2rem] border-[5px] border-(--lux-border-accented) bg-black p-1">
                    <LxImage Src="img/platform-phone-home-dark.webp" Provider="none" Alt="The home page of the sample app on an Android phone, dark mode: a card reports the WebView renderer, the Phone form factor and Android 16." Width="540" Height="1200" Loading="LxImageLoading.Lazy" Class="block h-auto w-full rounded-[1.6rem]" data-testid="platform-phone" />
                </div>
                <figcaption class="mt-4 text-center font-mono text-xs uppercase tracking-[0.2em] text-(--lux-text-muted)">Android phone, touch</figcaption>
            </figure>
            <figure class="w-full min-w-0 max-w-3xl flex-1 basis-[28rem]">
                <div class="rounded-xl border-[6px] border-(--lux-border-accented) bg-black">
                    <LxImage Src="img/platform-tv-home-dark.webp" Provider="none" Alt="The home page of the sample app on Android TV, dark mode, with a thick focus ring on the menu button." Width="1280" Height="720" Loading="LxImageLoading.Lazy" Class="block h-auto w-full rounded-md" data-testid="platform-tv" />
                </div>
                <div class="mx-auto h-3 w-1/4 rounded-b-md bg-(--lux-border-accented)" aria-hidden="true"></div>
                <figcaption class="mt-4 text-center font-mono text-xs uppercase tracking-[0.2em] text-(--lux-text-muted)">Android TV, D-pad focus ring</figcaption>
            </figure>
        </div>

        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Platform support">
            @foreach (var (name, detail, status, color) in Platforms)
            {
                <li class="flex flex-col rounded-xl border border-(--lux-border) bg-(--lux-bg) p-4">
                    <div class="flex items-start justify-between gap-3">
                        <p class="font-medium text-(--lux-text-highlighted)">@name</p>
                        <LxBadge Label="@status" Color="color" Variant="LxVariant.Subtle" Size="LxSize.Sm" />
                    </div>
                    <p class="mt-2 text-sm text-(--lux-text-muted)">@detail</p>
                </li>
            }
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <LxButton Label="Read the MAUI guide" Href="/docs/maui" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" Class="rounded-lg">
                <TrailingIcon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
            </LxButton>
            <p class="text-sm text-(--lux-text-muted)">44 px touch hit areas on controls, safe areas, and an experimental TV mode.</p>
        </div>
    </div>
</section>

@* Components grid *@
<section aria-labelledby="components" class="border-b border-(--lux-border)">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <h2 id="components" class="text-4xl font-semibold leading-none tracking-[-0.045em] text-(--lux-text-highlighted) sm:text-6xl">
                @Count components,<br /><span class="pg-accent">one stylesheet.</span>
            </h2>
            <p class="text-lg text-(--lux-text-muted) lg:max-w-xl lg:justify-self-end">
                Every card below is the real component, running in this page. Same markup on the server and in the browser,
                themed with a handful of CSS variables.
            </p>
        </div>

        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <Tile Title="Button" Text="Seven colors, six variants, loading and link states." Href="/components/button">
                <div class="flex flex-wrap justify-center gap-2">
                    <LxButton Label="Deploy" Size="LxSize.Sm" />
                    <LxButton Label="Cancel" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" />
                    <LxButton Label="Saving" Size="LxSize.Sm" Loading Color="LxColor.Neutral" Variant="ButtonVariant.Soft" />
                </div>
            </Tile>
            <Tile Title="Select" Text="Keyboard, typeahead, and a hidden input that posts in plain forms." Href="/components/select">
                <div class="w-48"><LxSelect Items="Regions" Value="@("eu")" aria-label="Region" /></div>
            </Tile>
            <Tile Title="Modal" Text="The native dialog: inert page, focus kept inside, Escape." Href="/components/modal">
                <LxModal Title="Invite people" Description="They get an email with a link." Size="LxSize.Sm">
                    <ChildContent><LxButton Label="Open dialog" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Subtle" /></ChildContent>
                    <Body><LxFormField Label="Email"><LxInput Type="email" Placeholder="ada@example.com" /></LxFormField></Body>
                    <Footer><LxButton Label="Send invite" data-lx-close /></Footer>
                </LxModal>
            </Tile>
            <Tile Title="Toast" Text="Raised from .NET, shown and timed by the browser." Href="/components/toast">
                <ToastTrigger />
            </Tile>
            <Tile Title="Form controls" Text="Switch, checkbox and radio on native inputs, right even without scripts." Href="/components/form-field">
                <div class="flex flex-col gap-2.5">
                    <LxSwitch Value="true" Label="Auto deploy" Size="LxSize.Sm" />
                    <LxCheckbox Value="true" Label="Run tests" Size="LxSize.Sm" />
                </div>
            </Tile>
            <Tile Title="Tabs" Text="Arrow keys and automatic activation, no round trip." Href="/components/tabs">
                <div class="w-56"><LxTabs AriaLabel="Environment" Items="Environments" /></div>
            </Tile>
            <Tile Title="Avatar & Badge" Text="Initials when the picture is missing, status at a glance." Href="/components/avatar">
                <div class="flex items-center gap-3">
                    <div class="flex -space-x-2">
                        <LxAvatar Alt="Ada Lovelace" Class="ring-2 ring-(--lux-bg)" />
                        <LxAvatar Alt="Grace Hopper" Class="ring-2 ring-(--lux-bg)" />
                        <LxAvatar Alt="Alan Turing" Class="ring-2 ring-(--lux-bg)" />
                    </div>
                    <LxBadge Label="online" Color="LxColor.Success" Variant="LxVariant.Subtle" Size="LxSize.Sm" />
                </div>
            </Tile>
            <Tile Title="Tooltip" Text="Hover after a delay, focus at once, Escape to dismiss." Href="/components/tooltip">
                <LxTooltip Text="Copied to clipboard">
                    <LxButton Label="Hover or focus me" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" />
                </LxTooltip>
            </Tile>
        </div>
    </div>
</section>

@* Pipeline *@
<section aria-labelledby="pipeline" class="relative isolate overflow-hidden border-b border-(--lux-border)">
    <div class="pg-glow absolute inset-0 -z-10 rotate-180" aria-hidden="true"></div>
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <h2 id="pipeline" class="text-4xl font-semibold leading-none tracking-[-0.045em] text-(--lux-text-highlighted) sm:text-6xl">
                What happens<br />on a <span class="pg-accent">click</span>
            </h2>
            <p class="text-lg text-(--lux-text-muted) lg:max-w-xl lg:justify-self-end">
                Opening a popover in Server mode usually means a SignalR round trip. Here it is five steps,
                and four of them never leave the browser.
            </p>
        </div>

        <div class="mt-14 rounded-2xl border border-(--lux-border) bg-(--lux-bg-muted)/60 p-4 sm:p-6">
            <div class="mb-6 flex items-center justify-between gap-4 font-mono text-xs">
                <span class="rounded-full border border-(--lux-primary-text) px-3 py-1 uppercase tracking-[0.2em] text-(--lux-primary-text)">click</span>
                <span class="rounded-full border border-(--lux-border-accented) px-3 py-1 uppercase tracking-[0.2em] text-(--lux-text-muted)">.NET, if bound</span>
            </div>
            <div class="relative mb-6 hidden h-3 lg:block" aria-hidden="true">
                <div class="absolute inset-x-0 top-1/2 border-t border-dashed border-(--lux-border-accented)"></div>
                <div class="pg-beam"></div>
            </div>
            <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
                @foreach (var (step, title, text, snippet) in Steps)
                {
                    <li class="flex flex-col rounded-xl border border-(--lux-border) bg-(--lux-bg) p-4">
                        <p class="font-mono text-xs text-(--lux-primary-text)">@step</p>
                        <p class="mt-1 font-medium text-(--lux-text-highlighted)">@title</p>
                        <p class="mt-2 flex-1 text-sm text-(--lux-text-muted)">@text</p>
                        <code class="mt-4 block truncate rounded-md border border-(--lux-border) bg-(--lux-bg-muted) px-2 py-1 font-mono text-[11px] text-(--lux-text)">@snippet</code>
                    </li>
                }
            </ol>
        </div>
    </div>
</section>

@* Closing call to action *@
<section aria-labelledby="start" class="relative isolate overflow-hidden">
    <div class="pg-dots absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]" aria-hidden="true"></div>
    <div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:py-32">
        <p class="pg-eyebrow-mono"><span class="font-pixel text-2xl font-black text-(--lux-primary-text)">@Count</span> components · <span class="font-pixel text-2xl font-black text-(--lux-primary-text)">4</span> render modes · web and MAUI Blazor Hybrid</p>
        <h2 id="start" class="mt-6 text-4xl font-semibold leading-none tracking-[-0.045em] text-(--lux-text-highlighted) sm:text-6xl">
            Start with Lux.UI.
        </h2>
        <div class="mx-auto mt-10 max-w-lg text-start">
            <CodeBlock Code="dotnet add package Lux.UI --prerelease" Class="rounded-xl border border-(--lux-border)" />
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <LxButton Label="Read the docs" Href="/ui/docs" Size="LxSize.Lg" Class="rounded-lg" />
            <LxButton Label="Browse components" Href="/components/button" Size="LxSize.Lg" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" Class="rounded-lg" />
            <LxButton Label="All LuxStack libraries" Href="/" Size="LxSize.Lg" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" Class="rounded-lg" />
        </div>
    </div>
</section>

@code {
    private static int Count => Lux.Stack.Site.Client.Docs.Catalog.Components.Length;

    private static readonly LxSelectItem[] Regions = [new("eu", "Europe (Paris)"), new("us", "US East"), new("ap", "Asia (Tokyo)")];

    private static readonly LxTabItem[] Environments =
    [
        new("Preview") { Content = @<p class="pt-3 text-xs text-(--lux-text-muted)">3 deployments today</p> },
        new("Production") { Content = @<p class="pt-3 text-xs text-(--lux-text-muted)">Last deploy 2 h ago</p> },
    ];

    private static readonly (string Name, string Detail, string Status, LxColor Color)[] Platforms =
    [
        ("Web", "Static SSR, Server, WebAssembly and Auto, with the same markup.", "Tested", LxColor.Success),
        ("Android", "Phone. Built and run in the emulator.", "Tested on emulator", LxColor.Success),
        ("Android TV", "D-pad navigation, editing mode for fields, Back closes overlays.", "Experimental", LxColor.Warning),
        ("iOS 17+", "Native popover support and 44px touch targets.", "Supported", LxColor.Info),
        ("Windows", "WinUI / WebView2 in .NET MAUI Blazor Hybrid.", "Supported", LxColor.Info),
        ("macOS", "Mac Catalyst in .NET MAUI Blazor Hybrid.", "Supported", LxColor.Info),
        ("Tizen", "Samsung TV has no BlazorWebView.", "Not supported", LxColor.Neutral),
    ];

    private static readonly (string Step, string Title, string Text, string Code)[] Steps =
    [
        ("01", "Click", "The trigger is a native popover invoker. No .NET handler is attached.", "popoverTargetElement"),
        ("02", "Custom element", "<lx-popover> positions the panel and moves focus inside.", "float(trigger, panel)"),
        ("03", "Top layer", "The browser handles Escape, light dismiss and stacking.", "showPopover()"),
        ("04", "One event", "The new state goes out once, with a sequence number.", "lx-toggle {open, seq}"),
        ("05", ".NET", "Only if you bound it. Late renders are recognised and ignored.", "@bind-Open"),
    ];
}
