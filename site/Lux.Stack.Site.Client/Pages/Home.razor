@page "/"
@page "/stack"
@using Lux.Stack.Site.Client.Docs

<PageTitle>LuxStack · High-quality open-source libraries for .NET, Blazor &amp; MAUI</PageTitle>

@* LuxStack Umbrella Hero *@
<section class="relative isolate overflow-hidden border-b border-(--lux-border)">
    <div class="pg-dots absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]" aria-hidden="true"></div>
    <div class="pg-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <Rain />

    <div class="mx-auto grid max-w-(--breakpoint-2xl) gap-10 px-4 pt-16 pb-16 sm:px-6 sm:pt-24 lg:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)] lg:items-end lg:px-8 lg:pb-20">
        <div>
            <p class="pg-eyebrow-mono">LuxStack <span aria-hidden="true">·</span> <span class="text-(--lux-primary-text)">8 headless + UI libraries</span> <span aria-hidden="true">·</span> .NET 10 &amp; MAUI <span aria-hidden="true">·</span> MIT</p>
            <h1 class="mt-5 text-5xl font-semibold leading-[0.95] tracking-[-0.055em] text-(--lux-text-highlighted) sm:text-7xl xl:text-[4.75rem]">
                High-quality open-source<br />
                <span class="pg-accent">libraries for .NET.</span>
            </h1>
        </div>
        <div class="lg:pb-2">
            <p class="text-lg leading-relaxed text-(--lux-text-muted) text-pretty">
                Headless, type-safe, NativeAOT-ready C# engines paired with zero-roundtrip Blazor Web &amp; .NET MAUI Blazor Hybrid UI.
                Adopt a single library or install the entire stack in one package.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
                <LxButton Label="Live 8-Library Showcase" Href="/showcase" Size="LxSize.Xl" Class="rounded-lg px-5">
                    <TrailingIcon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
                </LxButton>
                <LxButton Label="Why LuxStack?" Href="/why" Size="LxSize.Xl" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" Class="rounded-lg px-5" />
                <LxButton Label="Browse Libraries" Href="#libraries" Size="LxSize.Xl" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" Class="rounded-lg px-4" />
            </div>
            <div class="mt-4">
                <button type="button" data-copy-text="dotnet add package Lux.Stack"
                        class="group inline-flex w-full items-center justify-between gap-3 rounded-lg border border-(--lux-border-accented) bg-(--lux-bg) px-4 py-2.5 font-mono text-sm text-(--lux-text-highlighted) hover:border-(--lux-primary-text) sm:w-auto">
                    <span><span class="text-(--lux-text-muted)">$</span> dotnet add package Lux.Stack</span>
                    <span class="text-[11px] uppercase tracking-wider text-(--lux-text-muted) group-hover:text-(--lux-primary-text)" data-copy-label>Copy</span>
                </button>
            </div>
        </div>
    </div>
</section>

@* Open Source Libraries Grid (8-card showcase) *@
<section id="libraries" aria-labelledby="libraries-heading" class="scroll-mt-28 border-b border-(--lux-border)">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <h2 id="libraries-heading" class="text-4xl font-semibold leading-none tracking-[-0.045em] text-(--lux-text-highlighted) sm:text-6xl">
                Open Source<br /><span class="pg-accent">Libraries.</span>
            </h2>
            <p class="text-lg text-(--lux-text-muted) lg:max-w-xl lg:justify-self-end">
                Every library follows the same strict contract: <code class="font-mono text-sm text-(--lux-text-highlighted)">Lux.&lt;Product&gt;.Core</code>
                is 100% headless NativeAOT C#, and <code class="font-mono text-sm text-(--lux-text-highlighted)">Lux.&lt;Product&gt;</code> ships
                multiplatform Blazor Web &amp; .NET MAUI Hybrid components with dedicated documentation.
            </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
            @foreach (var product in LuxStackProducts.All)
            {
                <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-(--lux-border) bg-(--lux-bg) transition-all hover:border-(--lux-border-accented)"
                         style="@($"border-top: 3px solid {product.AccentHex}")">
                    <div class="flex flex-1 flex-col p-6">
                        <div class="flex items-center justify-between gap-2">
                            <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-(--lux-text-muted)">
                                <span class="size-2.5 rounded-full" style="@($"background:{product.AccentHex}")" aria-hidden="true"></span>
                                @product.RepoName
                            </span>
                            <LxBadge Label="Core + UI" Color="@product.BadgeColor" Variant="LxVariant.Subtle" Size="LxSize.Sm" />
                        </div>

                        <h3 class="mt-3 text-2xl font-semibold tracking-tight text-(--lux-text-highlighted)">
                            <a href="@($"/{product.Slug}")" class="hover:underline" style="@($"text-decoration-color:{product.AccentHex}")">
                                Lux.<span style="@($"color:{product.AccentHex}")">@product.ShortName</span>
                            </a>
                        </h3>

                        <p class="mt-1 font-mono text-xs text-(--lux-text-highlighted)">@product.Tagline</p>
                        <p class="mt-3 flex-1 text-sm leading-relaxed text-(--lux-text-muted)">@product.Description</p>

                        <div class="mt-5 rounded-xl border border-(--lux-border) bg-(--lux-bg-muted)/60 p-3 font-mono text-xs">
                            <div class="flex items-center justify-between gap-2 text-(--lux-text-muted)">
                                <span>Headless:</span>
                                <span class="truncate text-(--lux-text-highlighted)">@product.CorePackage</span>
                            </div>
                            <div class="mt-1 flex items-center justify-between gap-2 text-(--lux-text-muted)">
                                <span>Blazor/MAUI:</span>
                                <span class="truncate text-(--lux-text-highlighted)">@product.UiPackage</span>
                            </div>
                        </div>

                        <div class="mt-5 grid grid-cols-2 gap-2 pt-1">
                            <LxButton Label="Overview"
                                      Href="@($"/{product.Slug}")"
                                      Color="LxColor.Neutral"
                                      Variant="ButtonVariant.Outline"
                                      Size="LxSize.Sm"
                                      Class="justify-center rounded-lg" />
                            <LxButton Label="Docs →"
                                      Href="@product.DocsHref"
                                      Size="LxSize.Sm"
                                      Class="justify-center rounded-lg" />
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@* Architecture Pillars *@
<section aria-labelledby="pillars-heading" class="border-b border-(--lux-border)">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8">
        <p class="pg-eyebrow-mono">Built for Modern .NET Teams</p>
        <h2 id="pillars-heading" class="mt-2 text-3xl font-semibold tracking-tight text-(--lux-text-highlighted) sm:text-5xl">
            One architecture. Every target.
        </h2>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-(--lux-border) bg-(--lux-bg) p-6">
                <p class="font-mono text-xs uppercase tracking-widest text-(--lux-primary-text)">01 · Headless Core</p>
                <h3 class="mt-3 text-xl font-semibold text-(--lux-text-highlighted)">100% NativeAOT &amp; Zero UI Lock-In</h3>
                <p class="mt-2 text-sm leading-relaxed text-(--lux-text-muted)">
                    Every <code class="font-mono">Lux.&lt;Product&gt;.Core</code> package compiles cleanly with <code class="font-mono">IsAotCompatible=true</code>
                    and zero Razor dependencies — ready for Minimal APIs, workers, unit tests, and native C# .NET MAUI ViewModels.
                </p>
            </div>
            <div class="rounded-2xl border border-(--lux-border) bg-(--lux-bg) p-6">
                <p class="font-mono text-xs uppercase tracking-widest text-(--lux-primary-text)">02 · Multiplatform UI</p>
                <h3 class="mt-3 text-xl font-semibold text-(--lux-text-highlighted)">Blazor Web &amp; .NET MAUI Hybrid</h3>
                <p class="mt-2 text-sm leading-relaxed text-(--lux-text-muted)">
                    Static SSR, Interactive Server, WebAssembly, Auto, iOS, Android, macOS Catalyst, Windows, and Android TV —
                    with native browser popovers, 44px touch targets, and zero SignalR round-trip lag.
                </p>
            </div>
            <div class="rounded-2xl border border-(--lux-border) bg-(--lux-bg) p-6">
                <p class="font-mono text-xs uppercase tracking-widest text-(--lux-primary-text)">03 · AI-Native</p>
                <h3 class="mt-3 text-xl font-semibold text-(--lux-text-highlighted)">Semantic Agent Bridge &amp; WebMCP</h3>
                <p class="mt-2 text-sm leading-relaxed text-(--lux-text-muted)">
                    <code class="font-mono">Lux.Agent</code> exposes deterministic <code class="font-mono">snapshot</code>, <code class="font-mono">query</code>,
                    and <code class="font-mono">act</code> tools with automatic <code class="font-mono">[redacted]</code> secret masking and browser WebMCP registration.
                </p>
            </div>
        </div>
    </div>
</section>

@* Interactive Component & API Router *@
<section id="redirections" aria-labelledby="redirections-heading" class="scroll-mt-28">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <div>
                <p class="pg-eyebrow-mono">LuxStackCatalog.ResolveComponentModule</p>
                <h2 id="redirections-heading" class="mt-2 text-3xl font-semibold tracking-tight text-(--lux-text-highlighted) sm:text-5xl">
                    Find any component or API.
                </h2>
            </div>
            <div class="lg:max-w-md lg:justify-self-end">
                <LxInput @bind-Value="_filter"
                         Placeholder="Filter by component, controller or package (e.g. LxDataList, Form, Agent)..."
                         aria-label="Filter components" />
            </div>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-(--lux-border) bg-(--lux-bg)">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="border-b border-(--lux-border) bg-(--lux-bg-muted) font-mono text-xs uppercase text-(--lux-text-muted)">
                        <tr>
                            <th class="px-4 py-3">Component / Service</th>
                            <th class="px-4 py-3">Layer</th>
                            <th class="px-4 py-3">Library</th>
                            <th class="px-4 py-3">NuGet Package</th>
                            <th class="px-4 py-3">Documentation</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-(--lux-border)">
                        @foreach (var (product, comp) in FilteredComponents)
                        {
                            <tr class="hover:bg-(--lux-bg-muted)/40">
                                <td class="px-4 py-3 font-mono font-medium text-(--lux-text-highlighted)">
                                    <a href="@comp.Href" class="hover:underline">@comp.Name</a>
                                    <p class="mt-0.5 font-sans text-xs font-normal text-(--lux-text-muted)">@comp.Description</p>
                                </td>
                                <td class="px-4 py-3">
                                    <LxBadge Label="@comp.Layer"
                                             Color="@(comp.Layer == "Core" ? LxColor.Info : LxColor.Success)"
                                             Variant="LxVariant.Subtle"
                                             Size="LxSize.Sm" />
                                </td>
                                <td class="px-4 py-3 font-mono text-xs">
                                    <a href="@($"/{product.Slug}")" class="inline-flex items-center gap-2 font-semibold text-(--lux-text-highlighted) hover:underline">
                                        <span class="size-2 rounded-full" style="@($"background:{product.AccentHex}")"></span>
                                        @product.Name
                                    </a>
                                </td>
                                <td class="px-4 py-3 font-mono text-xs text-(--lux-text)">
                                    @(comp.Layer == "Core" ? product.CorePackage : product.UiPackage)
                                </td>
                                <td class="px-4 py-3 font-mono text-xs">
                                    <a href="@product.DocsHref" class="text-(--lux-primary-text) hover:underline">Read docs →</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@code {
    private string _filter = "";

    private IEnumerable<(LuxProductInfo Product, LuxProductComponentLink Component)> FilteredComponents =>
        from p in LuxStackProducts.All
        from c in p.Components
        where string.IsNullOrWhiteSpace(_filter)
              || c.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || c.Description.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || p.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || p.CorePackage.Contains(_filter, StringComparison.OrdinalIgnoreCase)
        select (p, c);
}
