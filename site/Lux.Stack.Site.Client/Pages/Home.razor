@page "/"
@page "/stack"
@using Lux.Stack.Site.Client.Docs
@using Lux.Stack.Site.Client.Components.Stages

<PageTitle>LuxStack · High-quality open-source libraries for .NET, Blazor &amp; MAUI</PageTitle>

@* LuxStack Hero + Drizzle-Resource Inspired Interactive Workbench *@
<section class="relative isolate overflow-hidden border-b border-(--lux-border)">
    <div class="pg-dots absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]" aria-hidden="true"></div>
    <div class="pg-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <Rain />

    <div class="mx-auto grid max-w-(--breakpoint-2xl) gap-8 px-4 pt-12 pb-10 sm:px-6 sm:pt-16 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:items-end lg:px-8">
        <div>
            <h1 class="text-5xl font-semibold leading-[0.98] tracking-[-0.03em] text-(--lux-text-highlighted) sm:text-6xl xl:text-[4.25rem]">
                High-quality open-source<br />
                <span class="pg-accent">libraries for .NET.</span>
            </h1>
            <p class="mt-4 font-mono text-xs text-(--lux-text-muted)">
                8 headless + UI libraries <span aria-hidden="true">·</span> .NET 10 &amp; MAUI <span aria-hidden="true">·</span> NativeAOT <span aria-hidden="true">·</span> MIT
            </p>
        </div>
        <div class="lg:pb-1">
            <p class="max-w-prose text-base leading-relaxed text-(--lux-text-muted) text-pretty sm:text-lg">
                Wire <code class="font-mono text-sm text-(--lux-text-highlighted)">AddLuxStack()</code> once or pick any single package.
                Select a library below to trace its NativeAOT core, C# code, runtimes, and live UI.
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-2.5">
                <LxButton Label="Live 8-Library Showcase" Href="/showcase" Size="LxSize.Lg" Class="rounded-lg px-5">
                    <TrailingIcon><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
                </LxButton>
                <button type="button" data-copy-text="dotnet add package Lux.Stack"
                        class="group inline-flex min-h-10 items-center justify-between gap-3 rounded-lg border border-(--lux-border-accented) bg-(--lux-bg) px-4 py-2 font-mono text-xs text-(--lux-text-highlighted) transition-colors hover:border-(--lux-primary-text)">
                    <span><span class="text-(--lux-text-muted)">$</span> dotnet add package Lux.Stack</span>
                    <span class="text-[11px] uppercase tracking-wider text-(--lux-text-muted) group-hover:text-(--lux-primary-text)" data-copy-label>Copy</span>
                </button>
                <LxButton Label="Why LuxStack?" Href="/why" Size="LxSize.Lg" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" Class="rounded-lg px-3" />
            </div>
        </div>
    </div>

    @* Interactive Workbench directly inside the Hero *@
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 pb-14 sm:px-6 lg:px-8 lg:pb-16">
        <h2 class="sr-only">Interactive LuxStack Workbench</h2>
        <StackHeroWorkbench />
    </div>
</section>

@* Measured Proof Strip (hairline editorial typography, zero card boxes) *@
<section aria-label="Measured performance and test coverage" class="border-b border-(--lux-border) bg-(--lux-bg-muted)/30">
    <dl class="mx-auto grid max-w-(--breakpoint-2xl) grid-cols-2 divide-y divide-(--lux-border) px-4 sm:px-6 lg:grid-cols-4 lg:divide-x lg:divide-y-0 lg:px-8">
        <div class="py-6 lg:pe-6">
            <dt class="font-mono text-xs text-(--lux-text-muted)">Lux.Query · 100k rows + 5 facets</dt>
            <dd class="mt-1 font-pixel text-3xl font-bold tabular-nums text-(--lux-text-highlighted)">16.6 ms</dd>
        </div>
        <div class="py-6 lg:px-6">
            <dt class="font-mono text-xs text-(--lux-text-muted)">Lux.Spreadsheet · 10k CSV rows</dt>
            <dd class="mt-1 font-pixel text-3xl font-bold tabular-nums text-(--lux-text-highlighted)">23.0 ms</dd>
        </div>
        <div class="py-6 lg:px-6">
            <dt class="font-mono text-xs text-(--lux-text-muted)">All 8 Headless Core DLLs</dt>
            <dd class="mt-1 font-pixel text-3xl font-bold tabular-nums text-(--lux-text-highlighted)">536 KB</dd>
        </div>
        <div class="py-6 lg:ps-6">
            <dt class="font-mono text-xs text-(--lux-text-muted)">Automated tests across 9 repos</dt>
            <dd class="mt-1 font-pixel text-3xl font-bold tabular-nums text-(--lux-text-highlighted)">4,853</dd>
        </div>
    </dl>
</section>

@* Open Source Libraries Grid (8-library catalog) *@
<section id="libraries" aria-labelledby="libraries-heading" class="scroll-mt-28 border-b border-(--lux-border)">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <h2 id="libraries-heading" class="text-4xl font-semibold leading-[1.02] tracking-[-0.03em] text-(--lux-text-highlighted) sm:text-6xl">
                Open Source<br /><span class="pg-accent">Libraries.</span>
            </h2>
            <p class="max-w-prose text-lg text-(--lux-text-muted) lg:justify-self-end">
                Every library follows the same strict contract: <code class="font-mono text-sm text-(--lux-text-highlighted)">Lux.&lt;Product&gt;.Core</code>
                is 100% headless NativeAOT C#, and <code class="font-mono text-sm text-(--lux-text-highlighted)">Lux.&lt;Product&gt;</code> ships
                multiplatform Blazor Web &amp; .NET MAUI Hybrid components with dedicated documentation.
            </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
            @foreach (var product in LuxStackProducts.All)
            {
                <article class="group flex flex-col rounded-2xl border border-(--lux-border) bg-(--lux-bg) p-6 transition-colors hover:border-(--lux-border-accented)">
                    <div class="flex items-center justify-between gap-2">
                        <span class="inline-flex items-center gap-2 font-mono text-xs text-(--lux-text-muted)">
                            <span class="size-2 rounded-full" style="@($"background:{product.AccentHex}")" aria-hidden="true"></span>
                            @product.RepoName
                        </span>
                        <LxBadge Label="Core + UI" Color="@product.BadgeColor" Variant="LxVariant.Subtle" Size="LxSize.Sm" />
                    </div>

                    <h3 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-(--lux-text-highlighted)">
                        <a href="@($"/{product.Slug}")" class="hover:underline" style="@($"text-decoration-color:{product.AccentHex}")">
                            Lux.@product.ShortName
                        </a>
                    </h3>

                    <p class="mt-1.5 text-xs font-medium text-(--lux-text-highlighted)">@product.Tagline</p>
                    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-(--lux-text-muted)">@product.Description</p>

                    <dl class="mt-5 space-y-1.5 border-t border-(--lux-border) pt-4 font-mono text-xs">
                        <div class="flex items-center justify-between gap-2">
                            <dt class="text-(--lux-text-muted)">Core</dt>
                            <dd class="truncate text-(--lux-text-highlighted)">@product.CorePackage</dd>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <dt class="text-(--lux-text-muted)">UI</dt>
                            <dd class="truncate text-(--lux-text-highlighted)">@product.UiPackage</dd>
                        </div>
                    </dl>

                    <div class="mt-5 grid grid-cols-2 gap-2">
                        <LxButton Label="Overview"
                                  Href="@($"/{product.Slug}")"
                                  Color="LxColor.Neutral"
                                  Variant="ButtonVariant.Outline"
                                  Size="LxSize.Sm"
                                  Class="justify-center rounded-lg" />
                        <LxButton Label="Docs"
                                  Href="@product.DocsHref"
                                  Size="LxSize.Sm"
                                  Class="justify-center rounded-lg">
                            <TrailingIcon><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
                        </LxButton>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@* Architecture Pillars *@
<section aria-labelledby="pillars-heading" class="border-b border-(--lux-border)">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8">
        <h2 id="pillars-heading" class="text-3xl font-semibold tracking-[-0.025em] text-(--lux-text-highlighted) sm:text-5xl">
            One architecture. Every target.
        </h2>

        <div class="mt-12 grid gap-8 md:grid-cols-3">
            <div class="border-t border-(--lux-border) pt-6">
                <h3 class="text-xl font-semibold tracking-[-0.015em] text-(--lux-text-highlighted)">100% NativeAOT &amp; Zero UI Lock-In</h3>
                <p class="mt-3 text-sm leading-relaxed text-(--lux-text-muted)">
                    Every <code class="font-mono text-(--lux-text-highlighted)">Lux.&lt;Product&gt;.Core</code> package compiles cleanly with <code class="font-mono text-(--lux-text-highlighted)">IsAotCompatible=true</code>
                    and zero Razor dependencies — ready for Minimal APIs, workers, unit tests, and native C# .NET MAUI ViewModels.
                </p>
            </div>
            <div class="border-t border-(--lux-border) pt-6">
                <h3 class="text-xl font-semibold tracking-[-0.015em] text-(--lux-text-highlighted)">Blazor Web &amp; .NET MAUI Hybrid</h3>
                <p class="mt-3 text-sm leading-relaxed text-(--lux-text-muted)">
                    Static SSR, Interactive Server, WebAssembly, Auto, iOS, Android, macOS Catalyst, Windows, and Android TV —
                    with native browser popovers, 44px touch targets, and zero SignalR round-trip lag.
                </p>
            </div>
            <div class="border-t border-(--lux-border) pt-6">
                <h3 class="text-xl font-semibold tracking-[-0.015em] text-(--lux-text-highlighted)">Semantic Agent Bridge &amp; WebMCP</h3>
                <p class="mt-3 text-sm leading-relaxed text-(--lux-text-muted)">
                    <code class="font-mono text-(--lux-text-highlighted)">Lux.Agent</code> exposes deterministic <code class="font-mono text-(--lux-text-highlighted)">snapshot</code>, <code class="font-mono text-(--lux-text-highlighted)">query</code>,
                    and <code class="font-mono text-(--lux-text-highlighted)">act</code> tools with automatic <code class="font-mono text-(--lux-text-highlighted)">[redacted]</code> secret masking and browser WebMCP registration.
                </p>
            </div>
        </div>
    </div>
</section>

@* Interactive Component & API Router *@
<section id="redirections" aria-labelledby="redirections-heading" class="scroll-mt-28">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <div>
                <h2 id="redirections-heading" class="text-3xl font-semibold tracking-[-0.025em] text-(--lux-text-highlighted) sm:text-5xl">
                    Find any component or API.
                </h2>
                <p class="mt-2 text-sm text-(--lux-text-muted)">
                    Indexed by <code class="font-mono text-(--lux-text-highlighted)">LuxStackCatalog.ResolveComponentModule</code> across all 8 repositories.
                </p>
            </div>
            <div class="w-full lg:max-w-md lg:justify-self-end">
                <LxInput @bind-Value="_filter"
                         Placeholder="Filter by component, controller, or package (e.g. LxDataList, Form, Agent)..."
                         aria-label="Filter components" />
            </div>
        </div>

        @{
            var rows = FilteredComponents.ToList();
            var limitApplied = string.IsNullOrWhiteSpace(_filter) && !_showAllComponents && rows.Count > DefaultCatalogLimit;
            var visibleRows = limitApplied ? rows.Take(DefaultCatalogLimit).ToList() : rows;
        }
        <div class="mt-10 overflow-hidden rounded-2xl border border-(--lux-border) bg-(--lux-bg)">
            @if (rows.Count == 0)
            {
                <div class="flex flex-col items-center justify-center gap-3 px-6 py-14 text-center">
                    <p class="text-base font-medium text-(--lux-text-highlighted)">No components match “@_filter”</p>
                    <p class="text-sm text-(--lux-text-muted)">Try searching for a package name like <code>Lux.Query</code>, a component like <code>LxDataList</code>, or clear the filter.</p>
                    <LxButton Label="Clear filter" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => _filter = "")" />
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="border-b border-(--lux-border) bg-(--lux-bg-muted) font-mono text-xs uppercase text-(--lux-text-muted)">
                            <tr>
                                <th scope="col" class="px-4 py-3">Component / Service</th>
                                <th scope="col" class="px-4 py-3">Layer</th>
                                <th scope="col" class="px-4 py-3">Library</th>
                                <th scope="col" class="px-4 py-3">NuGet Package</th>
                                <th scope="col" class="px-4 py-3">Documentation</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-(--lux-border)">
                            @foreach (var (product, comp) in visibleRows)
                            {
                                <tr class="transition-colors hover:bg-(--lux-bg-muted)/40">
                                    <td class="px-4 py-3 font-mono font-medium text-(--lux-text-highlighted)">
                                        <a href="@comp.Href" class="hover:underline">@comp.Name</a>
                                        <p class="mt-0.5 font-sans text-xs font-normal text-(--lux-text-muted)">@comp.Description</p>
                                    </td>
                                    <td class="px-4 py-3">
                                        <LxBadge Label="@comp.Layer"
                                                 Color="@(comp.Layer == "Core" ? LxColor.Info : LxColor.Success)"
                                                 Variant="LxVariant.Subtle"
                                                 Size="LxSize.Sm" />
                                    </td>
                                    <td class="px-4 py-3 font-mono text-xs">
                                        <a href="@($"/{product.Slug}")" class="inline-flex items-center gap-2 font-semibold text-(--lux-text-highlighted) hover:underline">
                                            <span class="size-2 rounded-full" style="@($"background:{product.AccentHex}")" aria-hidden="true"></span>
                                            @product.Name
                                        </a>
                                    </td>
                                    <td class="px-4 py-3 font-mono text-xs text-(--lux-text)">
                                        @(comp.Layer == "Core" ? product.CorePackage : product.UiPackage)
                                    </td>
                                    <td class="px-4 py-3 text-xs font-medium">
                                        <a href="@product.DocsHref" class="inline-flex items-center gap-1 text-(--lux-primary-text) hover:underline">
                                            <span>Read docs</span>
                                            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (limitApplied)
                {
                    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-(--lux-border) bg-(--lux-bg-muted)/40 px-4 py-3 text-xs text-(--lux-text-muted)">
                        <span class="font-mono tabular-nums">Showing @visibleRows.Count of @rows.Count components &amp; services</span>
                        <LxButton Label="@($"Show all {rows.Count}")" Size="LxSize.Sm" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => _showAllComponents = true)" />
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private const int DefaultCatalogLimit = 16;
    private string _filter = "";
    private bool _showAllComponents;

    private IEnumerable<(LuxProductInfo Product, LuxProductComponentLink Component)> FilteredComponents =>
        from p in LuxStackProducts.All
        from c in p.Components
        where string.IsNullOrWhiteSpace(_filter)
              || c.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || c.Description.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || p.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || p.CorePackage.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || p.UiPackage.Contains(_filter, StringComparison.OrdinalIgnoreCase)
        select (p, c);
}
