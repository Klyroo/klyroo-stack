                        <KlyButton Label="2. Fix Row 1 & RetryRejectedAsync()" Size="KlySize.Sm" Color="KlyColor.Success" Variant="ButtonVariant.Soft" Disabled="@(_batchImporter.RejectedCount == 0)" OnClick="@RetryRejectedDemoAsync" />
