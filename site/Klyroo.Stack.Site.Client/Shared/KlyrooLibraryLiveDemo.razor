        _batchImporter = new SpreadsheetImporter<CodeRow>(SpreadsheetSchema.For<CodeRow>(s =>
        {
            s.Key = "batch-demo";
            s.BatchSize = 2;
            s.Column(r => r.Code, c => c.Label("Code").Required());
            s.OnSubmit = batch =>
            {
                var rejected = new List<SpreadsheetRejectedRow>();
                if (_rejectRow1)
                {
                    var dup = batch.FirstOrDefault(r => r.Index == 1);
                    if (dup is not null) rejected.Add(new SpreadsheetRejectedRow(1, "Duplicate SKU on server", "Code"));
                }
                return Task.FromResult<IReadOnlyList<SpreadsheetRejectedRow>?>(rejected);
            };
        }));
        _batchImporter.LoadText("Code\nSKU-100\nSKU-DUP\nSKU-300", "batch.csv");
    }
    private async Task RunBatchSubmitDemoAsync() => await _batchImporter.SubmitAsync();
    private async Task RetryRejectedDemoAsync()
    {
        _rejectRow1 = false;
        _batchImporter.EditCell(1, "Code", "SKU-200-FIXED");
        await _batchImporter.RetryRejectedAsync();
    }

    // ---- Extra Agent Demos ----
    private readonly AgentBridgeService _multiAgent = new();
    public sealed class Campaign
    {
        public string Title { get; set; } = "";
    }

    private static readonly FormSchema<Campaign> CampaignSchema = FormSchema.For<Campaign>(s =>
    {
        s.FormKey = "multi-form";
        s.Title = "Campaign";
        s.Field(m => m.Title, f => f.Label("Campaign Title").Default("Q4 Launch"));
    });

    private static readonly FormField<Campaign, string> CampaignTitle = CampaignSchema.Field(m => m.Title);
    private readonly FormController<Campaign> _multiForm = new(CampaignSchema);
    private readonly DashboardController _multiDash = new("multi-dash");
    private string _multiAgentStatus = "Click 'Run Cross-Controller Plan' to mutate Form + Dashboard in one AgentActStep[] batch.";
    private async Task RunMultiControllerPlanAsync()
    {
        var res = await _multiAgent.ActAsync([
            new AgentActStep("Campaign Title", "setValue", ["Enterprise Launch 2026"]),
            new AgentActStep("multi-dash", "setView", ["cohorts"])
        ]);
        _multiAgentStatus = $"Ok={res.Ok} | Steps={res.Steps.Count} | CurrentView={_multiDash.CurrentView} | Title={_multiForm.Get(CampaignTitle)}";
    }
    private async Task ResetMultiDashboardAsync()
    {
        var res = await _multiAgent.ActAsync([new AgentActStep("multi-dash", "resetFilters")]);
        _multiAgentStatus = $"Ok={res.Ok} | Dashboard filters reset via AgentBridgeService.";
    }

    private string _diagResult = "Trigger any failure case above to inspect the deterministic AgentActResult.Error returned to an LLM.";
    private async Task RunDiagStepAsync(string target, string action, AgentArgument[]? args)
    {
        var res = await _agent.ActAsync(
            [new AgentActStep(target, action, args)],
            allow: (_, confirmRequired) => Task.FromResult(!confirmRequired));
        _diagResult = $"Ok = {res.Ok}\nError = \"{res.Error}\"";
    }
