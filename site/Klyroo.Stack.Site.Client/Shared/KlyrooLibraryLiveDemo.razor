                    </div>
                </div>
                break;
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string DemoKey { get; set; } = "";
    [Parameter] public string Title { get; set; } = "Interactive Demo";

    // ---- Query Demos ----
    private sealed record QueryItem(int Id, string Name, string Category, decimal Price, bool Active);
    private static readonly QueryItem[] QueryItems =
    [
        new(1, "4K Studio Monitor", "Displays", 350m, true),
        new(2, "Mechanical Keyboard", "Input", 120m, true),
        new(3, "Ergonomic Mouse", "Input", 45m, true),
        new(4, "USB-C Microphone", "Audio", 140m, false),
        new(5, "Studio Headphones", "Audio", 210m, true),
        new(6, "Mesh Desk Mat", "Input", 29m, true)
    ];
    private static readonly DataListSchema<QueryItem> QuerySchema = DataListSchema.For<QueryItem>(s => s
        .RowKey(p => p.Id)
        .Search(p => p.Name)
        .Field(p => p.Price, f => f.Key("price").Sortable().Filter(DataListFilter.Number(min: 0)))
        .Field(p => p.Category, f => f.Key("category").Filter(DataListFilter.Option()))
        .Field(p => p.Active, f => f.Key("active").Filter(DataListFilter.Boolean())));

    private string _qSearch = "";
    private bool _qDesc = true;
    private bool _qActiveOnly;
    private DataListResult<QueryItem> _qResult = default!;

    private decimal _qMin = 40m;
    private decimal _qMax = 400m;
    private readonly HashSet<string> _qCats = ["Displays", "Input", "Audio"];
    private DataListResult<QueryItem> _qFilterResult = default!;
    private string _qFilterJson = "";

    private int _qPage = 1;
    private int _qPageSize = 3;
    private int _qTotalPages => Math.Max(1, (int)Math.Ceiling(QueryItems.Length / (double)_qPageSize));
    private DataListResult<QueryItem> _qPageResult = default!;

    private void OnQuerySearch(string v) { _qSearch = v; RunQuery(); }
    private void ToggleQuerySort() { _qDesc = !_qDesc; RunQuery(); }
    private void ToggleQueryActive() { _qActiveOnly = !_qActiveOnly; RunQuery(); }
    private void RunQuery()
    {
        var filter = _qActiveOnly
            ? DataListFilterGroup.And(new FilterRule("active", FilterOperator.Is, new FilterValue.Boolean(true)))
            : DataListFilterGroup.Empty;
        _qResult = QuerySchema.ExecuteInMemory(QueryItems, new DataListRequest(
            new DataListPaging.Offset(0, 10),
            [new DataListSort("price", Descending: _qDesc)],
            filter,
            string.IsNullOrWhiteSpace(_qSearch) ? null : new DataListSearch(_qSearch)));
    }

    private void OnMinPriceChanged(string v) { if (decimal.TryParse(v, CultureInfo.InvariantCulture, out var d)) _qMin = d; RunFilterAst(); }
    private void OnMaxPriceChanged(string v) { if (decimal.TryParse(v, CultureInfo.InvariantCulture, out var d)) _qMax = d; RunFilterAst(); }
    private void ToggleCategory(string cat) { if (!_qCats.Add(cat)) _qCats.Remove(cat); RunFilterAst(); }
    private void RunFilterAst()
    {
        var rules = new List<DataListFilterNode>
        {
            new FilterRule("price", FilterOperator.Between, new FilterValue.Range(new FilterValue.Number(_qMin), new FilterValue.Number(_qMax)))
        };
        if (_qCats.Count > 0) rules.Add(new FilterRule("category", FilterOperator.IsAnyOf, new FilterValue.List([.. _qCats])));
        var req = new DataListRequest(new DataListPaging.Offset(0, 10), [new DataListSort("price", Descending: true)], new DataListFilterGroup(FilterCombinator.And, rules), null);
        _qFilterResult = QuerySchema.ExecuteInMemory(QueryItems, req);
        _qFilterJson = JsonSerializer.Serialize(req, DataListJsonContext.Default.DataListRequest);
    }

    private void SetPage(int p) { _qPage = Math.Clamp(p, 1, _qTotalPages); RunPaging(); }
    private void SetPageSize(int sz) { _qPageSize = sz; _qPage = 1; RunPaging(); }
    private void RunPaging()
    {
        _qPageResult = QuerySchema.ExecuteInMemory(QueryItems, new DataListRequest(
            new DataListPaging.Offset((_qPage - 1) * _qPageSize, _qPageSize), [], DataListFilterGroup.Empty, null));
    }

    private FacetMode _qFacetMode = FacetMode.ExcludeSelf;
    private string? _qFacetCat;
    private string? _qCursor;
    private DataListResult<QueryItem> _qCursorResult = default!;
    private void SetFacetMode(FacetMode mode) { _qFacetMode = mode; RunFacetsCursor(); }
    private void ToggleFacetCat(string cat) { _qFacetCat = _qFacetCat == cat ? null : cat; _qCursor = null; RunFacetsCursor(); }
    private void NextCursorPage() { if (_qCursorResult.NextCursor is { } next) { _qCursor = next; RunFacetsCursor(); } }
    private void ResetCursorPage() { _qCursor = null; RunFacetsCursor(); }
    private void RunFacetsCursor()
    {
        var filter = _qFacetCat is null
            ? DataListFilterGroup.Empty
            : DataListFilterGroup.And(new FilterRule("category", FilterOperator.Is, new FilterValue.Text(_qFacetCat)));
        _qCursorResult = QuerySchema.ExecuteInMemory(QueryItems, new DataListRequest(
            new DataListPaging.Cursor(_qCursor, Take: 2, Count: true),
            [new DataListSort("price", Descending: true)],
            filter,
            null,
            facets: [new DataListFacetRequest("category", Mode: _qFacetMode)]));
    }

    private string _uSearch = "studio";
    private string? _uPrefix = "cat";
    private DataListLayout _uLayout = DataListLayout.Grid;
    private int _uPage = 2;
    private bool _uOnlyAudio = true;
    private string _uQueryString = "";
    private DataListState _uRestored = DataListState.Initial;
    private bool _uRoundTripOk;
    private void OnUrlSearch(string v) { _uSearch = v; RunUrlCodecDemo(); }
    private void ToggleUrlPrefix() { _uPrefix = _uPrefix is null ? "cat" : null; RunUrlCodecDemo(); }
    private void ToggleUrlLayout() { _uLayout = _uLayout == DataListLayout.Table ? DataListLayout.Grid : DataListLayout.Table; RunUrlCodecDemo(); }
    private void NextUrlPage() { _uPage = _uPage >= 5 ? 1 : _uPage + 1; RunUrlCodecDemo(); }
    private void ToggleUrlAudio() { _uOnlyAudio = !_uOnlyAudio; RunUrlCodecDemo(); }
    private void RunUrlCodecDemo()
    {
        IReadOnlyList<FilterRule> filters = _uOnlyAudio
            ? [new FilterRule("category", FilterOperator.IsAnyOf, new FilterValue.List(["Audio"])), new FilterRule("price", FilterOperator.Between, new FilterValue.Range(new FilterValue.Number(50m), new FilterValue.Number(900m)))]
            : [new FilterRule("price", FilterOperator.Between, new FilterValue.Range(new FilterValue.Number(50m), new FilterValue.Number(900m)))];
        var state = new DataListState(_uSearch, filters, [new DataListSort("price", Descending: true)], _uPage, 25, _uLayout);
        var pairs = DataListStateQuery.ToQuery(state, QuerySchema, _uPrefix);
        _uQueryString = pairs.Count == 0 ? "(empty — all values match schema defaults)" : "?" + string.Join("&", pairs.Select(kv => $"{kv.Key}={kv.Value}"));
        _uRestored = DataListStateQuery.FromQuery(pairs.Select(kv => new KeyValuePair<string, string?>(kv.Key, kv.Value)), QuerySchema, _uPrefix);
        _uRoundTripOk = _uRestored.Equals(state);
    }

