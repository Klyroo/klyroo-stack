@using System.Globalization
@using System.Text.Json
@using Klyroo.Query

<div class="my-6 overflow-hidden rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg)">
    <div class="flex items-center justify-between gap-2 border-b border-(--klyroo-border) bg-(--klyroo-bg-muted)/60 px-4 py-2 font-mono text-xs text-(--klyroo-text-muted)">
        <span class="flex items-center gap-2 text-(--klyroo-text-highlighted)">
            <span class="size-2 rounded-full bg-(--klyroo-primary)" aria-hidden="true"></span>
            LIVE EXAMPLE · @Title
        </span>
        <span>Interactive</span>
    </div>
    <div class="p-5">
        @switch (DemoKey)
        {
            case "query-inmemory":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-3">
                        <div class="w-60">
                            <KlyInput Value="@_qSearch" ValueChanged="@OnQuerySearch" Placeholder="Search products (e.g. M)..." aria-label="Search products" />
                        </div>
                        <KlyButton Label="@(_qDesc ? "Sort: Price DESC" : "Sort: Price ASC")" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ToggleQuerySort" />
                        <KlyButton Label="@(_qActiveOnly ? "Active only: ON" : "Active only: OFF")" Size="KlySize.Sm" Color="@(_qActiveOnly ? KlyColor.Success : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@ToggleQueryActive" />
                    </div>
                    <p class="font-mono text-xs text-(--klyroo-text-muted)">
                        Matched <strong class="text-(--klyroo-text-highlighted)">@_qResult.TotalCount</strong> items via <code>DataListSchema.ExecuteInMemory</code>
                    </p>
                    <div class="grid gap-2 sm:grid-cols-3">
                        @foreach (var item in _qResult.Items)
                        {
                            <div class="flex items-center justify-between rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 px-3 py-2.5 font-mono text-xs">
                                <span>@item.Name</span>
                                <span class="font-semibold text-(--klyroo-text-highlighted)">€@item.Price</span>
                            </div>
                        }
                    </div>
                </div>
                break;

            case "query-filters":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="font-mono text-xs text-(--klyroo-text-muted)">Min €:</span>
                        <div class="w-24"><KlyInput Value="@_qMin.ToString(CultureInfo.InvariantCulture)" ValueChanged="@OnMinPriceChanged" aria-label="Min price" /></div>
                        <span class="font-mono text-xs text-(--klyroo-text-muted)">Max €:</span>
                        <div class="w-24"><KlyInput Value="@_qMax.ToString(CultureInfo.InvariantCulture)" ValueChanged="@OnMaxPriceChanged" aria-label="Max price" /></div>
                        @foreach (var cat in new[] { "Displays", "Input", "Audio" })
                        {
                            var selected = _qCats.Contains(cat);
                            <KlyButton Label="@cat" Size="KlySize.Sm" Color="@(selected ? KlyColor.Primary : KlyColor.Neutral)" Variant="@(selected ? ButtonVariant.Solid : ButtonVariant.Outline)" OnClick="@(() => ToggleCategory(cat))" />
                        }
                    </div>
                    <div class="grid gap-3 lg:grid-cols-2">
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3">
                            <p class="font-mono text-xs uppercase text-(--klyroo-text-muted)">Filtered Results (@_qFilterResult.TotalCount)</p>
                            <ul class="mt-2 space-y-1 font-mono text-xs">
                                @foreach (var item in _qFilterResult.Items)
                                {
                                    <li class="flex justify-between"><span>@item.Name (@item.Category)</span><strong>€@item.Price</strong></li>
                                }
                            </ul>
                        </div>
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--pg-code-bg) p-3 font-mono text-[11px] text-[#d7dcde]">
                            <p class="mb-1 text-[#94a3b8]">DataListJsonContext (NativeAOT JSON AST)</p>
                            <pre class="overflow-x-auto whitespace-pre-wrap">@_qFilterJson</pre>
                        </div>
                    </div>
                </div>
                break;

            case "query-paging":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <KlyButton Label="Previous" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" Disabled="@(_qPage <= 1)" OnClick="@(() => SetPage(_qPage - 1))" />
                        <span class="px-2 font-mono text-xs text-(--klyroo-text-highlighted)">Page @_qPage / @_qTotalPages</span>
                        <KlyButton Label="Next" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" Disabled="@(_qPage >= _qTotalPages)" OnClick="@(() => SetPage(_qPage + 1))" />
                        <span class="ms-2 font-mono text-xs text-(--klyroo-text-muted)">PageSize:</span>
                        @foreach (var sz in new[] { 2, 3, 5 })
                        {
                            <KlyButton Label="@sz.ToString()" Size="KlySize.Sm" Color="@(_qPageSize == sz ? KlyColor.Primary : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => SetPageSize(sz))" />
                        }
                    </div>
                    <div class="grid gap-2 sm:grid-cols-3">
                        @foreach (var item in _qPageResult.Items)
                        {
                            <div class="flex items-center justify-between rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 px-3 py-2 font-mono text-xs">
                                <span>#@item.Id @item.Name</span>
                                <strong>€@item.Price</strong>
                            </div>
                        }
                    </div>
                </div>
                break;

            case "query-facets-cursor":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-xs text-(--klyroo-text-muted)">FacetMode:</span>
                        <KlyButton Label="ExcludeSelf (multi-select UX)" Size="KlySize.Sm" Color="@(_qFacetMode == FacetMode.ExcludeSelf ? KlyColor.Primary : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => SetFacetMode(FacetMode.ExcludeSelf))" />
                        <KlyButton Label="IncludeSelf (strict intersection)" Size="KlySize.Sm" Color="@(_qFacetMode == FacetMode.IncludeSelf ? KlyColor.Primary : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => SetFacetMode(FacetMode.IncludeSelf))" />
                        <KlyButton Label="Next Cursor Page" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" Disabled="@(_qCursorResult.NextCursor is null)" OnClick="@NextCursorPage" />
                        <KlyButton Label="Reset Cursor" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" Disabled="@(_qCursor is null)" OnClick="@ResetCursorPage" />
                    </div>
                    <div class="grid gap-3 lg:grid-cols-2">
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3">
                            <p class="font-mono text-xs uppercase text-(--klyroo-text-muted)">Live Facet Buckets (Click to filter)</p>
                            <div class="mt-2 flex flex-wrap gap-2">
                                @if (_qCursorResult.Facets is { Count: > 0 } facets)
                                {
                                    @foreach (var opt in facets[0].Options)
                                    {
                                        var active = _qFacetCat == opt.Value;
                                        <KlyButton Label="@($"{opt.Value} ({opt.Count})")" Size="KlySize.Sm" Color="@(active ? KlyColor.Primary : KlyColor.Neutral)" Variant="@(active ? ButtonVariant.Solid : ButtonVariant.Outline)" OnClick="@(() => ToggleFacetCat(opt.Value))" />
                                    }
                                }
                            </div>
                            <p class="mt-3 font-mono text-[11px] text-(--klyroo-text-muted)">
                                Active cursor: <code class="text-(--klyroo-text-highlighted)">@(_qCursor ?? "(first page)")</code><br />
                                NextCursor: <code class="text-(--klyroo-text-highlighted)">@(_qCursorResult.NextCursor ?? "(end of stream)")</code>
                            </p>
                        </div>
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3">
                            <p class="font-mono text-xs uppercase text-(--klyroo-text-muted)">Keyset Cursor Slice (Take = 2 · Total = @_qCursorResult.TotalCount)</p>
                            <ul class="mt-2 space-y-1.5 font-mono text-xs">
                                @foreach (var item in _qCursorResult.Items)
                                {
                                    <li class="flex justify-between rounded-lg bg-(--klyroo-bg) px-2.5 py-1.5">
                                        <span>#@item.Id @item.Name (@item.Category)</span>
                                        <strong>€@item.Price</strong>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
                break;

            case "query-url-codecs":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <div class="w-48"><KlyInput Value="@_uSearch" ValueChanged="@OnUrlSearch" Placeholder="Search term (q)..." aria-label="URL search" /></div>
                        <KlyButton Label="@($"Prefix: {(_uPrefix ?? "(none)")}")" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ToggleUrlPrefix" />
                        <KlyButton Label="@($"Layout: {_uLayout}")" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ToggleUrlLayout" />
                        <KlyButton Label="@($"Page: {_uPage}")" Size="KlySize.Sm" Color="KlyColor.Primary" Variant="ButtonVariant.Soft" OnClick="@NextUrlPage" />
                        <KlyButton Label="@(_uOnlyAudio ? "Category: Audio" : "Category: All")" Size="KlySize.Sm" Color="@(_uOnlyAudio ? KlyColor.Success : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@ToggleUrlAudio" />
                    </div>
                    <div class="rounded-xl border border-(--klyroo-border) bg-(--pg-code-bg) p-3 font-mono text-xs text-[#d7dcde]">
                        <p class="mb-1 text-[#94a3b8]">1. DataListStateQuery.ToQuery(state, schema, prefix) → URL Query String</p>
                        <code class="break-all text-(--klyroo-primary)">@_uQueryString</code>
                    </div>
                    <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3 font-mono text-xs">
                        <p class="text-(--klyroo-text-muted)">2. DataListStateQuery.FromQuery(pairs, schema, prefix) → Restored DataListState</p>
                        <p class="mt-1 text-(--klyroo-text-highlighted)">
                            Search=<strong>"@_uRestored.Search"</strong> · Page=<strong>@_uRestored.Page</strong> · Layout=<strong>@_uRestored.Layout</strong> · Filters=<strong>@_uRestored.Filters.Count</strong> · Equals Original: <strong>@_uRoundTripOk</strong>
                        </p>
                    </div>
                </div>
                break;

            case "table-basic":
                <KlyDataList TItem="TableDemoRow" Schema="@TableSchema" Items="@TableRows" UrlSync="false">
                    <KlyDataListTable TItem="TableDemoRow" HeaderMenu="true" ShowProgressLine="true" Summaries="@(new DataListSummaries<TableDemoRow>())">
                        <KlyDataListFieldColumn TItem="TableDemoRow" Field="name" Title="Employee" />
                        <KlyDataListFieldColumn TItem="TableDemoRow" Field="dept" Title="Department" />
                        <KlyDataListFieldColumn TItem="TableDemoRow" Field="salary" Title="Salary (€)" Summary="DataListSummaryKind.Sum" />
                    </KlyDataListTable>
                </KlyDataList>
                break;

            case "table-tree":
                <KlyDataList TItem="OrgRow" Schema="@OrgSchema" Items="@OrgRoots" UrlSync="false">
                    <KlyDataListTable TItem="OrgRow" Tree="@OrgTree">
                        <KlyDataListFieldColumn TItem="OrgRow" Field="name" Title="Organization Hierarchy" />
                        <KlyDataListFieldColumn TItem="OrgRow" Field="role" Title="Role" />
                    </KlyDataListTable>
                </KlyDataList>
                break;

            case "table-grouped":
                <div class="flex flex-col gap-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-xs text-(--klyroo-text-muted)">Density:</span>
                        @foreach (var d in Enum.GetValues<DataListDensity>())
                        {
                            <KlyButton Label="@d.ToString()" Size="KlySize.Sm" Color="@(_tableDensity == d ? KlyColor.Primary : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => _tableDensity = d)" />
                        }
                    </div>
                    <KlyDataList TItem="TableDemoRow" Schema="@TableSchema" Items="@TableRows" UrlSync="false">
                        <KlyDataListTable TItem="TableDemoRow" Density="@_tableDensity" GroupBy="@TableGroupBy" Summaries="@(new DataListSummaries<TableDemoRow>())">
                            <KlyDataListFieldColumn TItem="TableDemoRow" Field="name" Title="Employee" />
                            <KlyDataListFieldColumn TItem="TableDemoRow" Field="dept" Title="Department" />
                            <KlyDataListFieldColumn TItem="TableDemoRow" Field="salary" Title="Salary (€)" Summary="DataListSummaryKind.Average" />
                        </KlyDataListTable>
                    </KlyDataList>
                </div>
                break;

            case "table-density-summary":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-xs text-(--klyroo-text-muted)">Summary Kind:</span>
                        @foreach (var kind in new[] { DataListSummaryKind.Sum, DataListSummaryKind.Average, DataListSummaryKind.Min, DataListSummaryKind.Max, DataListSummaryKind.Count })
                        {
                            <KlyButton Label="@kind.ToString()" Size="KlySize.Sm" Color="@(_tableSummaryKind == kind ? KlyColor.Primary : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => _tableSummaryKind = kind)" />
                        }
                        <KlyButton Label="@(_tableMobileSummary ? "View: Compact Mobile Summary" : "View: Standard Table")" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => _tableMobileSummary = !_tableMobileSummary)" />
                    </div>
                    <KlyDataList TItem="TableDemoRow" Schema="@TableSchema" Items="@TableRows" UrlSync="false">
                        <KlyDataListTable TItem="TableDemoRow"
                                         RowSummary="@(_tableMobileSummary ? TablePhoneSummary : null)"
                                         Summaries="@(new DataListSummaries<TableDemoRow>())">
                            <KlyDataListFieldColumn TItem="TableDemoRow" Field="name" Title="Employee" />
                            <KlyDataListFieldColumn TItem="TableDemoRow" Field="dept" Title="Department" />
                            <KlyDataListFieldColumn TItem="TableDemoRow" Field="salary" Title="Salary (€)" Summary="@_tableSummaryKind" />
                        </KlyDataListTable>
                    </KlyDataList>
                </div>
                break;

            case "table-selection-actions":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <KlyButton Label="Inspect Headless BuildTree()" Size="KlySize.Sm" OnClick="@InspectHeadlessTree" />
                        <KlyButton Label="@($"Expand Depth: {_treeDepth}")" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@CycleTreeDepth" />
                    </div>
                    <div class="grid gap-2 sm:grid-cols-2 font-mono text-xs">
                        @foreach (var node in _headlessNodes)
                        {
                            <div class="flex items-center justify-between rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 px-3 py-2" style="@($"padding-left:{12 + node.Depth * 18}px")">
                                <span>@(node.HasChildren ? "▸" : "•") @node.Item.Name <span class="text-(--klyroo-text-muted)">(@node.Item.Role)</span></span>
                                <span class="text-(--klyroo-text-muted)">Depth @node.Depth</span>
                            </div>
                        }
                    </div>
                    <p class="font-mono text-xs text-(--klyroo-text-muted)">
                        <code>DataListTree&lt;T&gt;.BuildTree()</code> runs 100% headless in <code>Klyroo.Table.Core</code> (NativeAOT): <strong>@_headlessNodes.Count</strong> nodes, cycle-guarded.
                    </p>
                </div>
                break;

            case "form-reactive":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 px-3 py-2 font-mono text-xs">
                        <span>IsDirty: <strong>@_formCtrl.IsDirty</strong></span>
                        <span>Dirty fields: <strong>@(DirtyProfileFields.Count == 0 ? "none" : string.Join(", ", DirtyProfileFields))</strong></span>
                        <span>Company visible (age &ge; 21): <strong>@(_formCtrl.Get(ProfileAge) >= 21)</strong></span>
                    </div>
                    <KlyFormEngine Form="@_formCtrl" SubmitLabel="Validate & Submit" ShowReset="true" />
                </div>
                break;

            case "form-wizard":
                <div class="flex flex-col gap-3">
                    <p class="font-mono text-xs text-(--klyroo-text-muted)">
                        Step @(_wizardCtrl.CurrentStepIndex + 1) · Active: <strong>@WizardStepTitle</strong>
                        (Select <code>Free</code> to skip the Billing step automatically via <code>SkipWhen</code>)
                    </p>
                    <KlyFormEngine Form="@_wizardCtrl" SubmitLabel="Complete Onboarding" ShowReset="true" />
                </div>
                break;

            case "form-array":
                <div class="flex flex-col gap-4">
                    <KlyFormEngine Form="@_arrayCtrl" SubmitLabel="Build Invoice Payload" ShowReset="true" />
                    <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3 font-mono text-xs">
                        Line items count: <strong>@_arrayCtrl.Rows(InvoiceItems).Count</strong>
                    </div>
                </div>
                break;

            case "form-dirty-diff":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <KlyButton Label="Mutate Name -> 'Claire'" Size="KlySize.Sm" OnClick="@(() => { _dirtyCtrl.Set(WorkspaceName, "Claire", markTouched: true); RefreshDirtyJson(); })" />
                        <KlyButton Label="Mutate Plan -> 'enterprise'" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => { _dirtyCtrl.Set(WorkspacePlan, "enterprise", markTouched: true); RefreshDirtyJson(); })" />
                        <KlyButton Label="ResetField(Name)" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Soft" OnClick="@(() => { _dirtyCtrl.ResetField(WorkspaceName); RefreshDirtyJson(); })" />
                        <KlyButton Label="SubmitAsync() (Re-baseline)" Size="KlySize.Sm" Color="KlyColor.Success" Variant="ButtonVariant.Soft" OnClick="@SubmitDirtyDemoAsync" />
                    </div>
                    <div class="grid gap-3 lg:grid-cols-2 font-mono text-xs">
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3 space-y-1">
                            <p>IsDirty: <strong class="text-(--klyroo-text-highlighted)">@_dirtyCtrl.IsDirty</strong></p>
                            <p>Dirty fields: <strong class="text-(--klyroo-text-highlighted)">@(DirtyWorkspaceFields.Count == 0 ? "(clean)" : string.Join(", ", DirtyWorkspaceFields))</strong></p>
                            <p>Get(Name): <strong>@(_dirtyCtrl.Get(WorkspaceName))</strong> · Get(Plan): <strong>@(_dirtyCtrl.Get(WorkspacePlan))</strong></p>
                        </div>
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--pg-code-bg) p-3 text-[#d7dcde]">
                            <p class="mb-1 text-[#94a3b8]">CreateModel() (trimmed &amp; transformed)</p>
                            <pre class="overflow-x-auto">@_dirtyOutputJson</pre>
                        </div>
                    </div>
                </div>
                break;

            case "form-sections-errors":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <KlyButton Label="Inject Server Blocking Error on Email" Size="KlySize.Sm" Color="KlyColor.Error" Variant="ButtonVariant.Soft" OnClick="@(() => _sectionCtrl.SetError(SetupEmail, "Email already registered on server", blocking: true))" />
                        <KlyButton Label="ClearErrors(Email)" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => _sectionCtrl.ClearErrors(SetupEmail))" />
                        <KlyButton Label="Fill All Required" Size="KlySize.Sm" Color="KlyColor.Success" Variant="ButtonVariant.Soft" OnClick="@(() => { _sectionCtrl.Set(SetupEmail, "team@klyroo.dev"); _sectionCtrl.Set(SetupVat, "FR99123456789"); _sectionCtrl.ClearErrors(SetupEmail); })" />
                    </div>
                    <div class="grid gap-3 sm:grid-cols-3 font-mono text-xs">
                        @foreach (var sec in _sectionCtrl.GetSectionStates())
                        {
                            <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3">
                                <p class="text-(--klyroo-text-muted)">@sec.Label</p>
                                <p class="mt-1 text-sm font-semibold text-(--klyroo-text-highlighted)">@sec.Status</p>
                            </div>
                        }
                    </div>
                    <p class="font-mono text-xs text-(--klyroo-text-muted)">
                        HasBlockingErrors: <strong class="text-(--klyroo-text-highlighted)">@_sectionCtrl.HasBlockingErrors</strong> · Email error: <strong>@(_sectionCtrl.GetError(SetupEmail) ?? "none")</strong>
                    </p>
                </div>
                break;

            case "dashboard-kpi":
                <div class="flex flex-col gap-5">
                    <KlyDashboardStats Title="Executive KPIs" Items="@DashStats" />
                    <div class="grid gap-4 lg:grid-cols-2">
                        <KlyDashboardGauge Title="Q4 ARR Target" Value="86" Max="100" Target="90" Format="DashboardFormatPreset.Percent" Caption="86% reached" />
                        <KlyDashboardBars Title="Platform Distribution" Items="@DashBars" Format="DashboardFormatPreset.Compact" />
                    </div>
                </div>
                break;

            case "dashboard-waves":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <KlyButton Label="Run Staged RefreshAsync()" Size="KlySize.Sm" OnClick="@RunDashWavesAsync" />
                        <KlyButton Label="Activate Deferred Resource" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ActivateDeferredAsync" />
                    </div>
                    <div class="grid gap-3 sm:grid-cols-3 font-mono text-xs">
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3">
                            <p class="text-(--klyroo-text-muted)">WAVE 1 · ESSENTIAL</p>
                            <p class="mt-1 text-base font-semibold text-(--klyroo-text-highlighted)">@_waveEssential.State</p>
                            <p class="mt-1">Value: @(_waveEssential.Data?.ToString() ?? "—")</p>
                        </div>
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3">
                            <p class="text-(--klyroo-text-muted)">WAVE 2 · BACKGROUND</p>
                            <p class="mt-1 text-base font-semibold text-(--klyroo-text-highlighted)">@_waveBackground.State</p>
                            <p class="mt-1">Value: @(_waveBackground.Data ?? "—")</p>
                        </div>
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3">
                            <p class="text-(--klyroo-text-muted)">WAVE 3 · DEFERRED</p>
                            <p class="mt-1 text-base font-semibold text-(--klyroo-text-highlighted)">@_waveDeferred.State</p>
                            <p class="mt-1">Value: @(_waveDeferred.Data ?? "Idle until activated")</p>
                        </div>
                    </div>
                </div>
                break;

            case "dashboard-table-alerts":
                <div class="flex flex-col gap-4">
                    <KlyDashboardTable Title="Top Regions" Menu="true" Columns="@DashTableCols" Rows="@DashTableRows" />
                    <div class="grid gap-4 lg:grid-cols-2">
                        <KlyDashboardAlerts Title="Operational Alerts" Items="@DashAlerts" />
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-4">
                            <div class="flex items-center justify-between gap-2">
                                <span class="font-mono text-xs uppercase text-(--klyroo-text-muted)">DashboardFormat.ExportCsv (fr-FR BOM)</span>
                                <KlyButton Label="Generate CSV" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@GenerateSampleCsv" />
                            </div>
                            <pre class="mt-3 overflow-x-auto font-mono text-xs text-(--klyroo-text-highlighted)">@_dashCsvPreview</pre>
                        </div>
                    </div>
                </div>
                break;

            case "dashboard-filters-views":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-xs text-(--klyroo-text-muted)">Views:</span>
                        @foreach (var v in _dashFilterCtrl.Views)
                        {
                            <KlyButton Label="@(v.Badge is null ? v.Label : $"{v.Label} ({v.Badge})")" Size="KlySize.Sm" Color="@(_dashFilterCtrl.CurrentView == v.Key ? KlyColor.Primary : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => _dashFilterCtrl.CurrentView = v.Key)" />
                        }
                        <span class="ms-2 font-mono text-xs text-(--klyroo-text-muted)">Regions:</span>
                        @foreach (var r in new[] { "eu", "us", "ap" })
                        {
                            var active = _dashRegionFilter.Values.Contains(r);
                            <KlyButton Label="@r.ToUpperInvariant()" Size="KlySize.Sm" Color="@(active ? KlyColor.Primary : KlyColor.Neutral)" Variant="@(active ? ButtonVariant.Solid : ButtonVariant.Outline)" OnClick="@(() => _dashRegionFilter.Toggle(r))" />
                        }
                        <KlyButton Label="ResetFilters()" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" Disabled="@(!_dashFilterCtrl.Filtered)" OnClick="@(() => _dashFilterCtrl.ResetFilters())" />
                    </div>
                    <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3 font-mono text-xs">
                        CurrentView: <strong>@_dashFilterCtrl.CurrentView</strong> ·
                        Selected Regions: <strong>@string.Join(", ", _dashRegionFilter.Values)</strong> ·
                        Controller.Filtered: <strong>@_dashFilterCtrl.Filtered</strong>
                    </div>
                </div>
                break;

            case "dashboard-format-compare":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2">
                        @foreach (var mode in new[] { DashboardComparisonMode.Previous, DashboardComparisonMode.Year })
                        {
                            <KlyButton Label="@($"Compare: {mode}")" Size="KlySize.Sm" Color="@(_dashCompMode == mode ? KlyColor.Primary : KlyColor.Neutral)" Variant="ButtonVariant.Soft" OnClick="@(() => _dashCompMode = mode)" />
                        }
                    </div>
                    <div class="grid gap-3 lg:grid-cols-2 font-mono text-xs">
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3 space-y-1">
                            <p class="text-(--klyroo-text-muted)">DashboardFormat Presets (InvariantCulture)</p>
                            <p>Compact(2_400_000) = <strong>@DashboardFormat.Format(2_400_000, DashboardFormatPreset.Compact, CultureInfo.InvariantCulture)</strong></p>
                            <p>Delta(14.2) = <strong>@DashboardFormat.Format(14.2, DashboardFormatPreset.Delta, CultureInfo.InvariantCulture)</strong> · Ratio(0.57) = <strong>@DashboardFormat.Format(0.57, DashboardFormatPreset.Ratio, CultureInfo.InvariantCulture)</strong></p>
                            <p>Null/NaN guard = <strong>@DashboardFormat.Format(double.NaN, DashboardFormatPreset.Number, CultureInfo.InvariantCulture)</strong></p>
                        </div>
                        <div class="rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 p-3 space-y-1">
                            @{
                                var range = DashboardFormat.ResolveComparisonRange(
                                    (new DateTimeOffset(2024, 2, 1, 0, 0, 0, TimeSpan.Zero), new DateTimeOffset(2024, 2, 29, 0, 0, 0, TimeSpan.Zero)),
                                    _dashCompMode);
                            }
                            <p class="text-(--klyroo-text-muted)">Leap-Year Comparison (2024-02-01 → 2024-02-29)</p>
                            <p>Resolved Start: <strong>@range?.Start.ToString("yyyy-MM-dd")</strong></p>
                            <p>Resolved End: <strong>@range?.End.ToString("yyyy-MM-dd")</strong> (clamped safely on leap years)</p>
                        </div>
                    </div>
                </div>
                break;

            case "display-blocks":
                <div class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
                        <span class="text-(--klyroo-text-muted)">Emphasized lines of the query:</span>
                        <KlyButton Label="WHERE clause" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="@(_codeFocus == "where" ? ButtonVariant.Solid : ButtonVariant.Soft)" OnClick="@(() => _codeFocus = "where")" />
                        <KlyButton Label="SELECT list" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="@(_codeFocus == "select" ? ButtonVariant.Solid : ButtonVariant.Soft)" OnClick="@(() => _codeFocus = "select")" />
                        <KlyButton Label="None" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="@(_codeFocus == "none" ? ButtonVariant.Solid : ButtonVariant.Soft)" OnClick="@(() => _codeFocus = "none")" />
                    </div>
                    <div class="grid gap-4 lg:grid-cols-2">
                        <KlyCodeBlock Label="Orders.sql" Code="@_demoQuery" Language="CodeLanguage.Sql" LineNumbers
                                      HighlightLines="@(_codeFocus == "where" ? new[] { new CodeLineRange(3, 4) } : _codeFocus == "select" ? new[] { new CodeLineRange(1, 1) } : Array.Empty<CodeLineRange>())" />
                        <KlyCodeBlock Label="appsettings.json" Code="@_demoJson" Language="CodeLanguage.Json" Copy="false" />
                        <KlySecretBlock Label="Production API Token" Value="sk_live_klyroo_3210" VisibleChars="4" />
                        <KlyFileList Title="Attachments" Files="_demoFiles" />
                    </div>
