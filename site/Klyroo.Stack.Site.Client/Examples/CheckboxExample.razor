<div class="flex flex-col gap-3">
    <KlyCheckbox @bind-Value="_updates" Label="Product updates" Description="A short email when something ships." />
    <KlyCheckbox Value="true" Label="Success color" Color="KlyColor.Success" />
    <KlyCheckbox Disabled Label="Disabled" />
    <p class="text-sm text-(--klyroo-text-muted)">Updates: @(_updates ? "yes" : "no")</p>
</div>

@code {
    private bool _updates;
}
