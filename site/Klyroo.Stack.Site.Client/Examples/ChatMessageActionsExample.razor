@* Actions sit under the message, Files above it. Copying needs interactivity, so the buttons wait for it. *@
<div class="flex w-full max-w-xl flex-col gap-4" data-testid="chat-message-actions-example">
    <KlyChatMessage Role="ChatRole.User" Text="Can you summarize these?">
        <Files>
            <KlyChatAttachment Name="report.pdf" Type="application/pdf" FileSize="248000" Size="KlySize.Sm" />
            <KlyChatAttachment Name="notes.txt" Type="text/plain" FileSize="1200" Size="KlySize.Sm" />
        </Files>
    </KlyChatMessage>
    <KlyChatMessage Role="ChatRole.Assistant" Text="The report covers three themes: cost, speed and accessibility." AvatarText="B" AvatarAlt="Klyroo assistant">
        <Header>Klyroo assistant · 9:42</Header>
        <Actions>
            <KlyButton Square Size="KlySize.Xs" Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" aria-label="Copy" OnClick="Copy"
                      LeadingIcon="@KlyIcons.Named("copy", "size-4")" data-testid="chat-message-copy" />
            <KlyButton Square Size="KlySize.Xs" Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" aria-label="Regenerate" OnClick="Regenerate"
                      LeadingIcon="@KlyIcons.Named("refresh-cw", "size-4")" data-testid="chat-message-regenerate" />
            @if (_note is not null)
            {
                <span role="status" class="text-xs" data-testid="chat-message-note">@_note</span>
            }
        </Actions>
    </KlyChatMessage>
</div>

@code {
    private string? _note;

    private void Copy() => _note = "Copied";

    private void Regenerate() => _note = "Regenerating";
}
