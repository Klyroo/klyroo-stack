<div class="flex flex-col items-start gap-3">
    <div class="flex flex-wrap items-center gap-3">
        <KlyToggle Label="Bold" @bind-Value="_bold" />
        <KlyToggle Label="Italic" Variant="ToggleVariant.Soft" />
        <KlyToggle Label="Underline" Variant="ToggleVariant.Ghost" Value="true" />
    </div>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="toggle-state">Bold: @(_bold ? "on" : "off")</p>
</div>

@code {
    private bool _bold;
}
