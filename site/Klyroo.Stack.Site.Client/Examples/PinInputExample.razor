<div class="flex flex-col items-start gap-4">
    <KlyFormField Label="Verification code" Help="Paste a code into any box to fill them all.">
        <KlyPinInput Length="6" @bind-Value="_code" />
    </KlyFormField>
    <KlyFormField Label="Secret PIN">
        <KlyPinInput Length="4" Mask Type="PinInputType.Alphanumeric" Size="KlySize.Lg" />
    </KlyFormField>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="pin-state">Code: @(string.IsNullOrEmpty(_code) ? "none" : _code)</p>
</div>

@code {
    private string? _code;
}
