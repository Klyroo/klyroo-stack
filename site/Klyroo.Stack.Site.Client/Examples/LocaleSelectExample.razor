@using System.Globalization
@inject KlyrooOptions Options
@* Needs app.UseRequestLocalization with the same cultures on the server: the select only writes the culture cookie.
   Without Locales it offers KlyrooOptions.Locales, the twelve built-in ones. *@
<div class="flex flex-col items-center gap-3">
    <KlyLocaleSelect data-testid="locale-select" />
    <p class="text-sm text-(--klyroo-text-muted)">Current UI culture: <code data-testid="locale-current">@CultureInfo.CurrentUICulture.Name</code></p>
    <div class="flex items-center gap-3" data-testid="locale-formats">
        <KlyInputTime Value="@(new TimeOnly(15, 30))" AriaLabel="Time" />
        <KlyCalendar Value="@(new DateOnly(2026, 11, 20))" Size="KlySize.Sm" AriaLabel="Calendar" />
    </div>
    <p class="text-sm text-(--klyroo-text-muted)">Formats of the components: <code data-testid="locale-format-culture">@CultureInfo.CurrentCulture.Name</code></p>
    <p class="text-sm text-(--klyroo-text-muted)">Locale of the components: <code data-testid="locale-resolved">@Options.ResolveLocale(CultureInfo.CurrentUICulture).Code</code></p>
</div>
