<div class="flex w-full max-w-xs flex-col gap-3">
    <KlyFormField Label="Country">
        <KlySelect @bind-Value="_country" Items="Countries" Placeholder="Choose a country" data-testid="country" />
    </KlyFormField>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="country-state">Selected: @(_country ?? "none")</p>
</div>

@code {
    private string? _country;

    private static readonly KlySelectItem[] Countries =
    [
        new("fr", "France"),
        new("de", "Germany"),
        new("it", "Italy"),
        new("es", "Spain"),
        new("ch", "Switzerland") { Disabled = true },
        new("uk", "United Kingdom"),
    ];
}
