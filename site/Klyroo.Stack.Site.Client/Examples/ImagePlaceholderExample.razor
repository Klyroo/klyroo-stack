@* KlyImagePlaceholder.Auto paints a tiny version from the provider behind the image while the real one loads.
   Eager loading with a high fetch priority is for the image visible at first paint. *@
<div class="flex flex-wrap items-start gap-6">
    <KlyImage Src="/img/sample-gradient.png" Alt="A warm gradient with a pale sun" Width="320" Height="180" Format="KlyImageFormat.WebP"
             Placeholder="KlyImagePlaceholder.Auto" Class="rounded-lg" data-testid="image-placeholder" />
    <KlyImage Src="/img/sample-waves.png" Alt="Layered waves from blue to violet" Width="320" Height="180" Format="KlyImageFormat.WebP"
             Loading="KlyImageLoading.Eager" FetchPriority="KlyFetchPriority.High" Class="rounded-lg" data-testid="image-eager" />
</div>
