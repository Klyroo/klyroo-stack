<div class="flex w-full max-w-xs flex-col gap-3">
    <KlyFormField Label="Home country, named">
        <KlyInputMenu TValue="string" OptionsProvider="_source.ByPage" Items="Known" Strict PageSize="20" Value="@_country" ValueChanged="@(v => _country = v)" data-testid="remote-named-strict" />
    </KlyFormField>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="remote-named-strict-state">Selected: @(_country ?? "none")</p>
</div>

@code {
    private readonly RemoteDirectory _source = new();
    private string? _country = "fr";

    // Items name a value without listing it: France shows as France in every render mode, without a call to the source.
    private static readonly KlySelectItem[] Known = [new("fr", "France")];
}
