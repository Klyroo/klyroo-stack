<div class="flex flex-col gap-3">
    @foreach (var color in Colors)
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var variant in Enum.GetValues<ButtonVariant>())
            {
                <KlyButton Color="color" Variant="variant" Label="@($"{color} {variant}")" />
            }
        </div>
    }
</div>

@code {
    private static readonly KlyColor[] Colors =
        [KlyColor.Primary, KlyColor.Secondary, KlyColor.Success, KlyColor.Info, KlyColor.Warning, KlyColor.Error, KlyColor.Neutral];
}
