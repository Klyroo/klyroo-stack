<div class="flex flex-col items-center gap-3">
    <KlySlideover @bind-Open="_open" Title="Edit profile" Description="Changes are saved when you press Save.">
        <ChildContent><KlyButton Label="Open slideover" Variant="ButtonVariant.Outline" data-testid="slideover-trigger" /></ChildContent>
        <Body>
            <div class="flex flex-col gap-4">
                <KlyFormField Label="Name"><KlyInput Value="Ada Lovelace" /></KlyFormField>
                <KlyFormField Label="Bio"><KlyTextarea Rows="3" /></KlyFormField>
            </div>
        </Body>
        <Footer>
            <KlyButton Label="Cancel" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" data-kly-close />
            <KlyButton Label="Save" data-kly-close data-testid="slideover-save" />
        </Footer>
    </KlySlideover>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="slideover-state">Slideover: @(_open ? "open" : "closed")</p>
</div>

@code {
    private bool _open;
}
