<div class="flex w-full max-w-2xl flex-col gap-3">
    <KlyFormField Label="Summary" Help="Select some text to format it.">
        <KlyEditor Value="@("<p>Select a few of these words, then use the floating toolbar or press Ctrl+B.</p>")" Name="summary" data-testid="editor-bubble">
            <KlyEditorToolbar Layout="EditorToolbarLayout.Bubble" />
        </KlyEditor>
    </KlyFormField>
    <KlyFormField Label="Read only">
        <KlyEditor Value="@("<p>This text can be selected and copied, not edited.</p>")" ReadOnly="true" data-testid="editor-readonly" />
    </KlyFormField>
</div>
