@using Klyroo.Query

@* Virtualized rows with cursor paging and the automatic loader: only the rows around the viewport are mounted, and the loader is drawn inside the scroll box of the table, after the last row, so scrolling to the end of
   what is loaded appends the next page of 20 (up to 600 invoices). Rows can be ticked: the box of a row that scrolls out of the window gives its focus back when the row comes into view. Statically rendered, the rows are
   not virtualized and the loader is a link to the next cursor. *@
<div class="w-full" data-testid="list-virtual-cursor">
    <KlyDataList TItem="Invoice" Label="Virtualized invoices with cursor paging" Schema="InvoiceCursorData.Schema" Items="_items" PagingMode="DataListPagingMode.Cursor" UrlKey="vc" Selectable="true">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <KlyDataListSearch />
            <div class="flex items-center gap-2">
                <KlyDataListResultCount />
                <KlyDataListRefresh />
            </div>
        </div>
        <KlyDataListErrorState />
        <KlyDataListTable Caption="Virtualized invoices with cursor paging" Virtualize="true">
            <KlyDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <KlyDataListColumn Field="customer" />
            <KlyDataListColumn Field="status" />
            <KlyDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </KlyDataListTable>
        <KlyDataListInfiniteLoader ShowEnd="true" />
    </KlyDataList>
</div>

@code {
    private static readonly Invoice[] _items = InvoiceLargeData.All;
}
