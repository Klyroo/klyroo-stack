<div class="flex flex-wrap items-center gap-8">
    <KlyChip Label="New messages">
        <KlyAvatar Alt="Ada Lovelace" Size="KlySize.Lg" />
    </KlyChip>
    <KlyChip Text="5" Label="5 notifications" Color="KlyColor.Error">
        <KlyButton Label="Inbox" Variant="ButtonVariant.Outline" Color="KlyColor.Neutral" />
    </KlyChip>
    <KlyChip Position="KlyChipPosition.BottomRight" Color="KlyColor.Success" Size="KlySize.Lg" Label="Online">
        <KlyAvatar Alt="Grace Hopper" Size="KlySize.Xl" />
    </KlyChip>
    <KlyChip Position="KlyChipPosition.TopLeft" Inset Show="false">
        <KlyAvatar Alt="Hidden chip" Size="KlySize.Lg" />
    </KlyChip>
    <KlyChip Standalone Text="12" Label="12 unread" Color="KlyColor.Info" Size="KlySize.Lg" />
</div>
