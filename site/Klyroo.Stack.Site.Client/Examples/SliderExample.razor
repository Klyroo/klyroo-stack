<div class="flex w-full max-w-sm flex-col gap-6">
    <KlyFormField Label="Volume">
        <KlySlider @bind-Value="_volume" Min="0" Max="100" Step="5" />
    </KlyFormField>
    <KlyFormField Label="Price range">
        <KlyRangeSlider @bind-Value="_range" Min="0" Max="500" Step="10" Color="KlyColor.Neutral" />
    </KlyFormField>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="slider-state">Volume: @_volume, range: @_range[0] to @_range[1]</p>
</div>

@code {
    private double _volume = 40;
    private IReadOnlyList<double> _range = [100, 300];
}
