<div class="flex w-full max-w-sm flex-col gap-4">
    <KlyCollapsible Label="Release notes" data-testid="plain">
        <p class="pt-2 text-sm text-(--klyroo-text-muted)" data-testid="plain-content">Everything new in this version, hidden until you ask.</p>
    </KlyCollapsible>

    <KlyCollapsible Label="Bound open state" @bind-Open="_open" data-testid="bound">
        <p class="pt-2 text-sm text-(--klyroo-text-muted)">.NET hears about every change.</p>
    </KlyCollapsible>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="open-state">State: @(_open ? "open" : "closed")</p>
</div>

@code {
    private bool _open;
}
