<div class="flex w-full max-w-xs flex-col gap-3">
    <KlyFormField Label="Alarm (24 hours)">
        <KlyInputTime @bind-Value="_alarm" Hour12="false" data-testid="alarm" />
    </KlyFormField>
    <KlyFormField Label="Reminder (12 hours, 15 minute steps)">
        <KlyInputTime @bind-Value="_reminder" Hour12="true" Step="15" data-testid="reminder" />
    </KlyFormField>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="time-state">Alarm: @(_alarm?.ToString("HH:mm") ?? "none"), reminder: @(_reminder?.ToString("HH:mm") ?? "none")</p>
</div>

@code {
    private TimeOnly? _alarm = new(14, 30);
    private TimeOnly? _reminder;
}
