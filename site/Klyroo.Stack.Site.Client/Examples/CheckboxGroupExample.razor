<div class="flex flex-col gap-6 sm:flex-row sm:gap-12">
    <KlyCheckboxGroup TValue="string" Legend="Notifications" Items="Items" @bind-Value="_selected" />
    <KlyCheckboxGroup TValue="int" Legend="Days" Orientation="KlyOrientation.Horizontal" Items="Days" Value="@([1, 3])" Color="KlyColor.Neutral" />
</div>
<p class="w-full text-center text-sm text-(--klyroo-text-muted)" data-testid="checkbox-group-state">Selected: @(_selected.Count > 0 ? string.Join(", ", _selected) : "none")</p>

@code {
    private IReadOnlyList<string> _selected = ["email"];

    private static readonly KlyCheckboxItem<string>[] Items =
    [
        new("email", "Email") { Description = "Weekly digest." },
        new("sms", "SMS"),
        new("push", "Push") { Description = "Not available yet.", Disabled = true },
    ];

    private static readonly KlyCheckboxItem<int>[] Days = [new(1, "Mon"), new(2, "Tue"), new(3, "Wed")];
}
