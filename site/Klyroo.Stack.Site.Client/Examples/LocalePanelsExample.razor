@* One KlyApp per locale: its texts, its writing direction and the culture of its dates and numbers apply to everything inside.
   Nothing here needs interactivity, so it renders the same in every mode. *@
<div class="grid w-full gap-4 md:grid-cols-3">
    @foreach (var locale in _locales)
    {
        <KlyApp Locale="locale" Toaster="false" Class="flex flex-col gap-3 rounded-lg border border-(--klyroo-border) p-4" data-testid="@($"locale-panel-{locale.Code}")">
            <p class="font-medium">@locale.Name <span class="text-xs text-(--klyroo-text-muted)">(@locale.Code, @locale.DirAttribute)</span></p>
            <KlyFileUpload MaxSize="1536" />
            <KlyCalendar Value="@_date" Size="KlySize.Sm" />
        </KlyApp>
    }
</div>

@code {
    private static readonly KlyLocale[] _locales = [KlyLocales.Fr, KlyLocales.Ar, KlyLocales.Ja];
    private readonly DateOnly _date = new(2026, 3, 5);
}
