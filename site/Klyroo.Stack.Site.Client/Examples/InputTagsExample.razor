<div class="flex w-full max-w-sm flex-col gap-3">
    <KlyFormField Label="Topics" Help="Press Enter or comma to add, Backspace to remove. Three at most.">
        <KlyInputTags @bind-Value="_tags" Max="3" Placeholder="Add a topic" />
    </KlyFormField>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="tags-state">Tags: @(_tags.Count > 0 ? string.Join(" | ", _tags) : "none")</p>
</div>

@code {
    private IReadOnlyList<string> _tags = ["blazor", "tailwind"];
}
