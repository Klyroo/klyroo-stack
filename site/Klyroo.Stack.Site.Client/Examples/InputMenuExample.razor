<div class="flex w-full max-w-xs flex-col gap-4">
    <KlyFormField Label="Search a country (free text)">
        <KlyInputMenu Items="Countries" @bind-Value="_free" Placeholder="Type a country" />
    </KlyFormField>
    <KlyFormField Label="Country (a suggestion is required)">
        <KlyInputMenu Items="Countries" Strict @bind-Value="_strict" Placeholder="Pick a country" />
    </KlyFormField>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="menu-state">Free: @(_free ?? "none"), strict: @(_strict ?? "none")</p>
</div>

@code {
    private string? _free;
    private string? _strict;

    private static readonly KlySelectItem[] Countries =
        [new("fr", "France"), new("de", "Germany"), new("it", "Italy"), new("es", "Spain"), new("pt", "Portugal")];
}
