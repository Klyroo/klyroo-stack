@* The Lucide icons are built into the library, by bare name or as i-lucide-{name} / lucide:{name}. An unknown name renders an empty icon marked data-kly-missing-icon. *@
<div class="flex flex-wrap items-center gap-4">
    @foreach (var name in new[] { "search", "bell", "mail", "calendar", "heart", "star", "download", "globe" })
    {
        <KlyIcon Name="@name" Size="KlySize.Lg" />
    }
    <KlyIcon Name="check" Size="KlySize.Xl" Label="Done" Class="text-(--klyroo-success-text)" />
</div>
