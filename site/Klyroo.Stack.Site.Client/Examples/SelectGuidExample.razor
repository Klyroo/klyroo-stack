<div class="flex w-full max-w-xs flex-col gap-3">
    <KlyFormField Label="Assignee">
        <KlySelect @bind-Value="_assignee" Items="People" Placeholder="Choose a person" data-testid="assignee" />
    </KlyFormField>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="assignee-state">Selected: @(_assignee == Guid.Empty ? "none" : _assignee.ToString())</p>
</div>

@code {
    private sealed record Person(Guid Id, string Name);

    private static readonly Person[] Team =
    [
        new(Guid.Parse("6f0d1c2e-7a41-4c6f-9a0e-1b2c3d4e5f60"), "Alma Ahlberg"),
        new(Guid.Parse("a8b3e9d4-2f15-4e7b-8c91-0d6e7f8a9b10"), "Bastian Bianchi"),
        new(Guid.Parse("c4d5e6f7-8a9b-4c0d-91e2-f3a4b5c6d7e8"), "Clara Carvalho"),
    ];

    // A Guid key: the value of the property is the Guid, and Guid.Empty (the default) shows the placeholder.
    private Guid _assignee;

    private static readonly IReadOnlyList<KlySelectItem<Guid>> People = KlySelectItems.From(Team, p => p.Id, p => p.Name);
}
