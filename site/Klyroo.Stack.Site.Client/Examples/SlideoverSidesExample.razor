<KlySlideover Side="SlideoverSide.Left" Title="Navigation">
    <ChildContent><KlyButton Label="Left" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--klyroo-text-muted)">Slides in from the left.</p></Body>
</KlySlideover>
<KlySlideover Side="SlideoverSide.Right" Title="Details">
    <ChildContent><KlyButton Label="Right" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--klyroo-text-muted)">Slides in from the right.</p></Body>
</KlySlideover>
<KlySlideover Side="SlideoverSide.Bottom" Title="Activity" Close="false">
    <ChildContent><KlyButton Label="Bottom" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--klyroo-text-muted)">Slides up from the bottom. Escape closes it.</p></Body>
</KlySlideover>
