<KlyModal @bind-Open="_open" Title="Edit profile" Description="Changes are saved when you close the dialog.">
    <ChildContent><KlyButton Label="Edit profile" Variant="ButtonVariant.Outline" data-testid="modal-trigger" /></ChildContent>
    <Body>
        <div class="flex flex-col gap-4">
            <KlyFormField Label="Name"><KlyInput Value="Ada Lovelace" /></KlyFormField>
            <KlyFormField Label="Bio"><KlyTextarea Rows="3" /></KlyFormField>
        </div>
    </Body>
    <Footer>
        <KlyButton Label="Cancel" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" data-kly-close />
        <KlyButton Label="Save" data-kly-close data-testid="modal-save" />
    </Footer>
</KlyModal>
<p class="text-sm text-(--klyroo-text-muted)" data-testid="modal-state">Dialog: @(_open ? "open" : "closed")</p>

@code {
    private bool _open;
}
