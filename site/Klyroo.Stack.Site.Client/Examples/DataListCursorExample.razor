@using Klyroo.Query

@* Cursor paging with a manual Load more button: each click appends the next page in place (10, then 20, then 25), and sorting or searching restarts from the first page.
   Statically rendered, Load more is a link to the next cursor (?cur.c=...), paired with a Back to start link once past the first page. *@
<div class="w-full" data-testid="list-cursor">
    <KlyDataList TItem="Invoice" Label="Invoices with cursor paging" Schema="InvoiceData.Schema" Items="_items" PagingMode="DataListPagingMode.Cursor" UrlKey="cur">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <KlyDataListSearch />
            <div class="flex items-center gap-2">
                <KlyDataListResultCount />
                <KlyDataListRefresh />
            </div>
        </div>
        <KlyDataListErrorState />
        <KlyDataListTable Caption="Invoices with cursor paging">
            <KlyDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <KlyDataListColumn Field="customer" />
            <KlyDataListColumn Field="status" />
            <KlyDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </KlyDataListTable>
        <KlyDataListInfiniteLoader Auto="false" ShowEnd="true" />
    </KlyDataList>
</div>

@code {
    private static readonly Invoice[] _items = InvoiceData.All[..25];
}
