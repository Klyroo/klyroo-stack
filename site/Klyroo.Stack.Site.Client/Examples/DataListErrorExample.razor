@using Klyroo.Query
@implements IDisposable
@inject QueryState Query
@inject NavigationManager Navigation

@* The provider fails while the address says ?broken=1. The error state keeps the rows on screen and offers a retry; "Repair" removes the flag, and the retry then succeeds. *@
<div class="w-full space-y-3" data-testid="list-error">
    <p class="flex flex-wrap items-center gap-3 text-sm text-(--klyroo-text-muted)">
        <KlyButton Label="Break the backend" Href="@Query.HrefWith(("broken", "1"))" Variant="ButtonVariant.Outline" Color="KlyColor.Neutral" Size="KlySize.Sm" data-testid="err-break" />
        <KlyButton Label="Repair the backend" Href="@Query.HrefWith(("broken", (string?)null))" Variant="ButtonVariant.Outline" Color="KlyColor.Neutral" Size="KlySize.Sm" data-testid="err-repair" />
    </p>
    <KlyDataList TItem="Invoice" Label="Invoices from a flaky backend" Schema="InvoiceData.Schema" Provider="LoadAsync" UrlKey="err">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <KlyDataListResultCount />
            <KlyDataListRefresh />
        </div>
        <KlyDataListErrorState data-testid="err-state" />
        <KlyDataListTable Caption="Invoices from a flaky backend">
            <KlyDataListFieldColumn Field="id" Title="No." Align="DataListAlign.End" />
            <KlyDataListFieldColumn Field="customer" />
            <KlyDataListFieldColumn Field="status" />
        </KlyDataListTable>
        <KlyDataListPagination />
    </KlyDataList>
</div>

@code {
    // The links carry the current address with one change: they follow it.
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private ValueTask<DataListResult<Invoice>> LoadAsync(DataListRequest request, CancellationToken cancellationToken)
    {
        if (new Uri(Navigation.Uri).Query.Contains("broken=1", StringComparison.Ordinal))
        {
            throw new InvalidOperationException("The invoice service is down.");
        }
        return ValueTask.FromResult(InvoiceData.Schema.ExecuteInMemory(InvoiceData.All, request));
    }
}
