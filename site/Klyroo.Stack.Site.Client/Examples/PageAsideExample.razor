@* Sticky below the header and shown from the lg breakpoint. Rendered here with As="div" because the example sits inside a landmark. *@
<div class="w-full max-w-xs rounded-lg border border-(--klyroo-border) bg-(--klyroo-bg) px-4">
    <KlyPageAside As="PageAsideElement.Div" Class="static block py-4">
        <Top><p class="text-sm font-semibold text-(--klyroo-text-highlighted)">Docs</p></Top>
        <ChildContent><KlyPageLinks aria-label="Docs navigation" Links="_links" /></ChildContent>
        <Bottom><p class="text-xs text-(--klyroo-text-muted)">Version 0.1</p></Bottom>
    </KlyPageAside>
</div>

@code {
    private readonly PageLinkItem[] _links =
    [
        new("Installation", "/docs/installation") { Active = false },
        new("Theming", "/docs/theming") { Active = false },
    ];
}
