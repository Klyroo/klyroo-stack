@using System.ComponentModel.DataAnnotations

<EditForm Model="Model" FormName="signup" OnValidSubmit="Submit" class="flex w-full max-w-sm flex-col gap-4" novalidate>
    <DataAnnotationsValidator />
    <KlyFormField Label="Email" Required For="() => Model!.Email" Description="We never share it.">
        <KlyInput Type="InputType.Email" @bind-Value="Model!.Email" Placeholder="you@example.com" />
    </KlyFormField>
    <KlyFormField Label="Role" Hint="Optional">
        <KlySelect @bind-Value="Model!.Role" Items="Roles" Placeholder="Pick one" />
    </KlyFormField>
    <KlyFormField Label="About you" Help="Markdown is supported." For="() => Model!.Bio">
        <KlyTextarea @bind-Value="Model!.Bio" Rows="3" />
    </KlyFormField>
    <KlyCheckbox @bind-Value="Model!.Newsletter" Label="Send me the newsletter" />
    <KlyButton Type="ButtonType.Submit" Label="Create account" Block />
    @if (_done)
    {
        <KlyAlert Title="Account created" Color="KlyColor.Success" Variant="KlyVariant.Soft" Icon='KlyIcons.Named("circle-check")' />
    }
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "signup")]
    private SignUp? Model { get; set; }

    private bool _done;

    private static readonly KlySelectItem[] Roles = [new("dev", "Developer"), new("design", "Designer"), new("pm", "Product manager")];

    protected override void OnInitialized() => Model ??= new();

    private void Submit() => _done = true;

    private sealed class SignUp
    {
        [Required, EmailAddress]
        public string? Email { get; set; }

        public string? Role { get; set; }

        [MaxLength(200)]
        public string? Bio { get; set; }

        public bool Newsletter { get; set; }
    }
}
