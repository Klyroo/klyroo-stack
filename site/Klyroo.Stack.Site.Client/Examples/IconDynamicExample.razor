@* A name built at runtime cannot be found in the source. List the icons it can produce in a KlyrooIcon item of the project file:
   <KlyrooIcon Include="ph:cube;ph:cube-fill;ph:cube-bold" /> *@
<div class="flex flex-wrap items-center gap-4" data-testid="icon-dynamic">
    @foreach (var weight in new[] { "", "-fill", "-bold" })
    {
        <KlyIcon Name="@($"ph:cube{weight}")" Size="KlySize.Xl" Label="@($"Cube{weight}")" />
    }
</div>
