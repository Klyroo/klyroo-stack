<div class="flex flex-col items-center gap-3">
    <KlyDrawer @bind-Open="_open" Title="Quick actions" Description="Pick something to do next.">
        <ChildContent><KlyButton Label="Open drawer" Variant="ButtonVariant.Outline" data-testid="drawer-trigger" /></ChildContent>
        <Body>
            <p class="text-sm text-(--klyroo-text-muted)">The drawer is a native modal dialog: the page behind it is inert and Escape closes it.</p>
        </Body>
        <Footer>
            <KlyButton Label="Cancel" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" data-kly-close />
            <KlyButton Label="Done" data-kly-close data-testid="drawer-done" />
        </Footer>
    </KlyDrawer>
    <p class="text-sm text-(--klyroo-text-muted)" data-testid="drawer-state">Drawer: @(_open ? "open" : "closed")</p>
</div>

@code {
    private bool _open;
}
