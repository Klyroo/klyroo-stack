<div class="flex flex-wrap items-center gap-3">
    @foreach (var placement in new[] { KlyPlacement.Top, KlyPlacement.Right, KlyPlacement.Bottom, KlyPlacement.Left })
    {
        <KlyTooltip Text="@($"Tooltip on the {PlacementName(placement)}")" Placement="@placement">
            <KlyButton Label="@PlacementName(placement)" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" />
        </KlyTooltip>
    }
</div>

@code {
    private static string PlacementName(KlyPlacement placement) => placement.ToString().ToLowerInvariant();
}
