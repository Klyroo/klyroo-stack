<div class="flex flex-wrap items-center gap-3">
    @foreach (var placement in new[] { "top", "right", "bottom", "left" })
    {
        <KlyTooltip Text="@($"Tooltip on the {placement}")" Placement="@placement">
            <KlyButton Label="@placement" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" />
        </KlyTooltip>
    }
</div>
