@using Klyroo.UI.Theming
@* One KlyTheme can carry several component types, and themes nest: the innermost wins. *@
<KlyTheme Overrides="_outer">
    <div class="flex flex-wrap items-center gap-3" data-testid="theme-outer">
        <KlyButton Label="Outer" />
        <KlyBadge Label="Outer" />
        <KlyTheme For="typeof(KlyButton)" Ui='new ButtonUi { Base = "rounded-none" }'>
            <KlyButton Label="Inner" data-testid="theme-inner" />
        </KlyTheme>
    </div>
</KlyTheme>

@code {
    private readonly Dictionary<Type, ISlotOverrides> _outer = new()
    {
        [typeof(KlyButton)] = new ButtonUi { Base = "rounded-full" },
        [typeof(KlyBadge)] = new BadgeUi { Base = "rounded-full" },
    };
}
