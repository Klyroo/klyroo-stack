<KlyPopover Placement="KlyPlacement.Right">
    <ChildContent><KlyButton Label="Open unbound" Color="KlyColor.Neutral" Variant="ButtonVariant.Subtle" data-testid="unbound-trigger" /></ChildContent>
    <Content>
        <div class="flex w-64 flex-col gap-2 p-4" data-testid="unbound-panel">
            <KlyFormField Label="Name" Id="pg-name">
                <KlyInput data-testid="unbound-input" />
            </KlyFormField>
        </div>
    </Content>
</KlyPopover>
