<KlyDrawer Direction="DrawerDirection.Top" Title="From the top" Close>
    <ChildContent><KlyButton Label="Top" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--klyroo-text-muted)">Handle at the bottom edge.</p></Body>
</KlyDrawer>
<KlyDrawer Direction="DrawerDirection.Left" Title="From the left" Close>
    <ChildContent><KlyButton Label="Left" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--klyroo-text-muted)">Side drawers have no handle.</p></Body>
</KlyDrawer>
<KlyDrawer Direction="DrawerDirection.Right" Inset Title="Inset, from the right" Close>
    <ChildContent><KlyButton Label="Right, inset" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--klyroo-text-muted)">Inset floats the drawer away from the edges.</p></Body>
</KlyDrawer>
