<div class="flex flex-col gap-6 sm:flex-row sm:gap-12">
    <KlyRadioGroup TValue="string" @bind-Value="_plan" Legend="Plan" Items="Plans" />
    <KlyRadioGroup TValue="string" Legend="Billing" Orientation="KlyOrientation.Horizontal" Color="KlyColor.Neutral"
                  Items="@([new("month", "Monthly"), new("year", "Yearly")])" Value="@("month")" />
</div>
<p class="w-full text-center text-sm text-(--klyroo-text-muted)">Selected plan: @_plan</p>

@code {
    private string? _plan = "pro";

    private static readonly KlyRadioItem<string>[] Plans =
    [
        new("free", "Free") { Description = "For side projects." },
        new("pro", "Pro") { Description = "For teams shipping every week." },
        new("enterprise", "Enterprise") { Description = "Contact sales.", Disabled = true },
    ];
}
