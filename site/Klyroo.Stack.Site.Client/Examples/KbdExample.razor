<div class="flex flex-col items-center gap-4">
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var variant in Enum.GetValues<KlyVariant>())
        {
            <KlyKbd Variant="variant" Value="K" />
        }
    </div>
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var size in Enum.GetValues<KlySize>())
        {
            <KlyKbd Size="size" Value="Esc" />
        }
    </div>
    <p class="flex items-center gap-1 text-sm">
        Open the search with <KlyKbd Value="Ctrl" /> <KlyKbd Value="K" />
    </p>
</div>
