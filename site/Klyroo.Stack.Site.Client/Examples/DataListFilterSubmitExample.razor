@* The same filters in the Submit apply mode: the editors keep their changes until Apply, Cancel or Escape drops them, and each Apply is one history entry (sub.f.*). The parts are placed by hand,
   so the filter row is the tags with the add filter button. *@
<div class="w-full space-y-3" data-testid="list-filters-submit">
    <KlyDataList TItem="Invoice" Label="Invoices with Submit filters" Schema="InvoiceFilterData.Schema" Items="InvoiceData.All" UrlKey="sub" ResultJson="DemoJson.Default.DataListResultInvoice">
        <KlyDataListFilterTags ShowAdd="true" ShowClear="true" ApplyMode="DataListApplyMode.Submit" />
        <KlyDataListResultCount />
        <KlyDataListTable Caption="Invoices with Submit filters">
            <KlyDataListFieldColumn Field="id" Title="No." Align="DataListAlign.End" />
            <KlyDataListFieldColumn Field="customer" />
            <KlyDataListFieldColumn Field="status" />
            <KlyDataListFieldColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </KlyDataListTable>
        <KlyDataListPagination />
    </KlyDataList>
</div>
