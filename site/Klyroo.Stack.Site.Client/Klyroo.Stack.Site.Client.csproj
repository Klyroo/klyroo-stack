<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Stack.Site.Client</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Klyroo.UI" />
    <Using Include="Klyroo.Query" />
    <Using Include="Klyroo.Table" />
    <Using Include="Klyroo.Form" />
    <Using Include="Klyroo.Dashboard" />
    <Using Include="Klyroo.Display" />
    <Using Include="Klyroo.Spreadsheet" />
    <Using Include="Klyroo.Agent" />
    <Using Include="Klyroo.Stack" />
  </ItemGroup>

  <!-- Example sources, shown next to their live preview. -->
  <ItemGroup>
    <EmbeddedResource Include="Examples\**\*.razor" LogicalName="example:%(Filename)" />
  </ItemGroup>

  <!-- Parameter descriptions for the API tables, from each library's XML documentation. -->
  <Target Name="EmbedKlyrooDocumentation" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResourceNames">
    <ItemGroup>
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-ui/src/Klyroo.UI/bin/$(Configuration)/net10.0/Klyroo.UI.xml" LogicalName="Klyroo.UI.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-ui/src/Klyroo.UI/bin/$(Configuration)/net10.0/Klyroo.UI.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-query/src/Klyroo.Query.Core/bin/$(Configuration)/net10.0/Klyroo.Query.Core.xml" LogicalName="Klyroo.Query.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-query/src/Klyroo.Query.Core/bin/$(Configuration)/net10.0/Klyroo.Query.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-query/src/Klyroo.Query/bin/$(Configuration)/net10.0/Klyroo.Query.xml" LogicalName="Klyroo.Query.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-query/src/Klyroo.Query/bin/$(Configuration)/net10.0/Klyroo.Query.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-table/src/Klyroo.Table.Core/bin/$(Configuration)/net10.0/Klyroo.Table.Core.xml" LogicalName="Klyroo.Table.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-table/src/Klyroo.Table.Core/bin/$(Configuration)/net10.0/Klyroo.Table.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-table/src/Klyroo.Table/bin/$(Configuration)/net10.0/Klyroo.Table.xml" LogicalName="Klyroo.Table.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-table/src/Klyroo.Table/bin/$(Configuration)/net10.0/Klyroo.Table.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-form/src/Klyroo.Form.Core/bin/$(Configuration)/net10.0/Klyroo.Form.Core.xml" LogicalName="Klyroo.Form.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-form/src/Klyroo.Form.Core/bin/$(Configuration)/net10.0/Klyroo.Form.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-form/src/Klyroo.Form/bin/$(Configuration)/net10.0/Klyroo.Form.xml" LogicalName="Klyroo.Form.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-form/src/Klyroo.Form/bin/$(Configuration)/net10.0/Klyroo.Form.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-dashboard/src/Klyroo.Dashboard.Core/bin/$(Configuration)/net10.0/Klyroo.Dashboard.Core.xml" LogicalName="Klyroo.Dashboard.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-dashboard/src/Klyroo.Dashboard.Core/bin/$(Configuration)/net10.0/Klyroo.Dashboard.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-dashboard/src/Klyroo.Dashboard/bin/$(Configuration)/net10.0/Klyroo.Dashboard.xml" LogicalName="Klyroo.Dashboard.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-dashboard/src/Klyroo.Dashboard/bin/$(Configuration)/net10.0/Klyroo.Dashboard.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-display/src/Klyroo.Display.Core/bin/$(Configuration)/net10.0/Klyroo.Display.Core.xml" LogicalName="Klyroo.Display.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-display/src/Klyroo.Display.Core/bin/$(Configuration)/net10.0/Klyroo.Display.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-display/src/Klyroo.Display/bin/$(Configuration)/net10.0/Klyroo.Display.xml" LogicalName="Klyroo.Display.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-display/src/Klyroo.Display/bin/$(Configuration)/net10.0/Klyroo.Display.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-spreadsheet/src/Klyroo.Spreadsheet.Core/bin/$(Configuration)/net10.0/Klyroo.Spreadsheet.Core.xml" LogicalName="Klyroo.Spreadsheet.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-spreadsheet/src/Klyroo.Spreadsheet.Core/bin/$(Configuration)/net10.0/Klyroo.Spreadsheet.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-spreadsheet/src/Klyroo.Spreadsheet/bin/$(Configuration)/net10.0/Klyroo.Spreadsheet.xml" LogicalName="Klyroo.Spreadsheet.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-spreadsheet/src/Klyroo.Spreadsheet/bin/$(Configuration)/net10.0/Klyroo.Spreadsheet.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-agent/src/Klyroo.Agent.Core/bin/$(Configuration)/net10.0/Klyroo.Agent.Core.xml" LogicalName="Klyroo.Agent.Core.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-agent/src/Klyroo.Agent.Core/bin/$(Configuration)/net10.0/Klyroo.Agent.Core.xml')" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../klyroo-agent/src/Klyroo.Agent/bin/$(Configuration)/net10.0/Klyroo.Agent.xml" LogicalName="Klyroo.Agent.xml" Condition="Exists('$(MSBuildThisFileDirectory)../../../klyroo-agent/src/Klyroo.Agent/bin/$(Configuration)/net10.0/Klyroo.Agent.xml')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <!-- Unified Klyroo meta-package referencing klyroo-ui and all 7 klyroo-* repos directly -->
    <ProjectReference Include="..\..\src\Klyroo.Stack\Klyroo.Stack.csproj" />
    <ProjectReference Include="..\..\..\klyroo-ui\src\Klyroo.UI.Images\Klyroo.UI.Images.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\klyroo-ui\src\Klyroo.UI.Build.Tasks\Klyroo.UI.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <KlyrooBuildTasksAssembly>$(MSBuildThisFileDirectory)..\..\..\klyroo-ui\src\Klyroo.UI.Build.Tasks\bin\$(Configuration)\netstandard2.0\Klyroo.UI.Build.Tasks.dll</KlyrooBuildTasksAssembly>
  </PropertyGroup>
  <Import Project="..\..\..\klyroo-ui\src\Klyroo.UI\buildTransitive\Klyroo.UI.Tasks.targets" />
  <Import Project="..\..\..\klyroo-ui\src\Klyroo.UI\buildTransitive\Klyroo.UI.Icons.targets" />

  <ItemGroup>
    <KlyrooIconCollection Include="Assets\icons" Prefix="custom" />
    <KlyrooIcon Include="ph:cube;ph:cube-fill;ph:cube-bold" />
  </ItemGroup>

</Project>
