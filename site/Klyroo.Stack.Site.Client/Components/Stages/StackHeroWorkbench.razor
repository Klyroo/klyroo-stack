@namespace Klyroo.Stack.Site.Client.Components.Stages
@using Klyroo.Query

@* Drizzle-Resource inspired Klyroo Interactive Workbench: click any line in Program.cs or any library pill below to trace animated signal wires into Packages, Code, Targets, and a real live UI preview. *@
<div class="grid gap-6 xl:grid-cols-[minmax(0,0.96fr)_40px_minmax(0,1.24fr)] xl:items-stretch">
    @* Left: Interactive 14-Line Program.cs Definition *@
    <div class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg-overlay) dark:bg-(--klyroo-bg)">
        <div class="flex items-center justify-between gap-3 border-b border-(--klyroo-border) bg-(--klyroo-bg-muted)/50 px-4 py-3">
            <span class="font-mono text-xs font-medium text-(--klyroo-text-highlighted)">Program.cs</span>
            <span class="flex items-baseline gap-1.5 font-mono text-[11px] uppercase tracking-wider text-(--klyroo-text-muted)">
                <span class="font-pixel text-lg font-bold text-(--klyroo-primary-text)">14</span> lines
            </span>
        </div>

        <div class="flex-1 overflow-x-auto py-3 font-mono text-[12.5px] leading-6 text-(--klyroo-text)">
            @for (var i = 0; i < ProgramLines.Length; i++)
            {
                var line = ProgramLines[i];
                var active = line.Key == _activeKey;
                var clickable = line.Key is not null;
                <div class="@($"flex items-start px-3 transition-colors {(active ? "bg-(--klyroo-primary)/20 font-medium text-(--klyroo-text-highlighted) shadow-[inset_2px_0_0_var(--klyroo-primary)]" : "")} {(clickable ? "cursor-pointer hover:bg-(--klyroo-bg-muted)/70" : "")}")"
                     @onclick="@(() => { if (line.Key is not null) SelectKey(line.Key); })">
                    <span class="w-7 shrink-0 select-none pe-3 text-right text-[11px] tabular-nums text-(--klyroo-text-dimmed)">@(i + 1)</span>
                    <span class="whitespace-pre">@line.Text</span>
                </div>
            }
        </div>

        <div class="flex flex-wrap items-center gap-1.5 border-t border-(--klyroo-border) bg-(--klyroo-bg-muted)/40 px-4 py-3" role="tablist" aria-label="Select a Klyroo library">
            @foreach (var item in Capabilities)
            {
                var selected = _activeKey == item.Key;
                <button type="button"
                        role="tab"
                        aria-selected="@selected"
                        class="@($"inline-flex min-h-7 items-center rounded-md border px-2.5 py-1 font-mono text-xs transition-all {(selected ? "border-(--klyroo-primary) bg-(--klyroo-primary) font-semibold text-(--klyroo-primary-contrast)" : "border-(--klyroo-border) bg-(--klyroo-bg) text-(--klyroo-text-muted) hover:border-(--klyroo-border-accented) hover:text-(--klyroo-text-highlighted)")}")"
                        @onclick="@(() => SelectKey(item.Key))">
                    @item.Key
                </button>
            }
        </div>
    </div>

    @* Center: Animated Golden Dashed Signal Wires (Desktop) *@
    <div class="relative hidden xl:flex items-center justify-center" aria-hidden="true">
        <svg class="h-full w-10 overflow-visible" viewBox="0 0 40 420" preserveAspectRatio="none" fill="none">
            <path d="M 0 @ActiveCap.SourceY C 20 @ActiveCap.SourceY, 20 105, 40 105" stroke="var(--klyroo-primary-text)" stroke-width="1.6" class="lib-wire-flow" />
            <path d="M 0 @ActiveCap.SourceY C 20 @ActiveCap.SourceY, 20 315, 40 315" stroke="var(--klyroo-primary-text)" stroke-width="1.6" class="lib-wire-flow" />
            <rect x="-3" y="@(ActiveCap.SourceY - 3)" width="6" height="6" rx="1" fill="var(--klyroo-primary)" stroke="var(--klyroo-primary-text)" stroke-width="1" />
            <rect x="37" y="102" width="6" height="6" rx="1" fill="var(--klyroo-primary)" stroke="var(--klyroo-primary-text)" stroke-width="1" />
            <rect x="37" y="312" width="6" height="6" rx="1" fill="var(--klyroo-primary)" stroke="var(--klyroo-primary-text)" stroke-width="1" />
        </svg>
    </div>

    @* Right: 4 Synchronized Live Ecosystem Output Panels *@
    <div class="grid min-w-0 gap-4 sm:grid-cols-2">
        @* 1. Packages It Wires *@
        <div class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg-overlay) dark:bg-(--klyroo-bg)">
            <div class="flex items-center justify-between gap-2 border-b border-(--klyroo-border) bg-(--klyroo-bg-muted)/50 px-3.5 py-2.5 font-mono text-[11px]">
                <span class="flex items-center gap-1.5 font-semibold uppercase tracking-wider text-(--klyroo-text-highlighted)">
                    <span class="size-1.5 rounded-xs bg-(--klyroo-primary)"></span>
                    Packages it wires
                </span>
                <span class="text-(--klyroo-text-muted)">NativeAOT · MIT</span>
            </div>
            <div class="flex flex-1 flex-col justify-between p-3.5 font-mono text-xs">
                <dl class="space-y-2">
                    <div class="flex items-center justify-between gap-2 rounded-lg bg-(--klyroo-primary)/15 px-2.5 py-1.5">
                        <dt class="text-(--klyroo-text-muted)">Core</dt>
                        <dd class="truncate font-semibold text-(--klyroo-text-highlighted)">@ActiveCap.CorePkg</dd>
                    </div>
                    <div class="flex items-center justify-between gap-2 rounded-lg border border-(--klyroo-border) px-2.5 py-1.5">
                        <dt class="text-(--klyroo-text-muted)">UI</dt>
                        <dd class="truncate font-semibold text-(--klyroo-text-highlighted)">@ActiveCap.UiPkg</dd>
                    </div>
                    <div class="flex items-center justify-between gap-2 px-2.5 py-1 text-[11px] text-(--klyroo-text-muted)">
                        <dt>CSS</dt>
                        <dd class="truncate text-(--klyroo-text)">@ActiveCap.CssBundle</dd>
                    </div>
                </dl>
                <div class="mt-3 flex items-center justify-between gap-2 border-t border-(--klyroo-border) pt-2.5 text-[11px]">
                    <span class="text-(--klyroo-text-muted)">@ActiveCap.StatNote</span>
                    <a href="@($"/{ActiveCap.Key}")" class="inline-flex min-h-6 items-center gap-1 font-semibold text-(--klyroo-primary-text) hover:underline">
                        <span>Explore</span>
                        <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                    </a>
                </div>
            </div>
        </div>

        @* 2. Code It Unlocks *@
        <div class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg-overlay) dark:bg-(--klyroo-bg)">
            <div class="flex items-center justify-between gap-2 border-b border-(--klyroo-border) bg-(--klyroo-bg-muted)/50 px-3.5 py-2.5 font-mono text-[11px]">
                <span class="flex items-center gap-1.5 font-semibold uppercase tracking-wider text-(--klyroo-text-highlighted)">
                    <span class="size-1.5 rounded-xs bg-(--klyroo-primary)"></span>
                    Code it unlocks
                </span>
                <span class="text-(--klyroo-text-muted)">.NET 10 · C#</span>
            </div>
            <pre @key="_activeKey" class="lib-flash flex-1 overflow-x-auto bg-(--pg-code-bg) p-3.5 font-mono text-[11.5px] leading-5 text-[#d7dcde]"><code>@ActiveCap.Snippet</code></pre>
        </div>

        @* 3. Targets It Runs On *@
        <div class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg-overlay) dark:bg-(--klyroo-bg)">
            <div class="flex items-center justify-between gap-2 border-b border-(--klyroo-border) bg-(--klyroo-bg-muted)/50 px-3.5 py-2.5 font-mono text-[11px]">
                <span class="flex items-center gap-1.5 font-semibold uppercase tracking-wider text-(--klyroo-text-highlighted)">
                    <span class="size-1.5 rounded-xs bg-(--klyroo-primary)"></span>
                    Targets it runs on
                </span>
                <span class="text-(--klyroo-text-muted)">1 codebase</span>
            </div>
            <div class="flex flex-1 flex-col justify-between p-3.5">
                <div class="grid grid-cols-2 gap-1.5 font-mono text-[11px]">
                    @foreach (var target in AllTargets)
                    {
                        var supported = ActiveCap.Targets.Contains(target);
                        <div class="@($"flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 transition-colors {(supported ? "border-(--klyroo-border-accented) bg-(--klyroo-bg-muted)/70 font-medium text-(--klyroo-text-highlighted)" : "border-(--klyroo-border)/60 text-(--klyroo-text-dimmed) opacity-60")}")">
                            <span class="@($"size-1.5 shrink-0 rounded-full {(supported ? "bg-emerald-500" : "bg-(--klyroo-border-accented)")}")" aria-hidden="true"></span>
                            <span class="truncate">@target</span>
                        </div>
                    }
                </div>
                <p class="mt-3 font-mono text-[11px] text-(--klyroo-text-muted)">
                    @ActiveCap.TargetSummary
                </p>
            </div>
        </div>

        @* 4. Live UI It Powers *@
        <div class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg-overlay) dark:bg-(--klyroo-bg)">
            <div class="flex items-center justify-between gap-2 border-b border-(--klyroo-border) bg-(--klyroo-bg-muted)/50 px-3.5 py-2.5 font-mono text-[11px]">
                <span class="flex items-center gap-1.5 font-semibold uppercase tracking-wider text-(--klyroo-text-highlighted)">
                    <span class="size-1.5 rounded-full bg-emerald-500 lib-pulse-dot"></span>
                    UI it powers
                </span>
                <span class="text-(--klyroo-text-muted)">live Blazor</span>
            </div>

            <div @key="@($"ui-{_activeKey}")" class="lib-flash flex flex-1 flex-col justify-between p-3.5">
                @switch (_activeKey)
                {
                    case "ui":
                        <div class="space-y-3">
                            <div class="flex flex-wrap items-center gap-2">
                                <KlyButton Label="Deploy" Size="KlySize.Sm" OnClick="@(() => _uiClicks++)" />
                                <KlyButton Label="Outline" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => _uiClicks = 0)" />
                                <KlyBadge Label="@($"{_uiClicks} clicks")" Color="KlyColor.Success" Variant="KlyVariant.Subtle" Size="KlySize.Sm" />
                            </div>
                            <KlySwitch Value="@_zeroLag" ValueChanged="@(v => _zeroLag = v)" Label="Native Popover & <dialog> top-layer" Size="KlySize.Sm" />
                        </div>
                        <p class="mt-2 font-mono text-[11px] text-(--klyroo-text-muted)">133 primitives · 60fps browser behaviors</p>
                        break;

                    case "query":
                        <div class="space-y-2">
                            <div class="flex items-center gap-2">
                                <div class="min-w-0 flex-1">
                                    <KlyInput Value="@_qSearch" ValueChanged="@(v => _qSearch = v)" Placeholder="Filter orders..." aria-label="Filter mini query" Size="KlySize.Sm" />
                                </div>
                                <span class="shrink-0 font-mono text-[11px] tabular-nums text-(--klyroo-primary-text)">@MiniQueryRows.Count rows</span>
                            </div>
                            <ul class="divide-y divide-(--klyroo-border) font-mono text-[11.5px]">
                                @foreach (var row in MiniQueryRows.Take(3))
                                {
                                    <li class="flex items-center justify-between py-1">
                                        <span class="truncate text-(--klyroo-text-highlighted)">@row.Name</span>
                                        <span class="tabular-nums text-(--klyroo-text-muted)">€@row.Arr.ToString("N0")</span>
                                    </li>
                                }
                            </ul>
                        </div>
                        break;

                    case "table":
                        <div class="space-y-2 font-mono text-[11.5px]">
                            <div class="flex items-center justify-between text-(--klyroo-text-muted)">
                                <span>KlyDataList · Grouped</span>
                                <span class="font-semibold tabular-nums text-(--klyroo-text-highlighted)">SUM €340,000</span>
                            </div>
                            <div class="divide-y divide-(--klyroo-border) rounded-lg border border-(--klyroo-border)">
                                <div class="flex justify-between px-2.5 py-1.5"><span class="text-(--klyroo-text-highlighted)">Helios Cloud</span><span class="tabular-nums text-(--klyroo-primary-text)">€148,000</span></div>
                                <div class="flex justify-between px-2.5 py-1.5"><span class="text-(--klyroo-text-highlighted)">Northwind</span><span class="tabular-nums text-(--klyroo-primary-text)">€192,000</span></div>
                            </div>
                        </div>
                        break;

                    case "form":
                        <div class="space-y-2.5 text-xs">
                            <div class="flex items-center justify-between gap-2">
                                <span class="font-medium text-(--klyroo-text-highlighted)">Region = EU</span>
                                <KlySwitch Value="@_euVat" ValueChanged="@(v => _euVat = v)" Label="Toggle" Size="KlySize.Sm" />
                            </div>
                            <div class="rounded-lg border border-(--klyroo-border) bg-(--klyroo-bg-muted)/50 px-3 py-2 font-mono text-[11px]">
                                @if (_euVat)
                                {
                                    <span class="text-(--klyroo-success-text)">VAT ID visible &amp; required · dirty=true</span>
                                }
                                else
                                {
                                    <span class="text-(--klyroo-text-muted)">VAT ID hidden &amp; skipped by FormController</span>
                                }
                            </div>
                        </div>
                        break;

                    case "dashboard":
                        <div class="space-y-2.5">
                            <div class="flex items-baseline justify-between">
                                <span class="text-xs text-(--klyroo-text-muted)">Annual ARR Attainment</span>
                                <span class="font-mono text-sm font-bold tabular-nums text-(--klyroo-text-highlighted)">79.7% <span class="text-xs font-semibold text-(--klyroo-success-text)">+16.4%</span></span>
                            </div>
                            <div class="h-2 w-full overflow-hidden rounded-full bg-(--klyroo-bg-muted)" role="progressbar" aria-label="ARR Attainment" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100">
                                <div class="h-full w-4/5 rounded-full bg-(--klyroo-primary)"></div>
                            </div>
                            <p class="font-mono text-[11px] text-(--klyroo-text-muted)">Wave 1 Essential: 12 ms · Wave 2: 44 ms</p>
                        </div>
                        break;

                    case "display":
                        <div class="space-y-2 font-mono text-xs">
                            <div class="flex items-center justify-between gap-2 rounded-lg border border-(--klyroo-border) bg-(--klyroo-bg-muted)/50 px-3 py-2">
                                <span class="truncate text-(--klyroo-text-highlighted)">@(_revealSecret ? "sk_live_klyroo_9981" : "••••••••••••9981")</span>
                                <button type="button" class="inline-flex min-h-6 items-center rounded px-2 text-[11px] font-semibold text-(--klyroo-primary-text) hover:underline" @onclick="@(() => _revealSecret = !_revealSecret)">
                                    @(_revealSecret ? "Hide" : "Reveal")
                                </button>
                            </div>
                            <p class="text-[11px] text-(--klyroo-text-muted)">19 read-only blocks + CSV/PDF lightbox</p>
                        </div>
                        break;

                    case "spreadsheet":
                        <div class="space-y-2 font-mono text-[11.5px]">
                            <div class="rounded-lg bg-(--pg-code-bg) px-2.5 py-2 text-[#d7dcde]">
                                <div class="line-through opacity-50">Export 2026;; ← banner skipped</div>
                                <div><span class="text-emerald-400">Nom;Région;Revenu</span> → NFD mapped</div>
                            </div>
                            <p class="text-[11px] text-(--klyroo-text-muted)">10k rows NFD + dedup: <strong class="text-(--klyroo-text-highlighted)">38.0 ms</strong></p>
                        </div>
                        break;

                    case "agent":
                        <div class="space-y-2 font-mono text-[11.5px]">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-(--klyroo-text-muted)">c1 · Project</span>
                                <span class="font-semibold text-(--klyroo-text-highlighted)">@_agentProject</span>
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-(--klyroo-text-muted)">c2 · Secret</span>
                                <span class="rounded bg-emerald-500/15 px-1.5 py-0.5 text-(--klyroo-success-text)">[redacted]</span>
                            </div>
                            <button type="button" class="inline-flex min-h-7 items-center rounded-md border border-(--klyroo-border-accented) bg-(--klyroo-bg-muted)/50 px-2.5 py-1 text-[11px] font-medium text-(--klyroo-text-highlighted) hover:border-(--klyroo-primary-text)"
                                    @onclick="@(() => _agentProject = _agentProject == "Apollo" ? "Atlas" : "Apollo")">
                                Run Agent ActAsync →
                            </button>
                        </div>
                        break;
                }
            </div>
        </div>
    </div>
</div>

@code {
    private sealed record CapabilitySpec(
        string Key,
        int SourceY,
        string CorePkg,
        string UiPkg,
        string CssBundle,
        string StatNote,
        string Snippet,
        string[] Targets,
        string TargetSummary);

    private sealed record MiniOrder(string Name, decimal Arr);

    private static readonly string[] AllTargets =
    [
        "Static SSR",
        "Blazor Server",
        "WebAssembly",
        ".NET MAUI Hybrid",
        "NativeAOT API",
        "MCP / AI Agents"
    ];

    private static readonly (string Text, string? Key)[] ProgramLines =
    [
        ("var builder = WebApplication.CreateBuilder(args);", null),
        ("builder.Services.AddKlyrooStack(kly => kly", null),
        ("  .UseUi(o => o.ZeroRoundtripBehaviors = true)", "ui"),
        ("  .UseQuery(q => q.WithEfCoreAsyncExecutor())", "query"),
        ("  .UseTable(t => t.EnableTreeAndSummaries())", "table"),
        ("  .UseForm(f => f.EnableDrawerAndModalShells())", "form"),
        ("  .UseDashboard(d => d.UseThreeWaveStages())", "dashboard"),
        ("  .UseDisplay(d => d.EnableFileLightbox())", "display"),
        ("  .UseSpreadsheet(s => s.EnableNfdAutoMap())", "spreadsheet"),
        ("  .UseAgent(a => a.ConfirmSubmit = true)", "agent"),
        (");", null),
        ("var app = builder.Build();", null),
        ("app.MapKlyrooAi(); // llms.txt + MCP docs", "agent"),
        ("app.Run();", null),
    ];

    private static readonly CapabilitySpec[] Capabilities =
    [
        new("ui", 90, "Klyroo.UI.Build.Tasks", "Klyroo.UI", "klyroo.css / Tailwind v4", "133 accessible primitives",
            "<KlyModal Title=\"Deploy\">\n  <ChildContent><KlyButton Label=\"Open\" /></ChildContent>\n  <Body><KlySelect @bind-Value=\"_env\" /></Body>\n</KlyModal>",
            ["Static SSR", "Blazor Server", "WebAssembly", ".NET MAUI Hybrid"],
            "Zero-roundtrip popovers, dialogs & roving focus."),
        new("query", 114, "Klyroo.Query.Core", "Klyroo.Query", "Headless (0 CSS)", "100k rows in 16.5 ms",
            "var schema = DataListSchema.For<Order>(s => s\n  .RowKey(o => o.Id)\n  .Search(o => o.Customer)\n  .Field(o => o.Arr, f => f.Sortable()));",
            ["Static SSR", "Blazor Server", "WebAssembly", ".NET MAUI Hybrid", "NativeAOT API"],
            "Runs in Minimal APIs, EF Core SQL & Blazor URLs."),
        new("table", 138, "Klyroo.Table.Core", "Klyroo.Table", "klyroo-table.css", "Tree + GroupBy + Sum",
            "<KlyDataList Schema=\"@Schema\" Items=\"@Rows\">\n  <KlyDataListTable HeaderMenu=\"true\" GroupBy=\"@ByRegion\">\n    <KlyDataListFieldColumn Field=\"arr\" Summary=\"Sum\" />\n  </KlyDataListTable>\n</KlyDataList>",
            ["Static SSR", "Blazor Server", "WebAssembly", ".NET MAUI Hybrid", "NativeAOT API"],
            "NativeAOT tree hierarchy + 60fps virtualization."),
        new("form", 162, "Klyroo.Form.Core", "Klyroo.Form", "klyroo-form.css", "Reactive conditions + diff",
            "s.Field(m => m.Vat, f => f\n  .Label(\"EU VAT ID\")\n  .VisibleWhen(c => c.Get(region) == \"EU\")\n  .Required(c => c.Get(region) == \"EU\"));",
            ["Blazor Server", "WebAssembly", ".NET MAUI Hybrid", "NativeAOT API", "MCP / AI Agents"],
            "One FormSchema<TModel> renders as Page, Modal, or Drawer."),
        new("dashboard", 186, "Klyroo.Dashboard.Core", "Klyroo.Dashboard", "klyroo-dashboard.css", "3-wave staged loading",
            "dashboard.RegisterResource(kpis, Essential);\ndashboard.RegisterResource(charts, Background);\ndashboard.RegisterResource(export, Deferred);",
            ["Blazor Server", "WebAssembly", ".NET MAUI Hybrid", "NativeAOT API", "MCP / AI Agents"],
            "Essential KPIs render first; CSV exports on demand."),
        new("display", 210, "Klyroo.Display.Core", "Klyroo.Display", "klyroo-display.css", "19 blocks + Lightbox",
            "<KlyDisplay Kind=\"DisplayKind.Code\"\n           Variant=\"DisplayVariant.Secret\"\n           Value=\"@apiKey\" VisibleChars=\"4\" Copy=\"true\" />",
            ["Static SSR", "Blazor Server", "WebAssembly", ".NET MAUI Hybrid", "NativeAOT API"],
            "Facts, meters, diffs, constrained media & lightbox."),
        new("spreadsheet", 234, "Klyroo.Spreadsheet.Core", "Klyroo.Spreadsheet", "klyroo-spreadsheet.css", "10k CSV rows in 38.0 ms",
            "var importer = new SpreadsheetImporter<RateRow>(schema);\nimporter.LoadText(csv, \"tarifs.csv\");\n// 20-row header scan + NFD + 80% auto-map",
            ["Blazor Server", "WebAssembly", ".NET MAUI Hybrid", "NativeAOT API", "MCP / AI Agents"],
            "Turns dirty European CSVs into validated batches."),
        new("agent", 258, "Klyroo.Agent.Core", "Klyroo.Agent", "klyroo-agent.js (WebMCP)", "AllowPolicy + [redacted]",
            "agent.RegisterForm(form, confirmSubmit: true);\nagent.RegisterDashboard(dashboard);\nawait agent.ActAsync([new(\"Project\", \"setValue\", [\"Atlas\"])]);",
            ["Blazor Server", "WebAssembly", ".NET MAUI Hybrid", "NativeAOT API", "MCP / AI Agents"],
            "Semantic Snapshot/Query/Act without CSS selectors."),
    ];

    private static readonly MiniOrder[] SampleOrders =
    [
        new("Helios Cloud SAS", 148000m),
        new("Northwind Robotics", 192000m),
        new("Sakura BioLabs", 118000m),
        new("Kestrel FinTech", 64000m),
    ];

    private string _activeKey = "query";
    private int _uiClicks = 1;
    private bool _zeroLag = true;
    private string _qSearch = "";
    private bool _euVat = true;
    private bool _revealSecret;
    private string _agentProject = "Apollo";

    private CapabilitySpec ActiveCap => Capabilities.First(c => c.Key == _activeKey);

    private IReadOnlyList<MiniOrder> MiniQueryRows =>
        string.IsNullOrWhiteSpace(_qSearch)
            ? SampleOrders
            : SampleOrders.Where(o => o.Name.Contains(_qSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private void SelectKey(string key) => _activeKey = key;
}
