@namespace Klyroo.Stack.Site.Client.Components.Stages
@using Klyroo.Display
@inject FilePreviewService FilePreview

@* Display stage: highlighted code with line numbers and emphasized lines, a masked secret, a file list that opens the preview, and a constrained audio player. *@
<div class="overflow-hidden rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg)">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-(--klyroo-border) bg-(--klyroo-bg-muted)/50 px-5 py-3">
        <div class="flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Display stage views">
            @foreach (var tab in Tabs)
            {
                var active = _tab == tab.Key;
                <button type="button"
                        role="tab"
                        aria-selected="@active"
                        class="@($"inline-flex min-h-7 items-center rounded-md border px-2.5 py-1 font-mono text-xs transition-colors {(active ? "font-semibold" : "border-(--klyroo-border) bg-(--klyroo-bg) text-(--klyroo-text-muted) hover:text-(--klyroo-text-highlighted)")}")"
                        style="@(active ? "background:var(--lib-pill-bg);border-color:var(--lib-pill-bg);color:#ffffff" : null)"
                        @onclick="@(() => _tab = tab.Key)">
                    @tab.Label
                </button>
            }
        </div>
        <button type="button"
                class="inline-flex min-h-7 items-center gap-1.5 rounded-md border border-(--klyroo-border) bg-(--klyroo-bg) px-3 py-1 font-mono text-xs text-(--klyroo-text-highlighted) hover:border-(--klyroo-border-accented)"
                @onclick="OpenLightbox">
            <span class="size-1.5 rounded-full lib-pulse-dot" style="background:var(--lib-accent)"></span>
            Open CSV Lightbox
        </button>
    </div>

    <div class="p-6">
        @if (_tab == "code")
        {
            <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
                <KlyCodeBlock Label="Orders.sql"
                              Code="@Query"
                              Language="CodeLanguage.Sql"
                              LineNumbers
                              HighlightLines="@_highlight" />
                <div class="flex flex-col gap-3 rounded-xl border border-(--klyroo-border) bg-(--klyroo-bg-muted)/30 p-4">
                    <span class="font-mono text-xs font-medium text-(--klyroo-text-highlighted)">Emphasized lines</span>
                    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Emphasized lines">
                        @foreach (var focus in Focuses)
                        {
                            var active = _focus == focus.Key;
                            <button type="button"
                                    aria-pressed="@active"
                                    class="@($"inline-flex min-h-7 items-center rounded-md border px-2.5 py-1 font-mono text-xs transition-colors {(active ? "font-semibold" : "border-(--klyroo-border) bg-(--klyroo-bg) text-(--klyroo-text-muted) hover:text-(--klyroo-text-highlighted)")}")"
                                    style="@(active ? "background:var(--lib-pill-bg);border-color:var(--lib-pill-bg);color:#ffffff" : null)"
                                    @onclick="@(() => Focus(focus.Key))">
                                @focus.Label
                            </button>
                        }
                    </div>
                    <p class="text-xs leading-relaxed text-(--klyroo-text-muted)">
                        <code>HighlightLines</code> takes line numbers and <code>CodeLineRange</code> values. The text, the selection and the copy button still give the code as it is.
                    </p>
                </div>
            </div>
        }
        else if (_tab == "vault")
        {
            <div class="grid gap-6 lg:grid-cols-2">
                <div class="flex flex-col gap-4">
                    <KlySecretBlock Label="Production Webhook Secret"
                                    Value="sk_live_klyroo_9981_vault"
                                    VisibleChars="4" />
                    <KlyAlert Color="KlyColor.Info"
                              Variant="KlyVariant.Soft"
                              Title="Masked in the page"
                              Description="While the secret is masked, only the bullets and the last characters are in the markup. The copy button still copies the whole value." />
                </div>
                <div class="flex flex-col gap-4">
                    <KlyFileList Title="Deployment files" Files="_files" />
                    <button type="button"
                            class="inline-flex min-h-7 items-center gap-1.5 self-start rounded-md border border-(--klyroo-border) bg-(--klyroo-bg) px-3 py-1 font-mono text-xs text-(--klyroo-text-highlighted) hover:border-(--klyroo-border-accented)"
                            @onclick="OpenLightbox">
                        Open CSV Lightbox
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="grid gap-6 lg:grid-cols-2">
                <KlyAudioPlayer Src="/media/sample.mp3"
                               Title="Certification Audio Clip (10s-40s, MaxPlays=2, Seek Locked)"
                               Start="10" End="40" MaxPlays="2" Seekable="false" />
                <KlyAlert Color="KlyColor.Neutral"
                          Variant="KlyVariant.Outline"
                          Title="Constrained Assessment Playback"
                          Description="Start and End clip slicing, MaxPlays play quotas, subtitle tracks and Seekable=false locking are modeled by Klyroo.Display and enforced in the browser." />
            </div>
        }
    </div>
</div>

@code {
    private static readonly (string Key, string Label)[] Tabs =
    [
        ("code", "Code & Lines"),
        ("vault", "Secrets & Files"),
        ("media", "Constrained Media"),
    ];

    private static readonly (string Key, string Label)[] Focuses =
    [
        ("where", "WHERE clause"),
        ("select", "SELECT list"),
        ("none", "None"),
    ];

    private const string Query = "SELECT o.id, o.total, c.name\nFROM orders AS o\nJOIN customers AS c ON c.id = o.customer_id\nWHERE o.status = 'paid'\n  AND o.total > 100\n  AND o.shipped_at IS NULL\nORDER BY o.total DESC;\n";

    private readonly IReadOnlyList<FileListItem> _files =
    [
        new FileListItem(new FilePreviewFile { Src = "/media/deploy-notes.md", Name = "deploy-notes.md", Size = 2_480, Content = "# Deploy notes\n\nRolled out to eu-west-3." }, Description: "Release v0.1.0-preview.1"),
        new FileListItem(new FilePreviewFile { Src = "klyroo-display-sample.csv", Name = "klyroo-display-sample.csv", Mime = "text/csv", Size = 188, Content = SampleCsv }, Meta: "Updated today", Icon: "table", Tone: KlyColor.Success),
    ];

    private const string SampleCsv = "Library,Core Assembly,Size KB,NativeAOT\nKlyroo.Display,Klyroo.Display.Core,58,true\nKlyroo.Query,Klyroo.Query.Core,68,true\nKlyroo.Agent,Klyroo.Agent.Core,42,true";

    private string _tab = "code";
    private string _focus = "where";
    private IReadOnlyList<CodeLineRange> _highlight = [new CodeLineRange(4, 6)];

    private void Focus(string key)
    {
        _focus = key;
        _highlight = key switch
        {
            "where" => [new CodeLineRange(4, 6)],
            "select" => [new CodeLineRange(1, 1)],
            _ => [],
        };
    }

    private void OpenLightbox()
    {
        FilePreview.Open(new FilePreviewFile
        {
            Src = "klyroo-display-sample.csv",
            Name = "klyroo-display-sample.csv",
            Mime = "text/csv",
            Content = SampleCsv
        });
    }
}
