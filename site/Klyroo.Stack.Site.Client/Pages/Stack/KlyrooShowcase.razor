@page "/showcase"
@using System.Globalization
@using System.Text.Json
@using Klyroo.UI
@using Klyroo.Query
@using Klyroo.Table
@using Klyroo.Form
@using Klyroo.Dashboard
@using Klyroo.Display
@using Klyroo.Spreadsheet
@using Klyroo.Agent
@inject FormService FormService
@inject FilePreviewService FilePreview
@implements IDisposable

<PageTitle>Revenue Ops Backoffice · Klyroo Showcase</PageTitle>

<div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-10 sm:px-6 lg:px-8">
    @* Header *@
    <div class="flex flex-col gap-5 border-b border-(--klyroo-border) pb-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <h1 class="text-3xl font-semibold tracking-[-0.03em] text-(--klyroo-text-highlighted) sm:text-5xl">
                Revenue Ops <span class="pg-accent">Backoffice.</span>
            </h1>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-(--klyroo-text-muted)">
                All 8 Klyroo libraries working together in one workspace: <strong>Klyroo.Dashboard</strong> (3-wave KPIs), <strong>Klyroo.Query</strong> + <strong>Klyroo.Table</strong> (schema-driven grid),
                <strong>Klyroo.Form</strong> (reactive drawer CRUD), <strong>Klyroo.Spreadsheet</strong> (CSV import), <strong>Klyroo.Display</strong> (inspector &amp; lightbox),
                <strong>Klyroo.Agent</strong> (copilot with AllowPolicy &amp; UndoStack), and <strong>Klyroo.UI</strong>.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <KlyButton Label="New Account" Size="KlySize.Md" OnClick="@OpenCreateAccountDrawerAsync" />
            <KlyButton Label="Preview CSV" Size="KlySize.Md" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@OpenCsvLightbox" />
            <KlyButton Label="@(_showAgent ? "Hide Copilot" : "Open Copilot")" Size="KlySize.Md" Color="KlyColor.Primary" Variant="ButtonVariant.Soft" OnClick="@(() => _showAgent = !_showAgent)" />
        </div>
    </div>

    @* Workspace Navigation Tabs & Shared Region Filter *@
    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
        <div role="tablist" aria-label="Backoffice views" class="flex flex-wrap items-center gap-2">
            @foreach (var tab in new[] { ("overview", "Overview"), ("accounts", "Accounts"), ("import", "Bulk Import"), ("inspector", "Inspector") })
            {
                var isSelected = _activeTab == tab.Item1;
                <KlyButton Label="@tab.Item2"
                          Size="KlySize.Sm"
                          role="tab"
                          aria-selected="@(isSelected ? "true" : "false")"
                          Color="@(isSelected ? KlyColor.Primary : KlyColor.Neutral)"
                          Variant="@(isSelected ? ButtonVariant.Solid : ButtonVariant.Outline)"
                          OnClick="@(() => SwitchTab(tab.Item1))" />
            }
        </div>
        <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-medium text-(--klyroo-text-muted)">Regions:</span>
            @foreach (var r in new[] { "EU", "US", "APAC" })
            {
                var active = _regionFilter.Values.Contains(r);
                <KlyButton Label="@r" Size="KlySize.Xs" Color="@(active ? KlyColor.Primary : KlyColor.Neutral)" Variant="@(active ? ButtonVariant.Solid : ButtonVariant.Soft)" OnClick="@(() => ToggleRegion(r))" />
            }
            @if (_dashboard.Filtered)
            {
                <KlyButton Label="Reset" Size="KlySize.Xs" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" OnClick="@ResetAllFilters" />
            }
            <KlyBadge Label="@FormatAccountSummary()" Color="KlyColor.Neutral" Variant="KlyVariant.Subtle" Size="KlySize.Sm" />
        </div>
    </div>

    <div class="@(_showAgent ? "mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px]" : "mt-6")">
        @* Main Workspace *@
        <div class="min-w-0 space-y-6">
            <h2 class="sr-only">Workspace</h2>
            @if (_activeTab == "overview")
            {
                <KlyDashboardStats Title="Executive Metrics" Items="@BuildStats()" Span="1" />

                <div class="grid gap-6 lg:grid-cols-2">
                    <KlyDashboardGauge Title="Annual Target Attainment"
                                      Value="@Math.Min(100, Math.Round((double)FilteredAccounts.Sum(a => a.Arr) / 750_000.0 * 100.0, 1))"
                                      Max="100" Target="85" Span="1"
                                      Format="DashboardFormatPreset.Percent"
                                      Caption="@($"€{FilteredAccounts.Sum(a => a.Arr) / 1000m:0}k / €750k")" />
                    <KlyDashboardBars Title="ARR by Region" Items="@BuildRegionBars()" Span="1" Format="DashboardFormatPreset.Compact" />
                </div>

                <div class="grid gap-6 lg:grid-cols-2">
                    <KlyDashboardAlerts Title="Operational Alerts" Span="1" Items="@([
                        new DashboardAlertItem(DashboardAlertSeverity.Warning, $"{_accounts.Count(a => a.Status == "At Risk")} accounts flagged At Risk", "Open Accounts to filter and inspect churn risk."),
                        new DashboardAlertItem(DashboardAlertSeverity.Success, $"3-Wave DashboardController · Essential: {_kpiWave.State}", "Filters stay synchronized across Dashboard, Table, and AgentBridge.")
                    ])" />
                    <div class="flex flex-col justify-between rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-5">
                        <div>
                            <h2 class="text-sm font-semibold text-(--klyroo-text-highlighted)">Live URL Query State</h2>
                            <p class="mt-1 text-xs text-(--klyroo-text-muted)">Generated by <code class="font-mono">DataListStateQuery.ToQuery</code> as filters change.</p>
                            <code class="mt-3 block break-all rounded-lg bg-(--pg-code-bg) p-3 font-mono text-xs text-(--klyroo-primary)">@BuildLiveQueryUrl()</code>
                        </div>
                        <div class="mt-4 flex flex-wrap gap-2">
                            <KlyButton Label="Inspect Accounts" Size="KlySize.Sm" OnClick="@(() => SwitchTab("accounts"))">
                                <TrailingIcon><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
                            </KlyButton>
                            <KlyButton Label="Refresh KPIs" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => _dashboard.RefreshAsync())" />
                        </div>
                    </div>
                </div>
            }
            else if (_activeTab == "accounts")
            {
                <div class="space-y-4 rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-5">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex flex-wrap items-center gap-2">
                            <div class="w-full sm:w-64">
                                <KlyInput Value="@_search" ValueChanged="@(v => _search = v)" Placeholder="Search accounts..." aria-label="Search accounts" />
                            </div>
                            <KlyButton Label="@(_groupByRegion ? "Grouped by region" : "Group by region")" Size="KlySize.Sm" Color="@(_groupByRegion ? KlyColor.Primary : KlyColor.Neutral)" Variant="@(_groupByRegion ? ButtonVariant.Soft : ButtonVariant.Outline)" OnClick="@(() => _groupByRegion = !_groupByRegion)" />
                            <KlyButton Label="Undo" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Soft" Disabled="@(!_history.CanUndo)" OnClick="@UndoAccounts" />
                            <KlyButton Label="Redo" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" Disabled="@(!_history.CanRedo)" OnClick="@RedoAccounts" />
                        </div>
                        <span class="font-mono text-xs tabular-nums text-(--klyroo-text-muted)">@FilteredAccounts.Count / @_accounts.Count shown</span>
                    </div>

                    @if (FilteredAccounts.Count == 0)
                    {
                        <KlyDisplay Kind="DisplayKind.Empty"
                                   Title="No matching accounts"
                                   Description="No accounts match the active region filter and search query." />
                        <div class="flex justify-center pb-2">
                            <KlyButton Label="Reset filters" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ResetAllFilters" />
                        </div>
                    }
                    else
                    {
                        <KlyDataList TItem="AccountRecord" Schema="@AccountSchema" Items="@FilteredAccounts" UrlSync="false">
                            <KlyDataListTable TItem="AccountRecord"
                                             HeaderMenu="true"
                                             ShowProgressLine="true"
                                             GroupBy="@(_groupByRegion ? AccountGroupBy : null)"
                                             Summaries="@(new DataListSummaries<AccountRecord>())">
                                <KlyDataListColumn TItem="AccountRecord" Field="name" Title="Account" />
                                <KlyDataListColumn TItem="AccountRecord" Field="region" Title="Region" />
                                <KlyDataListColumn TItem="AccountRecord" Field="plan" Title="Plan" />
                                <KlyDataListColumn TItem="AccountRecord" Field="status" Title="Status" />
                                <KlyDataListColumn TItem="AccountRecord" Field="arr" Title="ARR (€)" Summary="DataListSummaryKind.Sum" />
                            </KlyDataListTable>
                        </KlyDataList>
                    }
                </div>
            }
            else if (_activeTab == "import")
            {
                <div class="space-y-4 rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-5">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="text-sm text-(--klyroo-text-muted)">
                            Preloaded with European semicolon CSV and accented headers (<code class="font-mono">Nom;Région;Offre;Revenu</code>). Complete the wizard to append accounts into the live backoffice.
                        </p>
                        @if (_importedNotice is not null)
                        {
                            <KlyBadge Label="@_importedNotice" Color="KlyColor.Success" Variant="KlyVariant.Soft" Size="KlySize.Sm" />
                        }
                    </div>
                    <KlySpreadsheetImport Importer="@_importer" Title="Import New Accounts" Wizard="true" />
                </div>
            }
            else if (_activeTab == "inspector")
            {
                var selected = FilteredAccounts.FirstOrDefault();
                @if (selected is null)
                {
                    <div class="rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-6 text-center">
                        <KlyDisplay Kind="DisplayKind.Empty"
                                   Title="No account selected"
                                   Description="Reset your filters to inspect an active customer dossier." />
                        <div class="mt-4">
                            <KlyButton Label="Reset filters" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@ResetAllFilters" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid gap-6 lg:grid-cols-2">
                        <KlyDisplay Kind="DisplayKind.Facts" Surface="DisplaySurface.Bordered" Title="@($"Account Dossier · {selected.Name}")" Facts="@([
                            new DisplayFact { Label = "Account ID", Value = $"ACC-{selected.Id:D4}", Copy = true, Mono = true },
                            new DisplayFact { Label = "Region", Value = selected.Region, Chip = new DisplayChip(selected.Status, selected.Status == "Active" ? KlyColor.Success : KlyColor.Warning) },
                            new DisplayFact { Label = "Plan", Value = selected.Plan },
                            new DisplayFact { Label = "Annual Recurring Revenue", Value = $"€{selected.Arr:N0}" }
                        ])" />
                        <KlyDisplay Kind="DisplayKind.Meter" Surface="DisplaySurface.Bordered" Title="Seat Quota Utilization"
                                   MeterValue="@selected.SeatUsagePct" MeterMax="100" WarningThreshold="75" ErrorThreshold="90" />
                        <KlyDisplay Kind="DisplayKind.Code" Surface="DisplaySurface.Bordered" Variant="secret"
                                   Title="Webhook Signing Key (Redacted in AgentBridge)" Value="@($"sk_live_klyroo_{selected.Id:D4}_9921")" VisibleChars="4" Copy="true" />
                        <KlyDisplay Kind="DisplayKind.Timeline" Surface="DisplaySurface.Bordered" Title="Lifecycle Audit" TimelineItems="@([
                            new DisplayTimelineItem("Account Provisioned", Time: "Q1 2026", State: DisplayTimelineState.Done),
                            new DisplayTimelineItem("Enterprise Upgrade", Time: "Q3 2026", State: DisplayTimelineState.Done),
                            new DisplayTimelineItem("Annual Renewal Review", Time: "Active", State: DisplayTimelineState.Current)
                        ])" />
                    </div>
                }
            }
        </div>

        @* Live Klyroo.Agent Copilot Side Panel (single flat surface with clean hairline dividers — zero nested cards) *@
        @if (_showAgent)
        {
            <aside aria-label="Klyroo.Agent Copilot" class="min-w-0 divide-y divide-(--klyroo-border) rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg)">
                <div class="space-y-3 p-5">
                    <div class="flex items-center justify-between gap-2">
                        <h2 class="text-sm font-semibold text-(--klyroo-text-highlighted)">Klyroo.Agent Copilot</h2>
                        <KlyBadge Label="@($"{_agent.Snapshot().Count} controls")" Color="KlyColor.Primary" Variant="KlyVariant.Soft" Size="KlySize.Xs" />
                    </div>
                    <p class="text-xs leading-relaxed text-(--klyroo-text-muted)">
                        Connected to <code class="font-mono">DashboardController</code>, <code class="font-mono">FormController</code>, and <code class="font-mono">SpreadsheetImporter</code>.
                    </p>

                    <div class="flex flex-col gap-2 pt-1">
                        <KlyButton Label="Filter region to EU only" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@AgentFilterEuAsync" />
                        <KlyButton Label="Reset dashboard filters" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@AgentResetDashAsync" />
                        <KlyButton Label="Prefill quick deal form" Size="KlySize.Sm" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@AgentPrefillDealAsync" />
                        <KlyButton Label="Submit deal (requires approval)" Size="KlySize.Sm" Color="KlyColor.Warning" Variant="ButtonVariant.Soft" OnClick="@AgentSubmitDealAsync" />
                    </div>
                </div>

                <div class="p-5">
                    <KlyFormEngine Form="@_quickDealForm" SubmitLabel="Add Deal" ShowReset="false" OnSubmit="@HandleQuickDealSubmit" />
                </div>

                <div class="p-5">
                    <h3 class="text-xs font-medium text-(--klyroo-text-muted)">Agent Audit Log</h3>
                    <pre class="mt-2 max-h-36 overflow-auto whitespace-pre-wrap rounded-lg bg-(--pg-code-bg) p-3 font-mono text-[11px] leading-relaxed text-[#d7dcde]">@_agentLog</pre>
                </div>
            </aside>
        }
    </div>
</div>

@* Human-in-the-loop AllowPolicy Modal (Body & Footer slots keep dialog hidden until Open=true) *@
<KlyModal Open="@_confirmModalOpen" OpenChanged="@OnConfirmModalOpenChanged" Title="Approve AI Action">
    <Body>
        <p class="text-sm leading-relaxed text-(--klyroo-text-muted)">
            <strong class="text-(--klyroo-text-highlighted)">Klyroo.Agent</strong> requested to execute
            <code class="font-mono text-(--klyroo-text-highlighted)">@(_pendingStep?.Action ?? "submit")</code>
            on <strong class="text-(--klyroo-text-highlighted)">@(_pendingStep?.Ref ?? "Quick Deal")</strong>.
            Because <code class="font-mono">confirmSubmit: true</code> is enabled, <code class="font-mono">AllowPolicy</code> paused execution for your confirmation.
        </p>
    </Body>
    <Footer>
        <div class="flex w-full justify-end gap-2">
            <KlyButton Label="Refuse" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" OnClick="@(() => ResolvePolicy(false))" />
            <KlyButton Label="Approve & Execute" Color="KlyColor.Primary" OnClick="@(() => ResolvePolicy(true))" />
        </div>
    </Footer>
</KlyModal>

@code {
    private sealed record AccountRecord(int Id, string Name, string Region, string Plan, string Status, decimal Arr, double SeatUsagePct);

    private static readonly DataListSchema<AccountRecord> AccountSchema = DataListSchema.For<AccountRecord>(s => s
        .RowKey(a => a.Id)
        .RowLabel(a => a.Name)
        .Search(a => a.Name, a => a.Plan, a => a.Region)
        .Field(a => a.Name, f => f.Key("name").Sortable())
        .Field(a => a.Region, f => f.Key("region").Sortable().Filter(DataListFilter.Option()))
        .Field(a => a.Plan, f => f.Key("plan").Sortable().Filter(DataListFilter.Option()))
        .Field(a => a.Status, f => f.Key("status").Sortable().Filter(DataListFilter.Option()))
        .Field(a => a.Arr, f => f.Key("arr").Sortable().Filter(DataListFilter.Number(min: 0))));

    private static readonly DataListGroupBy<AccountRecord> AccountGroupBy = new() { Key = a => a.Region };

    private List<AccountRecord> _accounts =
    [
        new(1, "Helios Cloud SAS", "EU", "Enterprise", "Active", 148_000m, 86),
        new(2, "Northwind Robotics", "US", "Enterprise", "Active", 192_000m, 92),
        new(3, "Kestrel FinTech", "EU", "Pro", "Active", 64_000m, 68),
        new(4, "Sakura BioLabs", "APAC", "Enterprise", "At Risk", 118_000m, 41),
        new(5, "Lumen Logistics", "US", "Pro", "Active", 52_000m, 77),
        new(6, "Alpine Energy GmbH", "EU", "Starter", "At Risk", 24_000m, 95)
    ];

    private readonly UndoStack<AccountRecord[]> _history;
    private readonly DashboardController _dashboard = new("revops");
    private readonly DashboardFilterControl _regionFilter;
    private readonly DashboardResource<int> _kpiWave;
    private readonly AgentBridgeService _agent = new();
    private readonly FormController _quickDealForm;
    private readonly SpreadsheetImporter _importer;
    private IDisposable? _observeSub;

    private string _activeTab = "overview";
    private string _search = "";
    private bool _groupByRegion;
    private bool _showAgent = true;
    private string? _importedNotice;
    private string _agentLog = "Ready. Trigger any copilot action above to inspect Snapshot, Act, and Observe.";

    private bool _confirmModalOpen;
    private AgentActStep? _pendingStep;
    private TaskCompletionSource<bool>? _policyTcs;

    private IReadOnlyList<AccountRecord> FilteredAccounts
    {
        get
        {
            var rules = new List<DataListFilterNode>();
            if (_regionFilter.Values.Count > 0 && _regionFilter.Values.Count < 3)
                rules.Add(new FilterRule("region", FilterOperator.IsAnyOf, new FilterValue.List(_regionFilter.Values)));
            else if (_regionFilter.Values.Count == 0)
                return [];

            var req = new DataListRequest(
                paging: DataListPaging.None.Instance,
                sort: [new DataListSort("arr", Descending: true)],
                filter: rules.Count == 0 ? DataListFilterGroup.Empty : new DataListFilterGroup(FilterCombinator.And, rules),
                search: string.IsNullOrWhiteSpace(_search) ? null : new DataListSearch(_search));

            return AccountSchema.ExecuteInMemory(_accounts, req).Items;
        }
    }

    public KlyrooShowcase()
    {
        _history = new UndoStack<AccountRecord[]>([.. _accounts], limit: 25);

        _dashboard.AddView("overview", "Overview");
        _dashboard.AddView("accounts", "Accounts");
        _regionFilter = _dashboard.AddFilter(new DashboardFilterControl(
            "region", "Region Filter",
            items: [new("EU", "Europe"), new("US", "North America"), new("APAC", "Asia-Pacific")],
            defaultValues: ["EU", "US", "APAC"],
            multiple: true));

        _kpiWave = _dashboard.RegisterResource(new DashboardResource<int>(
            "kpis", _ => Task.FromResult(_accounts.Count), DashboardQueryStage.Essential));

        _quickDealForm = new FormController(new FormSchema
        {
            FormKey = "quick-deal",
            Title = "Quick Deal",
            Fields =
            [
                new FormFieldSchema { Key = "name", Label = "Account Name", Required = true, DefaultValue = "Aether Dynamics" },
                new FormFieldSchema { Key = "region", Label = "Region", Kind = FormFieldKind.Select, DefaultValue = "EU", Options = [new("EU", "Europe"), new("US", "US"), new("APAC", "APAC")] },
                new FormFieldSchema { Key = "arr", Label = "ARR (€)", Kind = FormFieldKind.Number, Min = 1000, DefaultValue = 85000.0 },
                new FormFieldSchema { Key = "apiKey", Label = "Webhook Secret", Kind = FormFieldKind.Password, DefaultValue = "sk_live_hidden_9999" }
            ]
        });

        _importer = new SpreadsheetImporter(new SpreadsheetSchema
        {
            Key = "accounts-import",
            BatchSize = 50,
            Columns =
            [
                new SpreadsheetColumnSchema { Key = "name", Label = "Account Name", Headers = ["Nom", "Account"], Required = true },
                new SpreadsheetColumnSchema { Key = "region", Label = "Region", Headers = ["Région"], Kind = SpreadsheetColumnKind.Select, Required = true, Options = [new("EU", "Europe", ["eu", "europe"]), new("US", "US", ["us"]), new("APAC", "APAC", ["apac"])] },
                new SpreadsheetColumnSchema { Key = "plan", Label = "Plan", Headers = ["Offre"], Required = true },
                new SpreadsheetColumnSchema { Key = "arr", Label = "ARR", Headers = ["Revenu"], Kind = SpreadsheetColumnKind.Number, DecimalSeparator = ',', Required = true, Rules = [SpreadsheetRule.Min(0)] }
            ],
            OnSubmit = batch =>
            {
                var nextId = _accounts.Max(a => a.Id) + 1;
                foreach (var row in batch)
                {
                    var name = row.Data.GetValueOrDefault("name")?.ToString() ?? "Imported";
                    var region = row.Data.GetValueOrDefault("region")?.ToString() ?? "EU";
                    var plan = row.Data.GetValueOrDefault("plan")?.ToString() ?? "Pro";
                    var arr = Convert.ToDecimal(row.Data.GetValueOrDefault("arr") ?? 25000m, CultureInfo.InvariantCulture);
                    _accounts.Add(new AccountRecord(nextId++, name, region, plan, "Active", arr, 50));
                }
                _history.Record([.. _accounts]);
                _importedNotice = batch.Count == 1 ? "Imported 1 account." : $"Imported {batch.Count} accounts.";
                InvokeAsync(StateHasChanged);
                return Task.FromResult<IReadOnlyList<SpreadsheetRejectedRow>?>(null);
            }
        });
        _importer.LoadText("Nom;Région;Offre;Revenu\nSolaris AI;EU;Enterprise;132000,00\nPacific Data;APAC;Pro;48500,00", "new-accounts.csv");

        _agent.RegisterForm(_quickDealForm, confirmSubmit: true);
        _agent.RegisterDashboard(_dashboard);
        _agent.RegisterSpreadsheet(_importer);
        _agent.AllowPolicy = async (step, confirmRequired) =>
        {
            if (!confirmRequired) return true;
            _pendingStep = step;
            _confirmModalOpen = true;
            _policyTcs = new TaskCompletionSource<bool>();
            await InvokeAsync(StateHasChanged);
            return await _policyTcs.Task;
        };
        _observeSub = _agent.Observe(c =>
        {
            _agentLog = $"[{c.Source}] {c.Label}: {FormatObservedValue(c.Previous)} → {FormatObservedValue(c.Value)}\n" + _agentLog;
            InvokeAsync(StateHasChanged);
        });
    }

    private static string FormatObservedValue(object? value) => value switch
    {
        null => "—",
        string s => s,
        IEnumerable<string> seq => string.Join(", ", seq),
        System.Collections.IEnumerable seq => string.Join(", ", seq.Cast<object?>()),
        _ => value.ToString() ?? "—"
    };

    protected override async Task OnInitializedAsync() => await _dashboard.RefreshAsync();

    private void SwitchTab(string tab) => _activeTab = tab;
    private void ToggleRegion(string r) => _regionFilter.Toggle(r);
    private void ResetAllFilters() { _dashboard.ResetFilters(); _search = ""; }

    private void UndoAccounts() { _accounts = [.. _history.Undo()]; }
    private void RedoAccounts() { _accounts = [.. _history.Redo()]; }

    private string FormatAccountSummary()
    {
        var count = FilteredAccounts.Count;
        var label = count == 1 ? "1 account" : $"{count} accounts";
        return $"{label} · €{FilteredAccounts.Sum(a => a.Arr):N0} ARR";
    }

    private IReadOnlyList<DashboardStatsItem> BuildStats()
    {
        var items = FilteredAccounts;
        var arr = (double)items.Sum(a => a.Arr);
        var avg = items.Count > 0 ? arr / items.Count : 0;
        var atRiskPct = items.Count > 0 ? Math.Round(items.Count(a => a.Status == "At Risk") * 100.0 / items.Count, 1) : 0;
        var avgSeats = items.Count > 0 ? Math.Round(items.Average(a => a.SeatUsagePct), 1) : 0;
        return
        [
            new("arr", "Total ARR", arr, DashboardFormatPreset.Compact, Delta: 16.4, Progress: Math.Min(100.0, Math.Round(arr / 750_000.0 * 100.0, 1))),
            new("avg", "Avg Contract", avg, DashboardFormatPreset.Compact, Delta: 8.2),
            new("risk", "At-Risk Share", atRiskPct, DashboardFormatPreset.Percent, Delta: -1.5, InvertDelta: true),
            new("seats", "Seat Utilization", avgSeats, DashboardFormatPreset.Percent, Delta: 4.1, Progress: avgSeats)
        ];
    }

    private IReadOnlyList<DashboardBarItem> BuildRegionBars() =>
        [.. FilteredAccounts
            .GroupBy(a => a.Region)
            .OrderByDescending(g => g.Sum(x => x.Arr))
            .Select(g => new DashboardBarItem(g.Key, (double)g.Sum(x => x.Arr), Tag: g.Count() == 1 ? "1 account" : $"{g.Count()} accounts"))];

    private string BuildLiveQueryUrl()
    {
        var rules = _regionFilter.Values.Count is > 0 and < 3
            ? (IReadOnlyList<FilterRule>)[new FilterRule("region", FilterOperator.IsAnyOf, new FilterValue.List(_regionFilter.Values))]
            : [];
        var state = new DataListState(_search, rules, [new DataListSort("arr", Descending: true)], 1, 25, DataListLayout.Table);
        var pairs = DataListStateQuery.ToQuery(state, AccountSchema, prefix: "acc");
        return pairs.Count == 0 ? "/showcase" : "/showcase?" + string.Join("&", pairs.Select(kv => $"{kv.Key}={kv.Value}"));
    }

    private async Task OpenCreateAccountDrawerAsync()
    {
        var schema = new FormSchema
        {
            FormKey = "create-account",
            Title = "New Customer Account",
            Fields =
            [
                new FormFieldSchema { Key = "name", Label = "Company Name", Required = true },
                new FormFieldSchema { Key = "region", Label = "Region", Kind = FormFieldKind.Select, DefaultValue = "EU", Options = [new("EU", "Europe"), new("US", "North America"), new("APAC", "Asia-Pacific")] },
                new FormFieldSchema { Key = "plan", Label = "Plan", Kind = FormFieldKind.Select, DefaultValue = "Enterprise", Options = [new("Starter", "Starter"), new("Pro", "Pro"), new("Enterprise", "Enterprise")] },
                new FormFieldSchema { Key = "arr", Label = "Annual Contract (€)", Kind = FormFieldKind.Number, Min = 1000, DefaultValue = 75000.0 },
                new FormFieldSchema { Key = "vat", Label = "EU VAT ID (visible for EU)", Condition = f => f.GetValue<string>("region") == "EU", RequiredWhen = f => f.GetValue<string>("region") == "EU" }
            ]
        };

        var outcome = await FormService.CreateFormAsync(schema, mode: FormShellMode.Drawer);
        if (outcome.IsCompleted)
        {
            var nextId = _accounts.Max(a => a.Id) + 1;
            _accounts.Add(new AccountRecord(
                nextId,
                outcome.FormData.GetValueOrDefault("name")?.ToString() ?? "New Account",
                outcome.FormData.GetValueOrDefault("region")?.ToString() ?? "EU",
                outcome.FormData.GetValueOrDefault("plan")?.ToString() ?? "Enterprise",
                "Active",
                Convert.ToDecimal(outcome.FormData.GetValueOrDefault("arr") ?? 75000m, CultureInfo.InvariantCulture),
                45));
            _history.Record([.. _accounts]);
            _activeTab = "accounts";
        }
    }

    private void OpenCsvLightbox()
    {
        var table = new DashboardDataTable(
            [new("name", "Account"), new("region", "Region"), new("plan", "Plan"), new("arr", "ARR", Numeric: true)],
            [.. FilteredAccounts.Select(a => (IReadOnlyDictionary<string, string?>)new Dictionary<string, string?>
            {
                ["name"] = a.Name, ["region"] = a.Region, ["plan"] = a.Plan, ["arr"] = a.Arr.ToString(CultureInfo.InvariantCulture)
            })]);

        var fileName = DashboardFormat.ResolveFileName("Klyroo Revenue Accounts");
        FilePreview.Open(new FilePreviewFile
        {
            Src = fileName,
            Name = fileName,
            Mime = "text/csv",
            Content = DashboardFormat.ExportCsv(table, CultureInfo.InvariantCulture)
        });
    }

    private void HandleQuickDealSubmit(IReadOnlyDictionary<string, object?> data)
    {
        var nextId = _accounts.Max(a => a.Id) + 1;
        _accounts.Add(new AccountRecord(
            nextId,
            data.GetValueOrDefault("name")?.ToString() ?? "AI Deal",
            data.GetValueOrDefault("region")?.ToString() ?? "EU",
            "Enterprise",
            "Active",
            Convert.ToDecimal(data.GetValueOrDefault("arr") ?? 85000m, CultureInfo.InvariantCulture),
            55));
        _history.Record([.. _accounts]);
        _agentLog = $"[Deal Added] {data.GetValueOrDefault("name")} · €{data.GetValueOrDefault("arr")}\n" + _agentLog;
    }

    private async Task AgentFilterEuAsync()
    {
        var steps = new List<AgentActStep>();
        if (!_regionFilter.Values.Contains("EU")) steps.Add(new AgentActStep("Region Filter", "toggle", ["EU"]));
        if (_regionFilter.Values.Contains("US")) steps.Add(new AgentActStep("Region Filter", "toggle", ["US"]));
        if (_regionFilter.Values.Contains("APAC")) steps.Add(new AgentActStep("Region Filter", "toggle", ["APAC"]));
        var ok = steps.Count == 0 || (await _agent.ActAsync(steps)).Ok;
        _agentLog = $"Act(Region = EU only) Ok={ok}\n" + _agentLog;
    }

    private async Task AgentResetDashAsync()
    {
        var res = await _agent.ActAsync([new AgentActStep("revops", "resetFilters")]);
        _agentLog = $"Act(resetFilters) Ok={res.Ok}\n" + _agentLog;
    }

    private async Task AgentPrefillDealAsync()
    {
        var res = await _agent.ActAsync([
            new AgentActStep("Account Name", "setValue", ["Nebula Systems"]),
            new AgentActStep("ARR (€)", "setValue", [165000.0])
        ]);
        var secretSnap = _agent.Snapshot().FirstOrDefault(s => s.Label == "Webhook Secret")?.Value;
        _agentLog = $"Act(Prefill) Ok={res.Ok} · Secret in Snapshot = \"{secretSnap}\"\n" + _agentLog;
    }

    private async Task AgentSubmitDealAsync()
    {
        var res = await _agent.ActAsync([new AgentActStep("Quick Deal", "submit")]);
        if (res.Ok) HandleQuickDealSubmit(_quickDealForm.BuildOutput());
        _agentLog = res.Ok ? "Policy approved · Deal submitted.\n" + _agentLog : $"Policy refused: {res.Error}\n" + _agentLog;
    }

    private void OnConfirmModalOpenChanged(bool open)
    {
        _confirmModalOpen = open;
        if (!open) _policyTcs?.TrySetResult(false);
    }

    private void ResolvePolicy(bool allow)
    {
        _confirmModalOpen = false;
        _policyTcs?.TrySetResult(allow);
    }

    public void Dispose() => _observeSub?.Dispose();
}
