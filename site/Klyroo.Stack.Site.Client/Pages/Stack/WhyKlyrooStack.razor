@page "/why"
@using Klyroo.UI

<PageTitle>Why Klyroo? · Klyroo</PageTitle>

<div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-14 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
        <h1 class="text-4xl font-semibold tracking-[-0.03em] text-(--klyroo-text-highlighted) sm:text-6xl">
            Why <span class="pg-accent">Klyroo?</span>
        </h1>
        <p class="mt-4 max-w-prose text-lg leading-relaxed text-(--klyroo-text-muted)">
            Most Blazor libraries tie business logic to UI components, depend on heavy JS runtimes or proprietary CSS, and break in Static SSR or NativeAOT.
            Klyroo is engineered from first principles for <strong>.NET 10, Headless NativeAOT, Blazor Web (SSR/Server/WASM/Auto), .NET MAUI Blazor Hybrid, and AI Agents</strong>.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
            <KlyButton Label="Try Live 8-Library Showcase" Href="/showcase" Size="KlySize.Lg">
                <TrailingIcon><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
            </KlyButton>
            <KlyButton Label="Explore All 8 Libraries" Href="/#libraries" Size="KlySize.Lg" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" />
        </div>
    </div>

    @* Feature Comparison Matrix *@
    <section aria-labelledby="comparison-heading" class="mt-16">
        <h2 id="comparison-heading" class="text-2xl font-semibold tracking-[-0.02em] text-(--klyroo-text-highlighted)">Honest Technical Comparison</h2>
        <p class="mt-2 max-w-prose text-sm text-(--klyroo-text-muted)">How Klyroo compares against established Blazor component suites.</p>

        <div class="mt-6 overflow-x-auto rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg)">
            <table class="w-full min-w-[780px] text-start text-sm">
                <thead class="border-b border-(--klyroo-border) bg-(--klyroo-bg-muted)/70 font-mono text-xs uppercase text-(--klyroo-text-highlighted)">
                    <tr>
                        <th scope="col" class="px-4 py-3 text-start">Capability</th>
                        <th scope="col" class="px-4 py-3 text-start text-(--klyroo-primary-text)">Klyroo (MIT)</th>
                        <th scope="col" class="px-4 py-3 text-start">MudBlazor / Radzen</th>
                        <th scope="col" class="px-4 py-3 text-start">FluentUI Blazor</th>
                        <th scope="col" class="px-4 py-3 text-start">QuickGrid</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-(--klyroo-border)">
                    <tr>
                        <th scope="row" class="px-4 py-3 text-start font-medium text-(--klyroo-text-highlighted)">Headless NativeAOT Core (<code class="font-mono">*.Core</code>)</th>
                        <td class="px-4 py-3 font-medium text-(--klyroo-text-highlighted)">Yes — all 7 engines run in APIs, CLI, &amp; MAUI ViewModels</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">No (UI-coupled)</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">No (UI-coupled)</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">No</td>
                    </tr>
                    <tr>
                        <th scope="row" class="px-4 py-3 text-start font-medium text-(--klyroo-text-highlighted)">Static SSR (Zero JS fallback)</th>
                        <td class="px-4 py-3 font-medium text-(--klyroo-text-highlighted)">First-class (URL links, Popover API, cookies)</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Limited / Interactive required</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Partial (Web Components)</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Basic</td>
                    </tr>
                    <tr>
                        <th scope="row" class="px-4 py-3 text-start font-medium text-(--klyroo-text-highlighted)">Styling &amp; Theming</th>
                        <td class="px-4 py-3 font-medium text-(--klyroo-text-highlighted)">Native Tailwind CSS v4 + precompiled zero-friction CSS</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Material / Custom SCSS</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Fluent Design tokens</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Minimal CSS</td>
                    </tr>
                    <tr>
                        <th scope="row" class="px-4 py-3 text-start font-medium text-(--klyroo-text-highlighted)">Shared URL State + EF Core SQL AST</th>
                        <td class="px-4 py-3 font-medium text-(--klyroo-text-highlighted)">Built-in (Klyroo.Query: keyset cursors, facets, codecs)</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Manual wiring</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Manual wiring</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">IQueryable only (no URL/facets)</td>
                    </tr>
                    <tr>
                        <th scope="row" class="px-4 py-3 text-start font-medium text-(--klyroo-text-highlighted)">5-Step Spreadsheet CSV Importer</th>
                        <td class="px-4 py-3 font-medium text-(--klyroo-text-highlighted)">Built-in (Klyroo.Spreadsheet: NFD, 80% score, retry)</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                    </tr>
                    <tr>
                        <th scope="row" class="px-4 py-3 text-start font-medium text-(--klyroo-text-highlighted)">3-Wave Staged Dashboard Orchestrator</th>
                        <td class="px-4 py-3 font-medium text-(--klyroo-text-highlighted)">Built-in (Klyroo.Dashboard: Essential / Background / Deferred)</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                    </tr>
                    <tr>
                        <th scope="row" class="px-4 py-3 text-start font-medium text-(--klyroo-text-highlighted)">AI Agent Semantic Bridge &amp; MCP Server</th>
                        <td class="px-4 py-3 font-medium text-(--klyroo-text-highlighted)">Built-in (Klyroo.Agent + Klyroo.Stack.Mcp + llms.txt)</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                        <td class="px-4 py-3 text-(--klyroo-text-muted)">Not included</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    @* Adoption Paths *@
    <section aria-labelledby="adoption-heading" class="mt-16">
        <h2 id="adoption-heading" class="text-2xl font-semibold tracking-[-0.02em] text-(--klyroo-text-highlighted)">Start in 30 Seconds</h2>
        <div class="mt-6 grid gap-6 lg:grid-cols-3">
            <div class="flex min-w-0 flex-col rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-6">
                <h3 class="text-lg font-semibold text-(--klyroo-text-highlighted)">Built-in MCP Server &amp; llms.txt</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-(--klyroo-text-muted)">
                    Install <code class="font-mono text-(--klyroo-text-highlighted)">Klyroo.Stack.Mcp</code> as a global .NET tool so Cursor, Claude Code, and Copilot query exact APIs, parameters, and examples locally over stdio.
                </p>
                <pre class="mt-4 overflow-x-auto rounded-xl bg-(--pg-code-bg) p-3.5 font-mono text-xs text-[#d7dcde]">dotnet tool install -g Klyroo.Stack.Mcp --prerelease
klyroo-stack-mcp</pre>
            </div>

            <div class="flex min-w-0 flex-col rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-6">
                <h3 class="text-lg font-semibold text-(--klyroo-text-highlighted)">Official <code>dotnet new</code> Templates</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-(--klyroo-text-muted)">
                    Scaffold a SaaS app, Admin Backoffice, NativeAOT worker, or .NET MAUI Hybrid app pre-wired with zero-friction CSS.
                </p>
                <pre class="mt-4 overflow-x-auto rounded-xl bg-(--pg-code-bg) p-3.5 font-mono text-xs text-[#d7dcde]">dotnet new install Klyroo.Templates::0.1.0-preview.1
dotnet new klyroo-admin -n MyBackoffice</pre>
            </div>

            <div class="flex min-w-0 flex-col rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-6">
                <h3 class="text-lg font-semibold text-(--klyroo-text-highlighted)">Adopt Incrementally · 100% MIT</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-(--klyroo-text-muted)">
                    Use only <code class="font-mono text-(--klyroo-text-highlighted)">Klyroo.Query.Core</code> in a Minimal API, drop <code class="font-mono text-(--klyroo-text-highlighted)">Klyroo.Spreadsheet</code> into an existing app, or adopt all 8 libraries via <code class="font-mono text-(--klyroo-text-highlighted)">Klyroo.Stack</code>.
                </p>
                <pre class="mt-4 overflow-x-auto rounded-xl bg-(--pg-code-bg) p-3.5 font-mono text-xs text-[#d7dcde]">dotnet add package Klyroo.Query.Core
dotnet add package Klyroo.Stack</pre>
            </div>
        </div>
    </section>

    @* Verified Benchmarks & Footprint (flat grid, zero nested cards) *@
    <section aria-labelledby="benchmarks-heading" class="mt-16 border-t border-(--klyroo-border) pt-14">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <h2 id="benchmarks-heading" class="text-2xl font-semibold tracking-[-0.02em] text-(--klyroo-text-highlighted)">Measured Runtime Performance &amp; Footprint</h2>
                <p class="mt-1 text-sm text-(--klyroo-text-muted)">Median measurements on .NET 10.0 Release (x64) from <code>benchmarks/Klyroo.Stack.Benchmarks</code>.</p>
            </div>
        </div>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-5">
                <dt class="text-xs text-(--klyroo-text-muted)">Klyroo.Query · 100k rows (Filter + Sort + 5 Facets)</dt>
                <dd class="mt-2 text-3xl font-semibold tabular-nums tracking-[-0.02em] text-(--klyroo-text-highlighted)">12.5 ms</dd>
            </div>
            <div class="rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-5">
                <dt class="text-xs text-(--klyroo-text-muted)">Klyroo.Spreadsheet · 10k CSV rows (NFD + Dedup)</dt>
                <dd class="mt-2 text-3xl font-semibold tabular-nums tracking-[-0.02em] text-(--klyroo-text-highlighted)">24.9 ms</dd>
            </div>
            <div class="rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-5">
                <dt class="text-xs text-(--klyroo-text-muted)">All 8 Headless Core DLLs Combined (pre-trim)</dt>
                <dd class="mt-2 text-3xl font-semibold tabular-nums tracking-[-0.02em] text-(--klyroo-text-highlighted)">1,033 KB</dd>
            </div>
            <div class="rounded-2xl border border-(--klyroo-border) bg-(--klyroo-bg) p-5">
                <dt class="text-xs text-(--klyroo-text-muted)">Zero-Friction Precompiled CSS (<code class="font-mono">klyroo-stack.css</code>)</dt>
                <dd class="mt-2 text-3xl font-semibold tabular-nums tracking-[-0.02em] text-(--klyroo-text-highlighted)">27.1 KB</dd>
            </div>
        </dl>
    </section>
</div>
