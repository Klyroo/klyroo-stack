<!DOCTYPE html>
<html lang="@_locale.Code" dir="@_locale.DirAttribute">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Modular headless-first .NET 10, Blazor Web, and .NET MAUI Blazor Hybrid libraries." />
    @* The site can be served below a path base (see Program.cs): every relative URL, the stylesheets, the framework and the image endpoint included, follows this. *@
    <base href="@_baseHref" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <KlyColorModeScript />
    <KlyCultureMeta />
    <KlyThemeStyle />
    @* Self-hosted at build time from the KlyrooFont items of the project (Geist, Geist Mono, Doto): no third-party request. *@
    <KlyFonts />
    <ResourcePreloader />
    @* The site compiles Tailwind itself (Klyroo "Tailwind in the app" mode): one stylesheet, no klyroo.css. *@
    <link rel="stylesheet" href="@Assets["site.css"]" />
    <link rel="stylesheet" href="@Assets["Klyroo.Stack.Site.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="_mode" />
</head>

<body>
    <Routes @rendermode="_mode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" defer></script>
    <script src="@Assets["site.js"]" defer></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [Inject] private IConfiguration Configuration { get; set; } = default!;

    // The PathBase setting as configured, not Request.PathBase: that one keeps the casing of the request (/SUB/), and the cookie and storage scopes compare it as written.
    private string _baseHref => Configuration["PathBase"] is { Length: > 0 } pathBase ? "/" + pathBase.Trim('/') + "/" : "/";

    private IComponentRenderMode? _mode;
    private KlyLocale _locale = KlyLocales.En;

    // /ssr, /server, /wasm and /auto prefixes pick a mode, to test components in each; everything else runs in Auto.
    protected override void OnParametersSet()
    {
        // lang and dir of the page follow the culture of the request, like the components do.
        _locale = KlyLocales.Resolve(System.Globalization.CultureInfo.CurrentUICulture);
        // InteractiveServer is the default so first-visit loads stay lightweight (no 30 MB WASM boot on arrival),
        // while /ssr, /server, /wasm and /auto prefixes explicitly exercise every Blazor render mode.
        _mode = !HttpContext.AcceptsInteractiveRouting() ? null : PlaygroundServices.ModeFromPath(HttpContext.Request.Path) switch
        {
            "ssr" => null,
            "server" => InteractiveServer,
            "wasm" => InteractiveWebAssembly,
            "auto" => InteractiveAuto,
            _ => InteractiveServer,
        };
    }
}
