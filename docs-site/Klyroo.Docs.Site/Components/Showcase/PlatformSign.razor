@* The platform sign: the install command of the whole network, with its copy button (the page script of the site copies what a data-copy attribute carries)
   and a popover with the other packages of the stack. *@
<div class="sc-plat" role="group" aria-label="Install the whole network">
    <div class="num" aria-hidden="true">1</div>
    <div class="body">
        <span class="lab">Install</span>
        <code class="cmd">
            @foreach (var word in Command.Split(' '))
            {
                <span class="w">@word</span>@(" ")
            }
        </code>
        <KlyTooltip Text="Copy the command" Placement="KlyPlacement.Top">
            <KlyButton Color="KlyColor.Primary" Size="KlySize.Sm" Square="true" Class="sc-copy" data-copy="@Command" aria-label="Copy the install command">
                <LeadingIcon>
                    <svg class="code-copy-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.75" /><path d="M10.5 3.5v-.25A1.75 1.75 0 0 0 8.75 1.5h-5A1.75 1.75 0 0 0 2 3.25v5C2 9.2 2.8 10 3.75 10h.25" /></svg>
                    <svg class="code-check-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" /></svg>
                </LeadingIcon>
                <ChildContent><span class="copy-status sr-only" role="status" aria-live="polite"></span></ChildContent>
            </KlyButton>
        </KlyTooltip>
        @if (Packages.Count > 0)
        {
            <KlyPopover Placement="KlyPlacement.TopEnd" AriaLabel="The packages of the stack" Class="sc-more">
                <ChildContent>
                    <KlyButton Variant="ButtonVariant.Ghost" Size="KlySize.Sm" Square="true" Class="sc-more-btn" aria-haspopup="dialog" aria-label="Other packages of the stack"><LeadingIcon><KlyIcon Name="ph:caret-up-down" /></LeadingIcon></KlyButton>
                </ChildContent>
                <Content>
                    <ul class="sc-pkgs">
                        @foreach (var package in Packages)
                        {
                            <li>
                                <span class="pkg-name"><a href="@Urls.NuGet(package.Id)" target="_blank" rel="noopener noreferrer">@package.Id</a><KlyBadge Label="@package.Layer" Variant="KlyVariant.Subtle" Size="KlySize.Xs" /></span>
                                <code>@package.Install</code>
                            </li>
                        }
                    </ul>
                </Content>
            </KlyPopover>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Command { get; set; } = "";
    [Parameter] public IReadOnlyList<HomePackage> Packages { get; set; } = [];
    [Parameter, EditorRequired] public ShowcaseUrls Urls { get; set; } = default!;
}
