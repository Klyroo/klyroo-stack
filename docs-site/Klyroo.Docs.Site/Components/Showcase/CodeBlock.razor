@* A block of code of the page: a KlyDisplay code block (Klyroo.Display) with the syntax highlighting of the library. The copy button of the block needs an interactive
   render mode, which this static page does not have, so it is switched off and the page does not offer a button that does nothing. *@
<div class="sc-code">
    <KlyDisplay Kind="DisplayKind.Code" Value="@Value" Language="@Language" Title="@Title" Copy="false" />
</div>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Language { get; set; }
    [Parameter] public string? Title { get; set; }
}
