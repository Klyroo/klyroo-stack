@inject DocsSite Site
@inject Libraries Libraries

@* The black station-sign band: the wordmark, the places of the page, the docs, the playground, GitHub, and the search and the color mode of the whole site. *@
<header class="sc-nav">
    <div class="sc-nav-inner">
        <a href="./" class="sc-mark" aria-label="@(Site.Settings.Title) home">klyroo<b>/stack</b></a>
        <nav class="sc-links" aria-label="Primary">
            <KlyLink Href="#libraries" Class="sc-link" Raw="true">Libraries</KlyLink>
            <KlyLink Href="#philosophy" Class="sc-link" Raw="true">Philosophy</KlyLink>
            @if (_docs is not null)
            {
                <KlyLink Href="@_docs.Href" Class="sc-link" Raw="true">Docs</KlyLink>
            }
            <KlyLink Href="@_urls.Playground()" Class="sc-link" Raw="true">Playground</KlyLink>
        </nav>
        <div class="sc-tools">
            <div class="sc-menu">
                <KlyDropdownMenu Items="_menu" Placement="KlyPlacement.BottomEnd">
                    <KlyButton Variant="ButtonVariant.Ghost" Size="KlySize.Sm" Square="true" Class="sc-menu-btn" aria-label="Menu" LeadingIcon="@MenuIcon" />
                </KlyDropdownMenu>
            </div>
            <KlyContentSearchButton Variant="ButtonVariant.Ghost" Size="KlySize.Sm" Class="sc-search" />
            <KlyColorModeButton Variant="ButtonVariant.Ghost" Size="KlySize.Sm" Class="sc-mode" />
            <KlyButton Href="@_urls.Organization" Target="KlyLinkTarget.Blank" Size="KlySize.Sm" Color="KlyColor.Primary" Class="sc-gh" LeadingIcon="@GithubIcon">GitHub</KlyButton>
        </div>
    </div>
</header>

@code {
    private DocPage? _docs;
    private ShowcaseUrls _urls = default!;

    private IReadOnlyList<KlyMenuItem> _menu = [];
    private RenderFragment MenuIcon => @<KlyIcon Name="ph:list" />;
    private RenderFragment GithubIcon => @<KlyIcon Name="ph:github-logo" />;

    protected override void OnInitialized()
    {
        _docs = Site.Find("getting-started") ?? Site.Find(LibraryDocs.IndexSlug) ?? Site.Pages.FirstOrDefault();
        _urls = new ShowcaseUrls(Libraries, Site.Settings);
        _menu =
        [
            new KlyMenuItem { Label = "Libraries", Href = "#libraries" },
            new KlyMenuItem { Label = "Philosophy", Href = "#philosophy" },
            .. (_docs is null ? [] : new[] { new KlyMenuItem { Label = "Docs", Href = _docs.Href } }),
            new KlyMenuItem { Label = "Playground", Href = _urls.Playground() },
        ];
    }
}
