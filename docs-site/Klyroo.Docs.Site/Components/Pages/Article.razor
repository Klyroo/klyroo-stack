@page "/{*Slug}"
@inject DocsSite Site
@inject Libraries Libraries
@inject NavigationManager Navigation

@* One component for every page of docs/: the address is the path of the file below docs/, without .md. *@
@if (_page is not null)
{
    <PageTitle>@_page.Title - @Site.Settings.Title</PageTitle>
    <HeadContent>
        <meta name="description" content="@_page.MetaDescription" />
        <link rel="canonical" href="@(Libraries.SiteUrl(Site.Settings.RepoName) + _page.Slug + "/")" />
    </HeadContent>

    @* Below lg the navigation is one bar under the header that says where you are and opens the menu. *@
    <div class="docs-subbar">
        <div class="page-wrap">
            <details>
                <summary>
                    <KlyIcon Name="ph:list" />
                    <span class="where">@if (_page.Group is not null){<span>@_page.Group</span><span aria-hidden="true"> / </span>}<strong>@_page.NavTitle</strong></span>
                    <KlyIcon Name="ph:caret-down" Class="caret" />
                </summary>
                <div class="menu"><DocNav Items="Site.Navigation" CurrentHref="@_page.Href" AriaLabel="Documentation menu" /></div>
            </details>
        </div>
    </div>

    <div class="page-wrap doc-layout">
        <aside class="doc-rail" aria-label="Navigation">
            <DocNav Items="Site.Navigation" CurrentHref="@_page.Href" />
        </aside>

        <article class="doc-main" data-testid="article">
            <nav class="crumbs" aria-label="Breadcrumb">
                <ol>
                    @if (_page.Group is not null)
                    {
                        <li>@if (_groupHref is not null){<a href="@_groupHref">@_page.Group</a>}else{@_page.Group}</li>
                    }
                    else
                    {
                        <li><a href="./">@Site.Settings.Title</a></li>
                    }
                    <li aria-current="page">@_page.NavTitle</li>
                </ol>
            </nav>
            <h1 class="doc-title">@_page.Title</h1>
            @if (_page.LeadHtml is not null)
            {
                <p class="doc-lead">@((MarkupString)_page.LeadHtml)</p>
            }
            <hr class="doc-rule" />

            @if (_page.Toc.Count > 0)
            {
                @* Below xl the table of contents is a disclosure above the text; from xl up it is in the right column. *@
                <details class="toc-mobile">
                    <summary>On this page<KlyIcon Name="ph:caret-down" /></summary>
                    <div class="toc"><ul>@foreach (var link in _page.Toc){<li><a href="@(_page.Href + "#" + link.Id)" data-level="@Math.Clamp(link.Level, 2, 6)" title="@link.Text">@link.Text</a></li>}</ul></div>
                </details>
            }

            <div class="markdown-body doc-body">@((MarkupString)_page.Html)</div>

            <div class="doc-foot">
                <a href="@_editUrl" target="_blank" rel="noopener noreferrer" class="edit-link">
                    <KlyIcon Name="ph:pencil-simple" />
                    Edit this page on GitHub
                </a>
            </div>

            @if (_previous is not null || _next is not null)
            {
                <nav class="surround" aria-label="Previous and next page">
                    @if (_previous is not null)
                    {
                        <a href="@_previous.Href" rel="prev"><span class="title"><KlyIcon Name="ph:arrow-left" />@_previous.Title</span><span class="caption">Previous</span></a>
                    }
                    else
                    {
                        <span></span>
                    }
                    @if (_next is not null)
                    {
                        <a href="@_next.Href" rel="next" class="next"><span class="title"><KlyIcon Name="ph:arrow-right" />@_next.Title</span><span class="caption">Next</span></a>
                    }
                </nav>
            }
        </article>

        @if (_page.Toc.Count > 0)
        {
            <aside class="doc-toc" aria-label="On this page">
                <nav class="toc" data-toc>
                    <p class="toc-title">On this page</p>
                    <ul>@foreach (var link in _page.Toc){<li><a href="@(_page.Href + "#" + link.Id)" data-level="@Math.Clamp(link.Level, 2, 6)" title="@link.Text">@link.Text</a></li>}</ul>
                </nav>
            </aside>
        }
    </div>
}

@code {
    private DocPage? _page;
    private KlyContentSurroundLink? _previous;
    private KlyContentSurroundLink? _next;
    private string _editUrl = "";
    private string? _groupHref;

    [Parameter] public string? Slug { get; set; }

    protected override void OnParametersSet()
    {
        _page = Site.Find(Slug);
        if (_page is null)
        {
            // Answers 404 with the page of Pages/NotFound.razor.
            Navigation.NotFound();
            return;
        }
        (_previous, _next) = Site.Surround(_page);
        _editUrl = $"{Site.Settings.GithubUrl}/edit/{Uri.EscapeDataString(Site.Settings.Branch)}/{_page.SourcePath}";
        _groupHref = _page.Group is null ? null : Site.Pages.FirstOrDefault(p => p.Group == _page.Group)?.Href;
    }
}
