@page "/"
@inject DocsSite Site
@inject Libraries Libraries

@* The home page of the Klyroo network is the metro map (Components/Showcase), chosen by "home: showcase" in docs/site.yml. The docs pages keep the docs layout. *@
@if (Site.Settings.IsShowcase)
{
    <ShowcaseHome />
}
else
{
    <PageTitle>@Site.Settings.Title documentation</PageTitle>

    <HeadContent>
        <meta name="description" content="@Site.Settings.Description" />
        <link rel="canonical" href="@Libraries.SiteUrl(Site.Settings.RepoName)" />
    </HeadContent>

    @* The first viewport: the black sign of the library (headline, lead, the way in, the platform with the install command) beside its line, then the demonstration board. *@
    <section class="lh" aria-labelledby="hero-title">
        <div class="lh-top">
            <div class="sc-sign lh-sign">
                <h1 class="lh-title" id="hero-title">
                    <span class="line">@Site.Settings.Headline[0]</span>
                    @if (Site.Settings.Headline.Count > 1)
                    {
                        <span class="line"><span class="mark">@Site.Settings.Headline[1]</span></span>
                    }
                </h1>
                <p class="lh-lead">@Site.Settings.Lead</p>
                <div class="lh-cta">
                    @if (Start is not null)
                    {
                        <KlyButton Href="@Start.Href" Color="KlyColor.Primary" Size="KlySize.Md" TrailingIcon="@ArrowIcon">@(Start.Slug == "getting-started" ? "Get started" : "Read the docs")</KlyButton>
                    }
                    @if (Libraries.PlaygroundOf(Site.Settings.RepoName) is { } playground)
                    {
                        <KlyButton Href="@playground" Variant="ButtonVariant.Outline" Size="KlySize.Md" TrailingIcon="@ArrowUpRightIcon">Try it in the playground</KlyButton>
                    }
                </div>
                @if (Site.Settings.HeroInstall is { } install)
                {
                    <PlatformSign Command="@install" Number="1" AriaLabel="@($"Install {Site.Settings.Title}")" />
                }
            </div>
            @if (_line is not null && _library is not null)
            {
                <LineStops Line="_line" Library="_library" Fill="@_theme.Fill" OnFill="@_theme.OnFill" />
            }
        </div>

            @switch (Site.Settings.Demo)
            {
                case { Board: "table" }:
                    <TableBoard />
                    break;
                case { Board: "form" }:
                    <FormBoard />
                    break;
                case { Board: "query" }:
                    <QueryBoard />
                    break;
                case { Board: "spreadsheet" }:
                    <SpreadsheetBoard />
                    break;
                case { Board: "dashboard" }:
                    <DashboardBoard />
                    break;
                case { Board: "display" }:
                    <DisplayBoard />
                    break;
                case { Board: "agent" }:
                    <AgentBoard />
                    break;
                case { Board: "ui" }:
                    <UiBoard />
                    break;
                case { Code: not null } demo:
                    <QuickBoard Demo="demo" />
                    break;
            }
    </section>

    @switch (Site.Settings.Demo?.Board)
    {
        case "table":
            <section class="section showcases" aria-labelledby="showcases-title">
                <div class="page-wrap">
                    <h2 class="section-title" id="showcases-title">Beyond the first list</h2>
                    <TableShowcases />
                </div>
            </section>
            break;
        case "form":
            <section class="section showcases" aria-labelledby="showcases-title">
                <div class="page-wrap">
                    <h2 class="section-title" id="showcases-title">Beyond the first form</h2>
                    <FormShowcases />
                </div>
            </section>
            break;
    }

    <FeatureList Features="Site.HomeContent.Features" Title="@(Site.Settings.Demo?.Board is null ? "What it does" : "Everything it does")" />
    <PackageList Packages="Site.HomeContent.Packages" />
    <CloseBand />
}

@code {
    private MetroLine? _line;
    private LibraryInfo? _library;
    private AccentTheme _theme = default!;
    private RenderFragment ArrowIcon => @<KlyIcon Name="ph:arrow-right" />;
    private RenderFragment ArrowUpRightIcon => @<KlyIcon Name="ph:arrow-up-right" />;

    protected override void OnInitialized()
    {
        _line = NetworkData.Lines.FirstOrDefault(l => l.Repo.Equals(Site.Settings.RepoName, StringComparison.OrdinalIgnoreCase));
        _library = Libraries.Find(Site.Settings.RepoName);
        _theme = AccentColor.Compute(Site.Settings.Accent);
    }

    private DocPage? Start => Site.Pages.FirstOrDefault(p => p.Slug == "getting-started") ?? Site.Find(LibraryDocs.IndexSlug) ?? Site.Pages.FirstOrDefault();
}
