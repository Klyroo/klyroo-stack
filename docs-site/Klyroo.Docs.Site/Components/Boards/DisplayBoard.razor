@* The board of Klyroo.Display: a code block with line numbers and emphasized lines, a secret block and a file list that opens the preview. The values are sample data. *@
<DemoBoard File="Order.razor" Lines="_lines" Chips="_chips" Class="is-dense" Label="Klyroo.Display components and what they render">
    <Results>
        <ResultPanel Title="Code block" Note="sample data" Class="flush">
            <section class="disp-section" data-target="code lines" aria-label="Code">
                <pre class="code-value numbered"><code>@foreach (var (line, number) in _sql.Select((text, index) => (text, index + 1))){<span class="cn@(_marked.Contains(number) ? " is-marked" : "")" data-target="@(_marked.Contains(number) ? "lines" : null)" data-n="@number">@BoardMarkup.Code(line, "sql")</span>}</code></pre>
            </section>
            <p class="annot-line">
                <span class="annot" data-annot-for="code">colored from Language by the CodeHighlighter of Klyroo.Display.Core, 13 languages</span>
                <span class="annot" data-annot-for="lines">line 2 and lines 4 to 5 are emphasized; the numbers are drawn with CSS, so copying gives the code only</span>
            </p>
        </ResultPanel>
        <ResultPanel Title="Secret and files" Note="sample data" Class="flush">
            <section class="disp-section" data-target="secret" aria-label="Secret">
                <div class="secret">
                    <span class="stat-title">API key</span>
                    <span class="secret-value">••••••••3210</span>
                    <span class="secret-actions"><span class="send ghost">Reveal</span><span class="send ghost icon-only"><KlyIcon Name="ph:copy" /></span></span>
                </div>
            </section>
            <section class="disp-section" data-target="files preview" aria-label="Files">
                <ul class="file-rows">
                    <li><span class="file-badge">PDF</span><span class="file-main"><span class="file-name">Specification.pdf</span><span class="file-note">Version 3 · 1.5 MB</span></span><span class="file-meta">Updated today</span></li>
                    <li><span class="file-badge">CSV</span><span class="file-main"><span class="file-name">metrics.csv</span><span class="file-note">18 KB</span></span></li>
                    <li><span class="file-badge">PDF</span><span class="file-main"><span class="file-name">Q3 summary</span></span></li>
                </ul>
            </section>
            <p class="annot-line">
                <span class="annot" data-annot-for="secret">eight bullets, then the last four characters; the copy button copies the whole value</span>
                <span class="annot" data-annot-for="files">each row shows a badge, the name, the size and a description</span>
                <span class="annot" data-annot-for="preview">a click opens all the files as a gallery in the preview, starting at the clicked one</span>
            </p>
        </ResultPanel>
    </Results>
</DemoBoard>

@code {
    private static readonly string[] _sql =
    [
        "SELECT id, total",
        "FROM orders",
        "WHERE status = 'paid'",
        "  AND total > 100",
        "  AND shipped_at IS NULL;",
    ];

    private static readonly HashSet<int> _marked = [2, 4, 5];

    private static readonly IReadOnlyList<BoardLine> _lines =
    [
        new("<KlyCodeBlock Label=\"Orders.sql\" Code=\"@Query\"", "code", "html"),
        new("              Language=\"CodeLanguage.Sql\" LineNumbers", "code lines", "html"),
        new("              HighlightLines=\"@([2, new CodeLineRange(4, 5)])\" />", "lines", "html"),
        new(""),
        new("<KlySecretBlock Label=\"API key\" Value=\"@ApiKey\"", "secret", "html"),
        new("                VisibleChars=\"4\" />", "secret", "html"),
        new(""),
        new("<KlyFileList Title=\"Attachments\" Files=\"_files\" />", "files", "html"),
        new("<KlyFilePreviewProvider />", "preview", "html"),
    ];

    private static readonly IReadOnlyList<BoardChip> _chips =
    [
        new("code", "Highlight", "KlyCodeBlock colors the code from its Language and keeps the text plain, so selecting and copying give the code as it is."),
        new("lines", "Lines", "LineNumbers numbers the lines with CSS, and HighlightLines emphasizes line numbers and CodeLineRange values with a neutral fill and a marker in the gutter."),
        new("secret", "Secret", "KlySecretBlock shows bullets and the last VisibleChars characters, with Reveal and copy buttons. It hides the value from the eye, not from the client."),
        new("files", "File list", "KlyFileList shows the badge, name, size and description of each file, a few at a time with Max and Step."),
        new("preview", "Preview", "A KlyFilePreviewProvider turns a click on a file into a gallery in an overlay: PDF, images, video, audio, CSV, Markdown and text."),
    ];
}
