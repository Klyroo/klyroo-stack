@* The board of Klyroo.Display: five KlyDisplay blocks (facts, statistic, meter, code, secret code) and what each renders. The values are sample data. *@
<DemoBoard File="Order.razor" Lines="_lines" Chips="_chips" Class="is-dense" Label="KlyDisplay blocks and what they render">
    <Results>
        <ResultPanel Title="Facts, statistic and meter" Note="sample data" Class="flush">
            <section class="disp-section" data-target="facts" aria-label="Facts">
                <dl class="facts">
                    <div><dt>Reference</dt><dd><code>ORD-1042</code><KlyIcon Name="ph:copy" Class="fact-icon" /></dd></div>
                    <div><dt>Status</dt><dd><span class="status ok">Paid</span></dd></div>
                    <div><dt>Shipping address</dt><dd class="no-value">-</dd></div>
                </dl>
            </section>
            <section class="disp-section" data-target="stat" aria-label="Statistic">
                <div class="stat wide-stat">
                    <span class="stat-title">Monthly revenue</span>
                    <span class="stat-value">148,900 <span class="stat-unit">EUR</span> <span class="delta up">+14.2%</span></span>
                    <svg class="spark" viewBox="0 0 120 40" role="img" aria-label="Trend: 102, 118, 134, 149" preserveAspectRatio="none"><polyline points="4,36 42,24 80,13 116,4" fill="none" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" /><circle cx="116" cy="4" r="3" /></svg>
                </div>
            </section>
            <section class="disp-section" data-target="meter" aria-label="Meter">
                <div class="meter">
                    <div class="meter-head"><span class="stat-title">Storage</span><span class="meter-text">46 of 50 GB used</span></div>
                    <div class="meter-track" role="img" aria-label="92 percent, past the error threshold"><span class="meter-fill" style="width: 92%"></span><span class="meter-mark" style="left: 90%"></span></div>
                </div>
            </section>
            <p class="annot-line">
                <span class="annot" data-annot-for="facts">a chip for the status, a copy button on the reference, a dash for a missing value</span>
                <span class="annot" data-annot-for="stat">Delta is shown as given; DeltaDirection only picks its color</span>
                <span class="annot" data-annot-for="meter">92 percent of MeterMax is past ErrorThreshold, so the bar is red</span>
            </p>
        </ResultPanel>
        <ResultPanel Title="Code values" Note="sample data" Class="flush">
            <section class="disp-section" data-target="code" aria-label="Code">
                <pre class="code-value"><code>@BoardMarkup.Code("public record Order(int Id) { public string Label => $\"Order {Id}\"; }", "csharp")</code></pre>
            </section>
            <section class="disp-section" data-target="secret" aria-label="Secret">
                <div class="secret">
                    <span class="stat-title">API key</span>
                    <span class="secret-value">••••••••3210</span>
                    <span class="secret-actions"><span class="send ghost">Reveal</span><span class="send ghost icon-only"><KlyIcon Name="ph:copy" /></span></span>
                </div>
            </section>
            <p class="annot-line">
                <span class="annot" data-annot-for="code">colored from Language; the text stays plain for selection and copy</span>
                <span class="annot" data-annot-for="secret">eight bullets, then the last four characters</span>
            </p>
        </ResultPanel>
    </Results>
</DemoBoard>

@code {
    private static readonly IReadOnlyList<BoardLine> _lines =
    [
        new("<KlyDisplay Kind=\"DisplayKind.Facts\" Facts=\"_facts\" />", "facts", "html"),
        new(""),
        new("<KlyDisplay Kind=\"DisplayKind.Stat\" Title=\"Monthly revenue\"", "stat", "html"),
        new("            Value=\"148,900\" Unit=\"EUR\" Delta=\"+14.2%\"", "stat", "html"),
        new("            DeltaDirection=\"DisplayDeltaDirection.Up\"", "stat", "html"),
        new("            Trend=\"_trend\" />", "stat", "html"),
        new(""),
        new("<KlyDisplay Kind=\"DisplayKind.Meter\" Title=\"Storage\"", "meter", "html"),
        new("            MeterValue=\"46\" MeterMax=\"50\"", "meter", "html"),
        new("            ErrorThreshold=\"90\"", "meter", "html"),
        new("            Description=\"46 of 50 GB used\" />", "meter", "html"),
        new(""),
        new("<KlyDisplay Kind=\"DisplayKind.Code\" Language=\"csharp\"", "code", "html"),
        new("            Value=\"@Snippet\" />", "code", "html"),
        new("<KlyDisplay Kind=\"DisplayKind.Code\" Title=\"API key\"", "secret", "html"),
        new("            Variant=\"DisplayVariant.Secret\" Value=\"@ApiKey\" />", "secret", "html"),
    ];

    private static readonly IReadOnlyList<BoardChip> _chips =
    [
        new("facts", "Facts", "Facts lists labels and values. A fact can carry a chip, a link or a copy button, and a fact with no value shows a dash."),
        new("stat", "Statistic", "A statistic shows a value with its unit, a delta badge and a sparkline from Trend. You format the text yourself."),
        new("meter", "Meter", "A meter fills from MeterValue to MeterMax and changes color at its thresholds: 46 of 50 is past the error threshold."),
        new("code", "Code", "The code block colors the text from its Language, and keeps it plain text so selecting and copying give the code as it is."),
        new("secret", "Secret", "The secret variant shows bullets and the last four characters, with Reveal and copy buttons. It hides the value from the eye, not from the client."),
    ];
}
