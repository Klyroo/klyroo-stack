<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* The site is served below the name of the repository (https://klyroo.github.io/klyroo-table/): every relative URL, the stylesheet and the framework included, follows this. *@
    <base href="@_baseHref" />
    <KlyColorModeScript />
    <KlyThemeStyle />
    @* Self-hosted at build time from the KlyrooFont items of Klyroo.Docs.Site.csproj: no third-party request. *@
    <KlyFonts />
    <ResourcePreloader />
    @* Compiled by the build from Styles/app.css (Tailwind, with the Klyroo theme). *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* The line color of the library, written after the stylesheet: the variables it defines are the only thing that differs between the sites. *@
    <style>@((MarkupString)_accentCss)</style>
    <link rel="icon" type="image/svg+xml" href="@_favicon" />
    <ImportMap />
    <HeadOutlet />
</head>

<body data-enhance-nav="false">
    @* No render mode: every page is rendered once and sent as HTML. The menu, the search, the table of contents, the navigation groups and the color mode run in
       the browser (Klyroo's own script), and the copy buttons of the code blocks run on the small script below, so there is no circuit and no WebAssembly. Links are plain navigations (data-enhance-nav="false"): a static server answers each page itself, and Blazor's enhanced navigation would fetch every page twice to find out. *@
    <Routes />
    <script>@((MarkupString)CodeCopy.Script)</script>
    <script src="@Assets["site.js"]" defer></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;
    [Inject] private DocsSite Site { get; set; } = default!;
    [Inject] private Libraries Libraries { get; set; } = default!;

    private string _accentCss = "";
    private string _favicon = "";

    protected override void OnInitialized()
    {
        var theme = AccentColor.Compute(Site.Settings.Accent);
        _accentCss = $":root{{--accent:{theme.Fill};--on-accent:{theme.OnFill}}}";
        // The stack is the interchange of the network: its rails and plates are the eight lines side by side, in the order of the map.
        if (Site.Settings.IsShowcase)
        {
            var colors = NetworkData.Lines.Select(l => Libraries.Find(l.Repo)?.Accent ?? "#888888").ToList();
            string Stops(string direction) => $"linear-gradient({direction}," + string.Join(",", colors.Select((c, i) => $"{c} {i * 100.0 / colors.Count:0.##}% {(i + 1) * 100.0 / colors.Count:0.##}%")) + ")";
            _accentCss += $":root{{--accent:#ffd23f;--on-accent:#111111;--rail:{Stops("to bottom")};--rail-h:{Stops("to right")}}}";
        }
        // The plate of the line as the icon of the tab, with the outline of a station.
        var svg = $"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='3' y='9' width='26' height='14' rx='4' fill='{theme.Fill}' stroke='#111111' stroke-width='3'/></svg>";
        _favicon = "data:image/svg+xml," + Uri.EscapeDataString(svg);
    }

    // The PathBase setting as configured, normalized to "/x/": the root when there is none.
    private string _baseHref => Configuration["PathBase"] is { Length: > 0 } pathBase ? "/" + pathBase.Trim('/') + "/" : "/";
}
