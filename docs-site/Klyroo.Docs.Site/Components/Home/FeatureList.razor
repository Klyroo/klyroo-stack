@* The features of the README as the stations of the line of the library: a station for each, its name and what it does. The line diagram of the first viewport links here. *@
@if (Features.Count > 0)
{
    <section class="section" id="features" aria-labelledby="features-title">
        <div class="page-wrap">
            <h2 class="section-title" id="features-title">@Title</h2>
            <dl class="spec">
                @foreach (var feature in Features)
                {
                    <div class="spec-row" id="@Slug.Feature(feature.Title)">
                        <dt><i class="spec-dot" aria-hidden="true"></i>@feature.Title</dt>
                        <dd>@((MarkupString)feature.Html)</dd>
                    </div>
                }
            </dl>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HomeFeature> Features { get; set; } = [];
    [Parameter] public string Title { get; set; } = "What it does";
}
