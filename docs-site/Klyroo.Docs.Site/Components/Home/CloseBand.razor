@inject DocsSite Site
@inject Libraries Libraries

@* The close: the way in, and the other lines of the network, each with the plate of its color. It carries the id of the ecosystem section of the README, which it replaces. *@
<section class="section close" id="klyroo-ecosystem" aria-labelledby="close-title">
    <div class="page-wrap">
        <div class="cl-sign">
            <h2 class="close-title" id="close-title">@(Start is not null ? "Install it, then open the first page." : "Read the documentation.")</h2>
            <div class="cl-actions">
                @if (Start is not null)
                {
                    <KlyButton Href="@Start.Href" Color="KlyColor.Primary" Size="KlySize.Lg" TrailingIcon="@ArrowIcon">@(Start.Slug == "getting-started" ? "Get started" : "Read the docs")</KlyButton>
                }
                <KlyButton Href="@Site.Settings.GithubUrl" Target="KlyLinkTarget.Blank" Variant="ButtonVariant.Outline" Size="KlySize.Lg" LeadingIcon="@GithubIcon">GitHub</KlyButton>
            </div>
        </div>

        @if (Site.HomeContent.Ecosystem.Count > 0)
        {
            <h3 class="family-title">Change here for the other lines</h3>
            <ul class="family">
                @foreach (var library in Site.HomeContent.Ecosystem)
                {
                    <li style="--c: @(library.Accent ?? "var(--sc-muted)")">
                        <a href="@library.Href" class="family-name" aria-current="@(library.Current ? "true" : null)">
                            @if (library.Accent is { } accent)
                            {
                                <LineBadge Label="@library.Name" Fill="@accent" OnFill="@AccentColor.Compute(accent).OnFill" Size="KlySize.Md" />
                            }
                            else
                            {
                                <span class="family-plain">@library.Name</span>
                            }
                        </a>
                        <span class="family-text">@((MarkupString)library.DescriptionHtml)</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <h3 class="family-title">Change here for the other lines</h3>
            <ul class="family">
                @foreach (var library in Libraries.Items)
                {
                    <li style="--c: @(library.Accent ?? "var(--sc-muted)")">
                        <a href="@Libraries.SiteUrl(library.Repo)" class="family-name"><LineBadge Label="@library.Name" Fill="@(library.Accent ?? "#888888")" OnFill="@AccentColor.Compute(library.Accent ?? "#888888").OnFill" Size="KlySize.Md" /></a>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private DocPage? Start => Site.Pages.FirstOrDefault(p => p.Slug == "getting-started") ?? Site.Find(LibraryDocs.IndexSlug) ?? Site.Pages.FirstOrDefault();

    private RenderFragment ArrowIcon => @<KlyIcon Name="ph:arrow-right" />;
    private RenderFragment GithubIcon => @<KlyIcon Name="ph:github-logo" />;
}
