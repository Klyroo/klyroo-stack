@* A block of code of the page: a KlyCodeBlock (Klyroo.Display) with the syntax highlighting of the library. It keeps the semantic colors of Klyroo.UI, which the showcase re-tokens for its dark signs. The copy button of the block needs an
   interactive render mode, which this static page does not have, so it is switched off and the page does not offer a button that does nothing. *@
<div class="sc-code">
    <KlyCodeBlock Code="@Value" Language="@HighlightedCode.Resolve(Language)" Label="@Title" Copy="false" />
</div>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Language { get; set; }
    [Parameter] public string? Title { get; set; }
}
