@typeparam TModel where TModel : class
@using System.Text.Json
@using System.Text.Json.Serialization.Metadata
@implements IDisposable

<PgPanel Title="@Title" Note="@(UsePage ? "KlyFormPage" : "KlyFormEngine")">
    @if (UsePage)
    {
        <KlyFormPage TModel="TModel" Form="_form" OnSubmit="OnSubmitted" />
    }
    else
    {
        <KlyFormEngine TModel="TModel" Form="_form" SubmitLabel="Submit" OnSubmit="OnSubmitted" />
    }
</PgPanel>

<div class="grid gap-5 min-[1100px]:grid-cols-2">
    <PgPanel Title="Typed model" Note="CreateModel() now">
        <PgCode Code="@ModelJson()" Language="CodeLanguage.Json" />
    </PgPanel>
    <PgPanel Title="Validation" Note="@(_form.HasBlockingErrors ? "blocked" : "no blocking error")">
        <KlyFacts Items="Status()" Surface="KlySurface.Plain" />
        @if (_form.Errors.Count > 0 || _form.FormErrors.Count > 0)
        {
            <div class="mt-3">
                <KlyFacts Items="ErrorFacts()" Surface="KlySurface.Plain" />
            </div>
        }
        else
        {
            <p class="m-0 mt-3 text-sm text-(--klyroo-text-muted)">No error to show. Leave a required field empty and press Submit, or touch a field and leave it with a wrong value.</p>
        }
    </PgPanel>
</div>

<PgPanel Title="Submitted model" Note="@(_submitted is null ? "not submitted yet" : "OnSubmit received it")">
    @if (_submitted is null)
    {
        <p class="m-0 text-sm text-(--klyroo-text-muted)">Submit the form: the model OnSubmit receives is shown here, typed, with enums as names.</p>
    }
    else
    {
        <PgCode Code="@_submitted" Language="CodeLanguage.Json" />
    }
</PgPanel>

@code {
    [Parameter, EditorRequired] public FormSchema<TModel> Schema { get; set; } = default!;
    [Parameter, EditorRequired] public TModel Initial { get; set; } = default!;
    [Parameter, EditorRequired] public JsonTypeInfo<TModel> Json { get; set; } = default!;
    [Parameter] public bool UsePage { get; set; }
    [Parameter] public string Title { get; set; } = "Live form";

    private FormController<TModel> _form = default!;
    private string? _submitted;

    protected override void OnInitialized()
    {
        _form = new FormController<TModel>(Schema, Initial);
        _form.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private string ModelJson() => JsonText.Indent(JsonSerializer.Serialize(_form.CreateModel(), Json));

    private void OnSubmitted(TModel model) => _submitted = JsonText.Indent(JsonSerializer.Serialize(model, Json));

    private IReadOnlyList<KlyFact> Status() =>
    [
        new KlyFact("Changed") { Value = _form.IsDirty ? "yes" : "no" },
        new KlyFact("Blocking errors") { Value = _form.HasBlockingErrors ? "yes" : "no", Color = _form.HasBlockingErrors ? KlyColor.Error : KlyColor.Success },
        new KlyFact("Submit failed") { Value = _form.SubmitFailed ? $"yes, {Words.Plural(_form.SubmitFailureCount, "time")}" : "no" },
        new KlyFact("Step") { Value = _form.CurrentStepKey ?? "none: not a wizard" },
    ];

    private IReadOnlyList<KlyFact> ErrorFacts() =>
    [
        .. _form.Errors.Select(e => new KlyFact(e.Key) { Value = e.Value, Color = KlyColor.Error }),
        .. _form.FormErrors.Select(e => new KlyFact("form") { Value = e, Color = KlyColor.Error }),
    ];

    public void Dispose() => _form.Changed -= OnChanged;
}
