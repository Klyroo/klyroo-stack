@* The code of the current knobs, as the docs boards show it: a head bar with the file name in mono (the KlyCodeBlock draws it), tabs only when there is more than one file.
   The lines that the last changed knob wrote are emphasized with HighlightLines: the panel compares each file with the text it showed before. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<section aria-label="Code for the current knobs" class="pg-code min-w-0">
    <KlyCard Ui="@(new CardUi { Body = "p-0 sm:p-0", Header = "px-4 py-2.5 sm:px-4 sm:py-2.5" })">
        <Header>
            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                <h2 class="m-0 text-sm font-semibold text-(--klyroo-text-highlighted)">Code</h2>
                <span class="note-mono" data-testid="code-note">@LanguageName(Tabs[Index].Language), @(_marks.TryGetValue(Tabs[Index].Name, out var marked) && marked.Count > 0 ? "the lines the last knob changed are marked" : "updates with the knobs")</span>
            </div>
        </Header>
        <ChildContent>
            @if (Tabs.Count > 1)
            {
                <KlyTabs Items="_items" Value="@_current" ValueChanged="OnTab" AriaLabel="Files" Variant="TabsVariant.Link" Ui="@(new TabsUi { List = "px-3" })" />
            }
            else
            {
                @Block(Tabs[0])
            }
        </ChildContent>
    </KlyCard>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CodeTab> Tabs { get; set; } = [];

    private string? _current = "0";
    private IReadOnlyList<KlyTabItem> _items = [];
    private readonly Dictionary<string, string> _texts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<CodeLineRange>> _marks = new(StringComparer.Ordinal);
    private ElementReference _box;
    private bool _reveal;
    private IJSObjectReference? _module;

    private int Index => int.TryParse(_current, out var i) && i < Tabs.Count ? i : 0;

    protected override void OnParametersSet()
    {
        var changedTabs = new List<int>();
        for (var i = 0; i < Tabs.Count; i++)
        {
            var tab = Tabs[i];
            if (_texts.TryGetValue(tab.Name, out var before) && before != tab.Text)
            {
                var ranges = CodeDiff.ChangedLines(before, tab.Text);
                _marks[tab.Name] = ranges;
                if (ranges.Count > 0)
                {
                    changedTabs.Add(i);
                }
            }
            _texts[tab.Name] = tab.Text;
        }

        // The knob changed the file of another tab: show that one, or the change would go unseen.
        if (changedTabs.Count == 1 && changedTabs[0] != Index)
        {
            _current = changedTabs[0].ToString();
        }
        if (changedTabs.Count > 0)
        {
            _reveal = true;
        }
        _items = [.. Tabs.Select((tab, i) => new KlyTabItem(tab.Name) { Value = i.ToString(), Content = Block(tab) })];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_reveal)
        {
            return;
        }
        _reveal = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./pg-code.js");
            await _module.InvokeVoidAsync("revealMarked", _box);
        }
        catch (JSException)
        {
            // The code box may be gone (a tab change re-rendered it): the marked lines are still drawn.
        }
    }

    private void OnTab(string? value) => _current = value;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }

    private static string LanguageName(string language) => language switch
    {
        "html" => "Razor", "csharp" => "C#", "json" => "JSON", "css" => "CSS", _ => language,
    };

    private RenderFragment Block(CodeTab tab) => @<div class="code-scroll max-h-[34rem] min-w-0 overflow-auto" @ref="_box" data-testid="code-scroll">
        <PgCode Label="@(Tabs.Count > 1 ? LanguageName(tab.Language) : tab.Name)" Code="@tab.Text" Language="@CodeHighlighter.ResolveLanguage(tab.Language)" LineNumbers="true"
                HighlightLines="@(_marks.TryGetValue(tab.Name, out var ranges) ? ranges : null)" />
    </div>;
}
