@page "/display"
@using System.Text
@using Klyroo.Playground.Data
@inject Knobs K

<PgShell Library="_lib" DocsPage="guides/" OnReset="LoadKnobs"
         Lead="Code with syntax colors, line numbers and emphasized lines, a masked secret, a list of files that opens in the preview, and audio and video players with clip and play-limit rules. Pick a component and turn its knobs: the component and the code that builds it update as you go.">
    <Knobs>
        <PgGroup Title="Component">
            <PgSelect Key="component" Label="Component" T="string" Options="_components" @bind-Value="_component" OnChange="ComponentChanged" Hint="@ComponentHint" />
        </PgGroup>
        @switch (_component)
        {
            case "code":
                <PgGroup Title="Code">
                    <PgSelect Key="language" Label="Language" T="string" Options="_languages" @bind-Value="_language" OnChange="LanguageChanged" Hint="A CodeLanguage. Without one the code is plain text." />
                    <PgText Key="label" Label="Label" @bind-Value="_label" />
                    <KlyFormField Label="Code" Help="Edit it: the block follows. A markup tag in it stays text.">
                        <KlyTextarea @bind-Value="_code" Rows="7" />
                    </KlyFormField>
                </PgGroup>
                <PgGroup Title="Lines">
                    <PgSwitch Key="numbers" Label="Line numbers" Hint="Drawn with CSS, so copying the code never picks them up." @bind-Value="_numbers" />
                    <PgText Key="lines" Label="Emphasized lines" Placeholder="2, 4-5" Hint="Line numbers and runs, counted from 1: HighlightLines." @bind-Value="_lines" />
                </PgGroup>
                <PgGroup Title="Behavior">
                    <PgSwitch Key="highlight" Label="Highlight" Hint="Off renders the code without colors." @bind-Value="_highlight" />
                    <PgSwitch Key="copy" Label="Copy button" @bind-Value="_copy" />
                </PgGroup>
                break;
            case "secret":
                <PgGroup Title="Secret">
                    <PgText Key="label" Label="Label" @bind-Value="_secretLabel" />
                    <PgText Key="value" Label="Value" @bind-Value="_secretValue" />
                    <PgNumber Key="visible" Label="Visible characters" Min="0" Max="12" @bind-Value="_visible" Hint="How many of the last characters show while the value is masked. A value no longer than this is fully masked." />
                    <PgSwitch Key="copy" Label="Copy button" Hint="Copies the whole value, even while it is masked." @bind-Value="_copy" />
                </PgGroup>
                break;
            case "files":
                <PgGroup Title="List">
                    <PgText Key="title" Label="Title" @bind-Value="_filesTitle" />
                    <PgNumber Key="max" Label="Max" Min="0" Max="10" @bind-Value="_max" Hint="How many files show first. 0 shows them all." />
                    <PgNumber Key="step" Label="Step" Min="0" Max="10" @bind-Value="_step" Hint="How many each Show more adds. 0 shows everything at once." Disabled="@(_max == 0)" />
                </PgGroup>
                <PgGroup Title="Rows">
                    <PgSwitch Key="details" Label="Descriptions, meta and icons" Hint="The extras of a FileListItem: a line under the name, text at the end, an icon and a color for the badge." @bind-Value="_details" />
                    <PgSwitch Key="provider" Label="File preview provider" Hint="Mounts KlyFilePreviewProvider. Without it a click on a name follows the link." @bind-Value="_provider" />
                </PgGroup>
                break;
            default:
                <PgGroup Title="Clip">
                    <PgText Key="title" Label="Title" @bind-Value="_mediaTitle" />
                    <PgNumber Key="start" Label="Start (s)" Min="0" Max="@(MediaSeconds - 1)" @bind-Value="_start" />
                    <PgNumber Key="end" Label="End (s)" Min="0" Max="@MediaSeconds" @bind-Value="_end" Hint="0 plays to the end of the file." />
                </PgGroup>
                <PgGroup Title="Rules">
                    <PgNumber Key="maxplays" Label="Max plays" Min="0" Max="9" @bind-Value="_maxPlays" OnChange="ResetPlays" Hint="0 is unlimited. The player locks when the last play ends." />
                    <PgSwitch Key="seekable" Label="Seekable" Hint="Off locks the timeline: no scrubbing." @bind-Value="_seekable" />
                    <PgSwitch Key="loop" Label="Loop" @bind-Value="_loop" />
                    <PgSwitch Key="compact" Label="Compact" Hint="A denser control bar." @bind-Value="_compact" />
                    <PgSwitch Key="download" Label="Download button" @bind-Value="_download" />
                </PgGroup>
                break;
        }
    </Knobs>
    <Stage>
        @switch (_component)
        {
            case "code":
                <PgPanel Title="Code block" Note="the real component, editable code">
                    <div class="min-w-0 p-4" data-testid="display-result">
                        <KlyCodeBlock Code="@_code" Language="@Language" Label="@_label" Highlight="_highlight" Copy="_copy" LineNumbers="_numbers" HighlightLines="@Marked" />
                    </div>
                </PgPanel>
                <PgPanel Title="What the highlighter found" Note="CodeHighlighter.Tokenize in Klyroo.Display.Core">
                    <KlyFacts Surface="KlySurface.Plain" Items="TokenFacts()" />
                    <p class="m-0 mt-2 text-sm text-(--klyroo-text-muted)">The tokens concatenate to exactly the code, so the text of the block, the selection and the copy button give it as it is. A code over @CodeHighlighter.MaxLength.ToString("N0") characters or @CodeHighlighter.MaxLines.ToString("N0") lines, or with no language, stays plain text.</p>
                </PgPanel>
                break;
            case "secret":
                <PgPanel Title="Secret block" Note="the real component">
                    <div class="min-w-0 p-4" data-testid="display-result">
                        <KlySecretBlock Label="@_secretLabel" Value="@_secretValue" VisibleChars="_visible" Copy="_copy" />
                    </div>
                </PgPanel>
                <PgPanel Title="What is in the page" Note="the markup while it is masked">
                    <KlyFacts Surface="KlySurface.Plain" Items="SecretFacts()" />
                    <p class="m-0 mt-2 text-sm text-(--klyroo-text-muted)">The mask is a display feature, not protection: in WebAssembly the value is in the memory of the browser, and the copy button copies the real value.</p>
                </PgPanel>
                break;
            case "files":
                <PgPanel Title="File list" Note="click a file to open the preview">
                    <div class="min-w-0 p-4" data-testid="display-result">
                        <KlyFileList Title="@_filesTitle" Files="Files" Max="@(_max == 0 ? null : _max)" Step="@(_max == 0 || _step == 0 ? null : _step)" />
                    </div>
                </PgPanel>
                @if (_provider)
                {
                    <KlyFilePreviewProvider />
                }
                <PgPanel Title="The preview" Note="@(_provider ? "mounted, opens as a gallery" : "not mounted")">
                    <p class="m-0 text-sm text-(--klyroo-text-muted)">A click opens all the files of the list as a gallery, starting at the clicked one: Markdown, CSV, text and code from <code>Content</code>, an image, an audio and a video from <code>Src</code>. Arrow keys move between files and Escape closes it.</p>
                </PgPanel>
                break;
            case "audio":
                <PgPanel Title="Audio player" Note="a 20 second tone">
                    <div class="min-w-0 p-4" data-testid="display-result">
                        <KlyAudioPlayer Src="samples/sample-audio.ogg" Title="@_mediaTitle" Duration="20" Start="_start" End="@End" MaxPlays="_maxPlays" @bind-Plays="_plays" Seekable="_seekable" Loop="_loop" Compact="_compact" Download="_download" OnLimitReached="@(() => _locked = true)" />
                    </div>
                </PgPanel>
                <PgPanel Title="State" Note="reported by the player">
                    <KlyFacts Surface="KlySurface.Plain" Items="PlayerFacts()" />
                    <div class="mt-2"><KlyButton Label="Reset the plays" Variant="ButtonVariant.Outline" Color="KlyColor.Neutral" Size="KlySize.Xs" OnClick="ResetPlays" /></div>
                </PgPanel>
                break;
            default:
                <PgPanel Title="Video player" Note="an 8 second test pattern">
                    <div class="min-w-0 p-4" data-testid="display-result">
                        <KlyVideoPlayer Src="samples/sample-video.webm" Title="@_mediaTitle" Duration="8" Start="_start" End="@End" MaxPlays="_maxPlays" @bind-Plays="_plays" Seekable="_seekable" Loop="_loop" Compact="_compact" Download="_download" OnLimitReached="@(() => _locked = true)" />
                    </div>
                </PgPanel>
                <PgPanel Title="State" Note="reported by the player">
                    <KlyFacts Surface="KlySurface.Plain" Items="PlayerFacts()" />
                    <div class="mt-2"><KlyButton Label="Reset the plays" Variant="ButtonVariant.Outline" Color="KlyColor.Neutral" Size="KlySize.Xs" OnClick="ResetPlays" /></div>
                </PgPanel>
                break;
        }
        <CodePanel Tabs="CodeTabs" />
    </Stage>
</PgShell>

@code {
    private readonly LibraryInfo _lib = Libraries.Find("display")!;

    private static readonly IReadOnlyList<PgOption<string>> _components = PgOptions.Of(("code", "Code block"), ("secret", "Secret block"), ("files", "File list"), ("audio", "Audio player"), ("video", "Video player"));
    private static readonly IReadOnlyList<PgOption<string>> _languages =
        PgOptions.Of([("none", "None (plain text)"), .. CodeHighlighter.Languages.Select(l => (CodeHighlighter.Name(l), CodeHighlighter.Name(l)))]);

    private string _component = "code", _language = "sql", _label = "Orders.sql", _code = "", _lines = "2, 4-5";
    private bool _numbers = true, _highlight = true, _copy = true;
    private string _secretLabel = "API key", _secretValue = "sk_live_klyroo_9876543210";
    private int _visible = 4;
    private string _filesTitle = "Attachments";
    private int _max = 3, _step = 2;
    private bool _details = true, _provider = true;
    private string _mediaTitle = "Listening extract 1";
    private int _start, _end, _maxPlays = 2, _plays;
    private bool _seekable = true, _loop, _compact, _download, _locked;

    private CodeLanguage? Language => CodeHighlighter.ResolveLanguage(_language);
    private IReadOnlyList<CodeLineRange> Marked => CodeSamples.ParseLines(_lines);
    private int MediaSeconds => _component == "video" ? 8 : 20;
    private double? End => _end == 0 ? null : _end;

    private string ComponentHint => _component switch
    {
        "code" => "KlyCodeBlock: Language, LineNumbers, HighlightLines.",
        "secret" => "KlySecretBlock: a value masked until revealed.",
        "files" => "KlyFileList: FileListItem rows that open the file preview.",
        "audio" => "KlyAudioPlayer: clip window, play limit, locked timeline.",
        _ => "KlyVideoPlayer: the same rules on a video.",
    };

    protected override void OnInitialized()
    {
        K.Load();
        LoadKnobs();
    }

    private void LoadKnobs()
    {
        _component = K.Str("component", "code");
        if (_components.All(c => c.Value != _component)) _component = "code";
        _language = K.Str("language", "sql");
        if (_languages.All(l => l.Value != _language)) _language = "sql";
        _label = K.Str("label", CodeSamples.FileName(Language));
        _code = CodeSamples.Of(Language);
        _numbers = K.Bool("numbers", true);
        _lines = K.Str("lines", "2, 4-5");
        _highlight = K.Bool("highlight", true);
        _copy = K.Bool("copy", true);
        _secretLabel = _component == "secret" ? K.Str("label", "API key") : "API key";
        _secretValue = K.Str("value", "sk_live_klyroo_9876543210");
        _visible = K.Int("visible", 4, 0, 12);
        _filesTitle = K.Str("title", "Attachments");
        _max = K.Int("max", 3, 0, 10);
        _step = K.Int("step", 2, 0, 10);
        _details = K.Bool("details", true);
        _provider = K.Bool("provider", true);
        _mediaTitle = _component is "audio" or "video" ? K.Str("title", "Listening extract 1") : "Listening extract 1";
        _start = K.Int("start", 0, 0, 19);
        _end = K.Int("end", 0, 0, 20);
        _maxPlays = K.Int("maxplays", 2, 0, 9);
        _seekable = K.Bool("seekable", true);
        _loop = K.Bool("loop", false);
        _compact = K.Bool("compact", false);
        _download = K.Bool("download", false);
        ResetPlays();
    }

    // Each component has its own label and title knob, so a value typed for one is not carried over to the next.
    private void ComponentChanged()
    {
        _label = CodeSamples.FileName(Language);
        _secretLabel = "API key";
        _filesTitle = "Attachments";
        _mediaTitle = _component == "video" ? "Safety briefing" : "Listening extract 1";
        _start = Math.Min(_start, MediaSeconds - 1);
        _end = Math.Min(_end, MediaSeconds);
        K.Put("label", _component == "secret" ? _secretLabel : _label);
        K.Put("title", _component == "files" ? _filesTitle : _mediaTitle);
        K.Put("start", _start.ToString());
        K.Put("end", _end.ToString());
        ResetPlays();
    }

    private void LanguageChanged()
    {
        _code = CodeSamples.Of(Language);
        _label = CodeSamples.FileName(Language);
        K.Put("label", _label);
    }

    private void ResetPlays()
    {
        _plays = 0;
        _locked = false;
    }

    private IReadOnlyList<KlyFact> TokenFacts()
    {
        var tokens = CodeHighlighter.Tokenize(_code, _highlight ? Language : null);
        var facts = tokens
            .Where(t => t.Kind != CodeTokenKind.Plain)
            .GroupBy(t => t.Kind)
            .OrderByDescending(g => g.Count())
            .Select(g => new KlyFact(CodeHighlighter.TokenName(g.Key)) { Value = g.Count().ToString(), Mono = true })
            .ToList();
        if (facts.Count == 0)
        {
            facts.Add(new KlyFact("Colored tokens") { Value = "none: the code is plain text" });
        }
        facts.Insert(0, new KlyFact("Lines") { Value = (_code.TrimEnd('\n').Split('\n').Length).ToString() });
        facts.Insert(1, new KlyFact("Emphasized") { Value = Marked.Count == 0 ? "none" : "lines " + string.Join(", ", Marked.Select(r => r.Start == r.End ? r.Start.ToString() : $"{r.Start} to {r.End}")) });
        return facts;
    }

    private IReadOnlyList<KlyFact> SecretFacts()
    {
        var masked = _secretValue.Length <= _visible ? new string('•', _secretValue.Length) : "••••••••" + _secretValue[^Math.Max(_visible, 0)..];
        if (_visible == 0 && _secretValue.Length > 0) masked = "••••••••";
        return
        [
            new("Shown while masked") { Value = masked, Mono = true },
            new("Characters in the page") { Value = (_secretValue.Length <= _visible ? 0 : Math.Min(_visible, _secretValue.Length)).ToString() + " of " + _secretValue.Length },
            new("Copy") { Value = _copy ? "copies the whole value" : "no button" },
        ];
    }

    private IReadOnlyList<KlyFact> PlayerFacts() =>
    [
        new("Clip") { Value = $"{_start}s to {(_end == 0 ? MediaSeconds : _end)}s of {MediaSeconds}s", Mono = true },
        new("Plays used") { Value = _maxPlays == 0 ? $"{_plays}, unlimited" : $"{_plays} of {_maxPlays}", Mono = true },
        new("State") { Badge = _locked ? new KlyBadgeItem("Locked") { Color = KlyColor.Warning } : new KlyBadgeItem("Open") { Color = KlyColor.Success } },
        new("Timeline") { Value = _seekable ? "seekable" : "locked: no scrubbing" },
    ];

    private IReadOnlyList<FileListItem> Files
    {
        get
        {
            if (!_details)
            {
                return [.. DisplayFiles.Sample.Select(f => (FileListItem)f.File)];
            }
            return DisplayFiles.Sample;
        }
    }

    private IReadOnlyList<CodeTab> CodeTabs => _component switch
    {
        "code" => [new("Snippet.razor", "html", CodeRazor())],
        "secret" => [new("Secret.razor", "html", SecretRazor())],
        "files" => [new("Attachments.razor", "html", FilesRazor())],
        _ => [new(_component == "video" ? "Video.razor" : "Audio.razor", "html", PlayerRazor())],
    };

    private string CodeRazor()
    {
        var sb = new StringBuilder();
        sb.Append($"<KlyCodeBlock Label=\"{_label}\" Code=\"@Snippet\"");
        if (Language is { } language) sb.Append($" Language=\"CodeLanguage.{language}\"");
        if (_numbers) sb.Append(" LineNumbers");
        if (Marked.Count > 0) sb.Append($" HighlightLines=\"@({CodeSamples.Literal(Marked)})\"");
        if (!_highlight) sb.Append(" Highlight=\"false\"");
        if (!_copy) sb.Append(" Copy=\"false\"");
        sb.Append(" />\n\n@code {\n    private const string Snippet = \"\"\"\n");
        foreach (var line in _code.TrimEnd('\n').Split('\n')) sb.Append("        ").Append(line).Append('\n');
        sb.Append("        \"\"\";\n}\n");
        return sb.ToString();
    }

    private string SecretRazor() =>
        $"<KlySecretBlock Label=\"{_secretLabel}\" Value=\"@ApiKey\"{(_visible == 4 ? "" : $" VisibleChars=\"{_visible}\"")}{(_copy ? "" : " Copy=\"false\"")} />\n\n@code {{\n    private const string ApiKey = \"{_secretValue}\";\n}}\n";

    private string FilesRazor()
    {
        var sb = new StringBuilder();
        sb.Append("<KlyFilePreviewProvider />\n\n");
        sb.Append($"<KlyFileList Title=\"{_filesTitle}\" Files=\"_files\"");
        if (_max > 0) sb.Append($" Max=\"{_max}\"");
        if (_max > 0 && _step > 0) sb.Append($" Step=\"{_step}\"");
        sb.Append(" />\n\n@code {\n    private readonly IReadOnlyList<FileListItem> _files =\n    [\n");
        if (_details)
        {
            sb.Append("        new FileListItem(new FilePreviewFile { Src = \"/files/notes.md\", Name = \"notes.md\", Content = Notes },\n            Description: \"Release notes\", Icon: \"note\", Tone: KlyColor.Info),\n");
            sb.Append("        new FileListItem(new FilePreviewFile { Src = \"/files/metrics.csv\", Content = Metrics }, Meta: \"Updated today\"),\n");
        }
        else
        {
            sb.Append("        new FilePreviewFile { Src = \"/files/notes.md\", Name = \"notes.md\", Content = Notes },\n");
            sb.Append("        new FilePreviewFile { Src = \"/files/metrics.csv\", Content = Metrics },\n");
        }
        sb.Append("        // A FilePreviewFile converts to an item on its own.\n        new FilePreviewFile { Src = \"samples/sample-audio.ogg\", Name = \"Listening.ogg\" },\n    ];\n}\n");
        return sb.ToString();
    }

    private string PlayerRazor()
    {
        var tag = _component == "video" ? "KlyVideoPlayer" : "KlyAudioPlayer";
        var src = _component == "video" ? "/media/briefing.webm" : "/media/listening.ogg";
        var sb = new StringBuilder();
        sb.Append($"<{tag} Src=\"{src}\" Title=\"{_mediaTitle}\"");
        if (_start > 0) sb.Append($" Start=\"{_start}\"");
        if (_end > 0) sb.Append($" End=\"{_end}\"");
        if (_maxPlays > 0) sb.Append($" MaxPlays=\"{_maxPlays}\" @bind-Plays=\"_plays\" OnLimitReached=\"OnLimitReached\"");
        if (!_seekable) sb.Append(" Seekable=\"false\"");
        if (_loop) sb.Append(" Loop=\"true\"");
        if (_compact) sb.Append(" Compact=\"true\"");
        if (_download) sb.Append(" Download=\"true\"");
        sb.Append(" />\n");
        if (_maxPlays > 0)
        {
            sb.Append("\n@code {\n    private int _plays;\n\n    private void OnLimitReached() { /* every play is used */ }\n}\n");
        }
        return sb.ToString();
    }
}
