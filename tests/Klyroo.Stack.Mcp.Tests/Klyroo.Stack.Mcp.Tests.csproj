<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Every test awaits a short in-process or child-process exchange; there is nothing worth cancelling early. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Klyroo.Stack.Mcp.Core\Klyroo.Stack.Mcp.Core.csproj" />
    <ProjectReference Include="..\..\build\Klyroo.Stack.DocsBundle\Klyroo.Stack.DocsBundle.csproj" />
    <!-- Built first: the stdio test starts it as a process. -->
    <ProjectReference Include="..\..\src\Klyroo.Stack.Mcp\Klyroo.Stack.Mcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Klyroo.UI" />
  </ItemGroup>

</Project>
